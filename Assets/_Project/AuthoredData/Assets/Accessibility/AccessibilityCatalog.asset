      label: Text & Layout
      description: Customize text appearance and interface size.
      keywords: []
      settings:
      - id: text-size
        label: Text Size
        description: Adjust the size of text in menus, messages, and documents.
        keywords: []
        controlType: 1
        defaultToggleValue: 0
        defaultSliderValue: 25
        minimum: 0
        maximum: 100
        step: 1
        valueFormat: '%'
        options: []
        defaultOptionId: 
        defaultColorValue: {r: 0, g: 0, b: 0, a: 0}
        allowAlpha: 0
        colorPresets: []
        fontOptions: []
        defaultFontId: 
        fontPreviewText: 
      - id: ui-scale
