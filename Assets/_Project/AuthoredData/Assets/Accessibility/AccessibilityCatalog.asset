        label: Hold Action Mode
        description: Choose whether supported actions require holding a button or
          pressing it once to start and again to stop.
        keywords: []
        controlType: 2
        defaultToggleValue: 0
        defaultSliderValue: 0
        minimum: 0
        maximum: 0
        step: 0
        valueFormat: 
        options:
        - id: hold
          label: Hold to Activate
        - id: toggle
          label: Toggle (Press Once to Start/Stop)
        defaultOptionId: hold
        defaultColorValue: {r: 0, g: 0, b: 0, a: 0}
        allowAlpha: 0
        colorPresets: []
        fontOptions: []
        defaultFontId: 
        fontPreviewText: 
      - id: repeated-press-mode
