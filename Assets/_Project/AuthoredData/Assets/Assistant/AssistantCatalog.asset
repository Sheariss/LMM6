        showBackButton: 1
        showSkipButton: 1
      choices: []
      enterEffects: []
      advanceWhen:
      - kind: 2
        key: app.file-explorer.opened
        expectedValue: 1
      automaticNextNodeId: 
  tutorials:
  - id: guest.introduction
