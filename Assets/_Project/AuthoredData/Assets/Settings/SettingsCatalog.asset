  m_Script: {fileID: 11500000, guid: b4551a3e093ea0e428668d967393eca5, type: 3}
  m_Name: SettingsCatalog
  m_EditorClassIdentifier: Assembly-CSharp::Atlas.Core.Settings.SettingsCatalog
  categories:
  - id: displau
    label: Display & Graphics
    description: Customize your display settings and balance visual quality with
      performance.
    sections:
    - id: display
      label: Display
      description: Adjust screen resolution, display mode, and other screen settings.
      settings:
      - id: taget-display
        label: Target Display
        description: Choose which monitor to display the game on.
        controlType: 2
        defaultToggleValue: 0
        defaultSliderValue: 0
        minimum: 0
        maximum: 0
        step: 0
        valueFormat: 
        options:
        - id: monitor-1
          label: '1: EM2FPAf24B'
        - id: monitor-2
          label: '2: Modern AM242'
        defaultOptionId: monitor-1
        actionId: 
        allowKeyCombinations: 0
        buttonLabel: 
        commandId: 
      - id: display-mode
        label: Display Mode
        description: Set the game to run in Fullscreen, Borderles Windowed or Windowed
          mode.
        controlType: 2
        defaultToggleValue: 0
        defaultSliderValue: 0
        minimum: 0
        maximum: 0
        step: 0
        valueFormat: 
        options:
        - id: fullscreen
          label: Fullscreen
        - id: borderless
          label: Borderless Windowed
        - id: windowed
          label: Windowed
        defaultOptionId: borderless
        actionId: 
        allowKeyCombinations: 0
        buttonLabel: 
        commandId: 
      - id: aspect-ratio
        label: Aspect Ratio
        description: Aspect ratio configures your screen's display proportions for
          optimal gamaing visuals.
        controlType: 2
        defaultToggleValue: 0
        defaultSliderValue: 0
        minimum: 0
        maximum: 0
        step: 0
        valueFormat: 
        options:
        - id: 32:9
          label: 32:9
        - id: 21:9
          label: 21:9
        - id: 16:10
          label: 16:10
        - id: 16:9
          label: 16:9
        - id: 4:3
          label: 4:3
        defaultOptionId: 16:9
        actionId: 
        allowKeyCombinations: 0
        buttonLabel: 
        commandId: 
      - id: display-resolution
        label: Display Resolution
        description: Adjust the resolution to fine-tune game graphics. A lower settings
          eases the load on your GPU.
        controlType: 2
        defaultToggleValue: 0
        defaultSliderValue: 0
        minimum: 0
        maximum: 0
        step: 0
        valueFormat: 
        options:
        - id: 4k
          label: 3840 x 2160
        - id: 1440p
          label: 2560 x 1440
        - id: 1080p
