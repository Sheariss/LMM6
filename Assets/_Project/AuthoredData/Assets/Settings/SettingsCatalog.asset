        controlType: 1
        defaultToggleValue: 0
        defaultSliderValue: 50
        minimum: 0
        maximum: 100
        step: 1
        valueFormat: '%'
        options: []
        defaultOptionId: 
        actionId: 
        allowKeyCombinations: 0
        buttonLabel: 
        commandId: 
