<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3#ATLAS"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/BlueScreen/BlueScreen.uss?fileID=7433441132597879392&amp;guid=0eb670ecae8243b48bde01a1286532ee&amp;type=3#BlueScreen"/>

    <ui:VisualElement name="BlueScreenRoot" class="bsod">
        <ui:VisualElement class="bsod-content">
            <ui:Label text=":(" class="bsod-face" />

            <ui:Label
                name="ErrorMessage"
                text="Your PC ran into a problem and needs to restart. We're&#10;just collecting some error info, and then we'll restart for&#10;you."
                class="bsod-message" />

            <ui:Label
                name="ProgressLabel"
                text="20% complete"
                class="bsod-progress" />

            <ui:VisualElement class="bsod-details">
                <ui:VisualElement name="QRCode" class="bsod-qr" />

                <ui:VisualElement class="bsod-support">
                    <ui:Label
                        text="For more information about this issue and possible fixes, visit https://www.windows.com/stopcode"
                        class="bsod-help" />

                    <ui:VisualElement class="bsod-error-info">
                        <ui:Label
                            text="If you call a support person, give them this info:"
                            class="bsod-caption" />

                        <ui:Label
                            name="StopCodeLabel"
                            text="Stop code: CRITICAL_PROCESS_DIED"
                            class="bsod-stop-code" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
