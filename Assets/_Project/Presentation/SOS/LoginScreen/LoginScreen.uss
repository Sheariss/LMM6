.login-root {
    padding: 25px;
    justify-content: space-between;
}

.background-image {
    position: absolute;
}

.user-list {
    width: 300px;
    align-items: flex-start;
    justify-content: flex-end;
}

.user-list-btn {
    height: 120px;
    width: 100%;
    border-radius: 6px;
    align-items: center;
    justify-content: space-around;
}

.user-list-image {
    height: 90px;
    width: 90px;
    border-radius: 50%;
}

.user-list-text {
    font-size: 28px;
}

.login-area {
    align-items: center;
    justify-content: center;
}

.login-user-image {
    height: 275px;
    width: 275px;
    border-radius: 50%;
    margin: 15px;
}

.login-area-text {
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin: 15px;
}

.password-field{
    height: 55px;
    width: 400px;
    border-radius: 6px;
    background-color: rgba(0,0,0,0.25);
    margin: 15px;
}

.forgotpassword-btn{
    font-size: 24px;
    margin: 15px;
}

.icon-list {
    width: 150px;
    align-items: flex-end;
    justify-content: space-between;
}

.icon-button{
    height: 40px;
    width: 40px;
    align-items: center;
    justify-content: center;
}

.icon-image{
    height: 32px;
    width: 32px;
}
