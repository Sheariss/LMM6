<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Apps/Messenger/Messages.uss?fileID=7433441132597879392&amp;guid=aedd1ca4dc387654ab5c1235b0e016e7&amp;type=3#Messages"/>

    <ui:VisualElement name="MessageRoot"
                      class="messages-message-row messages-message-row--incoming">

        <ui:VisualElement name="MessageAvatar"
                          class="messages-message-avatar">
            <ui:Image name="MessageAvatarPlaceholder"
                      picking-mode="Ignore"
                      class="messages-message-avatar-placeholder"/>
        </ui:VisualElement>

        <ui:VisualElement class="messages-message-column">
            <ui:Label name="MessageSender"
                      text="Contact"
                      class="messages-message-sender"/>

            <ui:VisualElement name="MessageBubble"
                              class="messages-message-bubble messages-message-bubble--incoming">

                <ui:Label name="MessageText"
                          text="Message"
                          class="messages-message-text"/>

                <ui:VisualElement class="messages-message-meta">
                    <ui:Label name="MessageTime"
                              text="09:49"
                              class="messages-message-time"/>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>