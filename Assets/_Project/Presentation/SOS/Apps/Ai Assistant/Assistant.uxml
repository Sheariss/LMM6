<ui:UXML xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">

    <Style src="../../../Tokens/Global-Colors.uss"/>
    <Style src="../../../Tokens/Global-Tokens.uss"/>
    <Style src="../../../Tokens/ATLAS.uss"/>
    <Style src="../../Window/Window.uss"/>
    <Style src="Assistant.uss"/>

    <ui:VisualElement name="WindowRoot"
                      class="window assistant-window">

        <!-- Window header -->
        <ui:VisualElement name="WindowHeader"
                          class="flex-row header">

            <ui:VisualElement class="header-icon-area">
                <ui:Image name="WindowIcon"
                          class="header-icon"/>
            </ui:VisualElement>

            <ui:Label name="WindowTitle"
                      text="ATLAS Assistant"
                      class="spacing-reset header-title"/>

            <ui:GroupBox name="WindowControls"
                         class="flex-row spacing-reset window-controls">

                <ui:Button name="WindowMinimizeButton"
                           tooltip="Minimize Assistant"
                           class="button-reset wc-button assistant-collapse-button">

                    <ui:Image picking-mode="Ignore"
                              class="assistant-collapse-icon"/>
                </ui:Button>

                <!-- Required by WindowBinder. -->
                <ui:Button name="WindowMaximizeButton"
                           focusable="false"
                           class="assistant-hidden"/>

                <ui:Button name="WindowCloseButton"
                           focusable="false"
                           class="assistant-hidden"/>
            </ui:GroupBox>
        </ui:VisualElement>

        <ui:VisualElement name="WindowContent"
                          class="content assistant-window-content">

            <ui:VisualElement name="AssistantRoot"
                              class="assistant-root">

                <!-- Assistant identity -->
                <ui:VisualElement name="AssistantHeader"
                                  class="assistant-header">

                    <ui:VisualElement name="AssistantAvatar"
                                      class="assistant-avatar"/>

                    <ui:VisualElement class="assistant-profile-text">

                        <ui:Label name="AssistantName"
                                  text="ATLAS"
                                  class="assistant-name"/>

                        <ui:Label name="AssistantSubtitle"
                                  text="Your workspace companion"
                                  class="assistant-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Conversation -->
                <ui:ScrollView name="AssistantMessageScrollView"
                               mode="Vertical"
                               horizontal-scroller-visibility="Hidden"
                               class="assistant-message-scroll">

                    <!-- Hidden by AssistantView after the first message. -->
                    <ui:VisualElement name="AssistantWelcome"
                                      class="assistant-welcome">

                        <ui:Label text="Where shall we start?"
                                  class="assistant-welcome-title"/>

                        <ui:Label
                            text="I can help you navigate the workspace, use unfamiliar tools, and find opportunities to learn."
                            class="assistant-welcome-description"/>

                        <ui:Label
                            text="Choose a suggestion or ask a question below."
                            class="assistant-welcome-caption"/>
                    </ui:VisualElement>

                    <!-- Existing message templates are inserted here. -->
                    <ui:VisualElement name="AssistantMessageList"
                                      class="assistant-message-list"/>

                    <!-- Populated by AssistantView. -->
                    <ui:VisualElement name="AssistantChoices"
                                      class="assistant-choices">

                        <ui:Label name="AssistantChoicesLabel"
                                  text="SUGGESTED RESPONSES"
                                  class="assistant-choices-label"/>

                        <ui:VisualElement name="AssistantPromptList"
                                          class="assistant-choice-list"/>
                    </ui:VisualElement>
                </ui:ScrollView>

                <!-- Pill-shaped question composer -->
                <ui:VisualElement name="AssistantComposer"
                                  class="assistant-composer">

                    <ui:VisualElement class="assistant-input-shell">

                        <ui:VisualElement class="assistant-input-area">

                            <ui:TextField name="AssistantMessageInput"
                                          multiline="true"
                                          max-length="1000"
                                          tooltip="Ask Atlas Assistant a question"
                                          class="assistant-input"/>

                            <ui:Label name="AssistantInputPlaceholder"
                                      text="Ask ATLAS a question..."
                                      picking-mode="Ignore"
                                      class="assistant-input-placeholder"/>
                        </ui:VisualElement>

                        <ui:Button name="AssistantSendButton"
                                   text="↑"
                                   tooltip="Send message"
                                   class="assistant-send-button"/>
                    </ui:VisualElement>

                    <ui:VisualElement name="AssistantFooter"
                                      class="assistant-footer">

                        <ui:Label name="AssistantStatusLabel"
                                  text="Explore at your own pace."
                                  class="assistant-footer-status"/>

                        <ui:Label text="Enter to send"
                                  class="assistant-keyboard-hint"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>