/* WINDOW */

.assistant-window {
    flex-direction: column;
    background-color: #131314;
    border-width: 1px;
    border-color: #303134;
    border-radius: 20px;
    overflow: hidden;
}

.assistant-window .header {
    height: 44px;
    min-height: 44px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: #1e1f20;
    border-bottom-width: 0;
}

.assistant-window .header-icon-area {
    width: 32px;
    height: 32px;
    margin: 0 4px 0 8px;
    padding: 6px;
    flex-shrink: 0;
}

.assistant-window .header-icon {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.assistant-window .header-title {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    color: #e3e3e3;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.assistant-window .window-controls {
    margin: 0;
    padding: 0;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    border-width: 0;
}

.assistant-window .assistant-hidden-control {
    display: none;
}

.assistant-window > .assistant-window-content {
    width: 100%;
    height: auto;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: #131314;
    overflow: hidden;
}

/* COLLAPSE BUTTON */

.assistant-window .assistant-collapse-button {
    width: 36px;
    min-width: 36px;
    height: 36px;
    margin: 4px 8px;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 18px;
}

.assistant-window .assistant-collapse-icon {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    background-image: resource("Icons/Arrows 1/Expand-Arrow/keyboard_arrow_down_32dp");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffce4a;
}

.assistant-window #WindowMinimizeButton:hover:enabled {
    background-color: #3b3021;
}

.assistant-window #WindowMinimizeButton:active:enabled {
    background-color: #4b3821;
}

.assistant-window #WindowMinimizeButton:focus {
    border-color: #ffce4a;
}

/* ASSISTANT HEADER */

.assistant-root {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: #131314;
    overflow: hidden;
}

.assistant-header {
    height: 60px;
    min-height: 60px;
    padding: 0 20px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.assistant-profile {
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.assistant-avatar {
    width: 32px;
    min-width: 32px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 16px;
    background-color: #ffb81c;
    background-size: cover;
    background-position: center;
}

.assistant-profile-text {
    min-width: 0;
    flex-shrink: 1;
    justify-content: center;
}

.assistant-name {
    margin: 0;
    color: #e3e3e3;
    font-size: 15px;
    -unity-font-style: bold;
}

.assistant-subtitle {
    margin: 3px 0 0 0;
    color: #9aa0a6;
    font-size: 11px;
}

/* CONVERSATION */

.assistant-message-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: #131314;
}

.assistant-message-scroll .unity-scroll-view__content-container {
    min-width: 0;
}

.assistant-welcome {
    padding: 24px 20px 12px 20px;
    flex-shrink: 0;
}

.assistant-welcome-title {
    margin: 0 0 8px 0;
    color: #ffce4a;
    font-size: 24px;
    white-space: normal;
}

.assistant-welcome-description {
    margin: 0;
    color: #b7b9bd;
    font-size: 13px;
    white-space: normal;
}

.assistant-message-list {
    min-width: 0;
    padding: 16px 20px 0 20px;
    flex-grow: 0;
    flex-shrink: 0;
}

/* MESSAGE TEMPLATES */

.assistant-message-row {
    width: 100%;
    margin-bottom: 20px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
}

.assistant-message-row--assistant {
    justify-content: flex-start;
}

.assistant-message-row--user {
    justify-content: flex-end;
}

.assistant-message-avatar {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: #ffb81c;
    background-size: cover;
    background-position: center;
}

.assistant-message-column {
    min-width: 0;
    max-width: 85%;
    flex-shrink: 1;
}

.assistant-message-bubble {
    min-width: 0;
    padding: 12px 16px;
    border-radius: 18px;
}

.assistant-message-bubble--assistant {
    background-color: #1e1f20;
}

.assistant-message-bubble--user {
    background-color: #47331e;
}

.assistant-message-text {
    margin: 0;
    padding: 0;
    color: #e3e3e3;
    font-size: 13px;
    white-space: normal;
}

.assistant-message-sender {
    margin: 0 0 5px 2px;
    color: #ffce4a;
    font-size: 10px;
    -unity-font-style: bold;
}

.assistant-message-meta {
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
}

.assistant-message-row--assistant .assistant-message-meta {
    justify-content: flex-start;
}

.assistant-message-row--user .assistant-message-meta {
    justify-content: flex-end;
}

.assistant-message-time {
    margin: 0 2px;
    color: #9aa0a6;
    font-size: 9px;
}

.assistant-message-read {
    display: none;
}

/* TYPING INDICATOR */

.assistant-typing-row {
    margin-bottom: 20px;
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

.assistant-typing-bubble {
    height: 36px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: #1e1f20;
    border-radius: 18px;
}

.assistant-typing-dot {
    width: 5px;
    height: 5px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: #ffb81c;
}

.assistant-typing-dot--three {
    margin-right: 0;
}

/* CURRENT RESPONSE OPTIONS */

.assistant-choices {
    min-width: 0;
    padding: 0 20px 20px 20px;
    flex-shrink: 0;
}

.assistant-choices-label {
    margin: 0 0 8px 0;
    color: #9aa0a6;
    font-size: 10px;
}

.assistant-choice-list {
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
}

/* The builder adds this class to each response button. */
.assistant-choice-button {
    min-width: 0;
    min-height: 42px;
    margin: 0 0 8px 0;
    padding: 11px 16px;
    flex-shrink: 0;

    background-color: #30271b;
    color: #ffe388;

    border-width: 1px;
    border-color: #594326;
    border-radius: 16px;

    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.assistant-choice-button:hover:enabled {
    background-color: #44331d;
    border-color: #9c742b;
}

.assistant-choice-button:active:enabled {
    background-color: #594022;
}

.assistant-choice-button:focus {
    border-color: #ffce4a;
}

.assistant-choice-button:disabled {
    background-color: #232323;
    color: #898989;
    border-color: #353535;
}

/* Optional modifier for the main action. */
.assistant-choice-button--primary {
    background-color: #ffb81c;
    color: #30200b;
    border-color: #ffb81c;
    -unity-font-style: bold;
}

.assistant-choice-button--primary:hover:enabled {
    background-color: #ffce4a;
    border-color: #ffce4a;
}

.assistant-choice-button--primary:active:enabled {
    background-color: #f99707;
    border-color: #f99707;
}

/* Optional modifier for "I'll explore" and similar choices. */
.assistant-choice-button--secondary {
    background-color: transparent;
    color: #c4c7c5;
    border-color: #414141;
}

.assistant-choice-button--secondary:hover:enabled {
    background-color: #252729;
    border-color: #77716a;
}

/* PERSISTENT HELP FOOTER */

.assistant-footer {
    min-height: 58px;
    padding: 10px 16px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;

    background-color: #181819;
    border-top-width: 1px;
    border-top-color: #2b2b2d;
}

.assistant-footer-status {
    min-width: 0;
    margin: 0 12px 0 0;
    flex-grow: 1;
    flex-shrink: 1;

    color: #9aa0a6;
    font-size: 10px;
    white-space: normal;
}

.assistant-help-button {
    min-width: 64px;
    min-height: 34px;
    margin: 0;
    padding: 7px 16px;
    flex-shrink: 0;

    background-color: #30271b;
    color: #ffe388;

    border-width: 1px;
    border-color: #594326;
    border-radius: 17px;

    font-size: 12px;
}

.assistant-help-button:hover:enabled {
    background-color: #44331d;
}

.assistant-help-button:active:enabled {
    background-color: #594022;
}

.assistant-help-button:focus {
    border-color: #ffce4a;
}

.assistant-help-button:disabled {
    background-color: #232323;
    color: #898989;
    border-color: #353535;
}

/* VISIBILITY */

.assistant-hidden {
    display: none;
}