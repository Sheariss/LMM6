/* =========================================================
   WINDOW
   ========================================================= */

.assistant-window {
    flex-direction: column;
    background-color: #131314;
    border-width: 1px;
    border-color: #303134;
    border-radius: 20px;
    overflow: hidden;
}

.assistant-window .header {
    height: 44px;
    min-height: 44px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: #1e1f20;
    border-bottom-width: 0;
}

.assistant-window .header-icon-area {
    width: 28px;
    height: 28px;
    margin: 0 4px 0 10px;
    padding: 5px;
    flex-shrink: 0;
}

.assistant-window .header-icon {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.assistant-window .header-title {
    min-width: 0;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    color: #e3e3e3;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.assistant-window .window-controls {
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    border-width: 0;
}

.assistant-window > .assistant-window-content {
    width: 100%;
    height: auto;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: #131314;
    overflow: hidden;
}

.assistant-window .assistant-collapse-button {
    width: 36px;
    min-width: 36px;
    height: 36px;
    margin: 4px 8px;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 18px;
}

.assistant-collapse-icon {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    background-image: resource("Icons/Arrows 1/Expand-Arrow/keyboard_arrow_down_32dp");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffce4a;
}

.assistant-window #WindowMinimizeButton:hover:enabled {
    background-color: #3b3021;
}

.assistant-window #WindowMinimizeButton:active:enabled {
    background-color: #4b3821;
}

.assistant-window #WindowMinimizeButton:focus {
    border-color: #ffce4a;
}

/* =========================================================
   ASSISTANT IDENTITY
   ========================================================= */

.assistant-root {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    background-color: #131314;
    overflow: hidden;
}

.assistant-header {
    height: auto;
    min-height: 72px;
    padding: 12px 22px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.assistant-avatar {
    width: 35px;
    min-width: 35px;
    height: 35px;
    margin-right: 12px;
    flex-shrink: 0;
    background-color: #ffb81c;
    border-radius: 18px;
    -unity-background-scale-mode: scale-to-fit;
}

.assistant-profile-text {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
}

.assistant-name {
    margin: 0;
    padding: 0;
    color: #e3e3e3;
    font-size: 17px;
    -unity-font-style: bold;
}

.assistant-subtitle {
    height: auto;
    min-height: 18px;
    margin: 2px 0 0 0;
    padding: 0;
    flex-shrink: 0;
    color: #9aa0a6;
    font-size: 12px;
    white-space: normal;
    overflow: visible;
}

/* =========================================================
   CONVERSATION
   ========================================================= */

.assistant-message-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: #131314;
}

.assistant-message-scroll .unity-scroll-view__content-container {
    min-width: 0;
    padding-bottom: 8px;
}

.assistant-welcome {
    padding: 26px 22px 24px 22px;
    flex-shrink: 0;
}

.assistant-welcome-title {
    margin: 0 0 14px 0;
    padding: 0;
    color: #ffce4a;
    font-size: 26px;
    -unity-font-style: normal;
    white-space: normal;
}

.assistant-welcome-description {
    margin: 0;
    padding: 0;
    color: #b7b9bd;
    font-size: 14px;
    white-space: normal;
}

.assistant-welcome-caption {
    margin: 14px 0 0 0;
    padding: 0;
    color: #9aa0a6;
    font-size: 12px;
    white-space: normal;
}

.assistant-message-list {
    min-width: 0;
    padding: 16px 20px 0 20px;
    flex-shrink: 0;
}

/* =========================================================
   MESSAGE TEMPLATES
   ========================================================= */

.assistant-message-row {
    width: 100%;
    margin-bottom: 20px;
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.assistant-message-row--assistant {
    justify-content: flex-start;
}

.assistant-message-row--user {
    justify-content: flex-end;
}

.assistant-message-avatar {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: #ffb81c;
    border-radius: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.assistant-message-column {
    min-width: 0;
    max-width: 85%;
    flex-shrink: 1;
}

.assistant-message-sender {
    margin: 0 0 5px 2px;
    padding: 0;
    color: #ffce4a;
    font-size: 11px;
    -unity-font-style: bold;
}

.assistant-message-bubble {
    min-width: 0;
    padding: 12px 16px;
    border-width: 0;
    border-radius: 18px;
}

.assistant-message-bubble--assistant {
    background-color: #1e1f20;
}

.assistant-message-bubble--user {
    background-color: #47331e;
}

.assistant-message-text {
    margin: 0;
    padding: 0;
    color: #e3e3e3;
    font-size: 13px;
    white-space: normal;
}

.assistant-message-meta {
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
}

.assistant-message-row--assistant .assistant-message-meta {
    justify-content: flex-start;
}

.assistant-message-row--user .assistant-message-meta {
    justify-content: flex-end;
}

.assistant-message-time {
    margin: 0 2px;
    padding: 0;
    color: #9aa0a6;
    font-size: 10px;
}

.assistant-message-read {
    display: none;
}

/* =========================================================
   TYPING INDICATOR TEMPLATE
   ========================================================= */

.assistant-typing-row {
    margin-bottom: 20px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.assistant-typing-bubble {
    height: 36px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: #1e1f20;
    border-radius: 18px;
}

.assistant-typing-dot {
    width: 5px;
    height: 5px;
    margin-right: 4px;
    background-color: #ffb81c;
    border-radius: 3px;
}

.assistant-typing-dot--three {
    margin-right: 0;
}

/* =========================================================
   RESPONSE CHOICES
   ========================================================= */

.assistant-choices {
    min-width: 0;
    padding: 4px 20px 12px 20px;
    flex-shrink: 0;
}

.assistant-choices-label {
    margin: 0 0 10px 0;
    padding: 0;
    color: #9aa0a6;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.assistant-choice-list {
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
}

/* The current View creates assistant-prompt-button. */
.assistant-prompt-button,
.assistant-choice-button {
    min-width: 0;
    min-height: 44px;
    margin: 0 0 8px 0;
    padding: 11px 16px;
    flex-shrink: 0;

    background-color: #30271b;
    color: #ffe388;

    border-width: 1px;
    border-color: #594326;
    border-radius: 16px;

    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.assistant-prompt-button:hover:enabled,
.assistant-choice-button:hover:enabled {
    background-color: #44331d;
    border-color: #9c742b;
}

.assistant-prompt-button:active:enabled,
.assistant-choice-button:active:enabled {
    background-color: #594022;
}

.assistant-choice-button--primary {
    background-color: #ffb81c;
    color: #30200b;
    border-color: #ffb81c;
    -unity-font-style: bold;
}

.assistant-choice-button--primary:hover:enabled {
    background-color: #ffce4a;
    border-color: #ffce4a;
}

.assistant-choice-button--primary:active:enabled {
    background-color: #f99707;
    border-color: #f99707;
}

.assistant-choice-button--secondary {
    background-color: transparent;
    color: #c4c7c5;
    border-color: #414141;
}

.assistant-choice-button--secondary:hover:enabled {
    background-color: #252729;
    border-color: #77716a;
}

/* =========================================================
   PILL COMPOSER
   ========================================================= */

.assistant-composer {
    padding: 12px 16px 10px 16px;
    flex-shrink: 0;
    background-color: #181819;
    border-top-width: 1px;
    border-top-color: #2b2b2d;
}

.assistant-input-shell {
    min-width: 0;
    min-height: 56px;
    padding: 6px;
    flex-direction: row;
    align-items: center;

    background-color: #131314;

    border-width: 1px;
    border-color: #353537;
    border-radius: 999px;
}

.assistant-input-area {
    position: relative;
    min-width: 0;
    min-height: 42px;
    margin-left: 8px;
    flex-grow: 1;
    flex-shrink: 1;
}

.assistant-input {
    min-width: 0;
    min-height: 42px;
    max-height: 112px;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    color: #e3e3e3;
    font-size: 13px;
}

.assistant-input .unity-text-field__input {
    min-width: 0;
    min-height: 42px;
    margin: 0;
    padding: 11px 8px;

    background-color: transparent;
    color: #e3e3e3;

    border-width: 1px;
    border-color: transparent;
    border-radius: 20px;

    white-space: normal;
}

.assistant-input .unity-text-field__input:focus {
    border-color: #ffce4a;
}

.assistant-input-placeholder {
    position: absolute;
    top: 12px;
    left: 9px;
    right: 8px;
    margin: 0;
    padding: 0;
    color: #9aa0a6;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Circular arrow button */
.assistant-send-button {
    width: 42px;
    min-width: 42px;
    max-width: 42px;

    height: 42px;
    min-height: 42px;
    max-height: 42px;

    margin: 0 0 0 6px;
    padding: 0;
    flex-shrink: 0;
    align-self: center;

    background-color: #ffb81c;
    color: #30200b;

    border-width: 1px;
    border-color: #ffb81c;
    border-radius: 999px;

    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.assistant-send-button:hover:enabled {
    background-color: #ffce4a;
    border-color: #ffce4a;
}

.assistant-send-button:active:enabled {
    background-color: #f99707;
    border-color: #f99707;
}

/* =========================================================
   KEYBOARD FOCUS AND DISABLED STATES
   ========================================================= */

.assistant-prompt-button:focus,
.assistant-choice-button:focus {
    border-color: #ffce4a;
    border-width: 2px;
}

.assistant-send-button:focus {
    border-color: #ffe388;
    border-width: 2px;
}

.assistant-prompt-button:disabled,
.assistant-choice-button:disabled {
    background-color: #232323;
    color: #898989;
    border-color: #353535;
}

.assistant-send-button:disabled {
    background-color: #30271b;
    color: #9aa0a6;
    border-color: #594326;
}

/* =========================================================
   FOOTER
   ========================================================= */

.assistant-footer {
    margin-top: 8px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
}

.assistant-footer-status {
    min-width: 0;
    margin: 0 10px 4px 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    color: #9aa0a6;
    font-size: 11px;
    white-space: normal;
}

.assistant-keyboard-hint {
    margin: 0 0 4px 0;
    padding: 0;
    color: #9aa0a6;
    font-size: 11px;
}

/* Keep visibility overrides last. */
.assistant-hidden {
    display: none;
}

/* Fixed-height pill with semicircular ends. */
.assistant-input-shell {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    padding: 6px;
    border-radius: 28px;
    align-items: center;
}

.assistant-input-area {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
}

.assistant-input {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
}

/* The outer shell supplies the pill shape. */
.assistant-input .unity-text-field__input {
    border-radius: 8px;
}

/* Explicit half-height radius for the circular send button. */
.assistant-send-button {
    border-radius: 21px;
}