/* Window */

.fe-window {
    flex-direction: column;
    background-color: var(--surface-primary);
    color: var(--text-primary);
    overflow: hidden;
}

.fe-window .fe-window-header {
    height: 42px;
    min-height: 42px;
    flex-shrink: 0;
    align-items: flex-end;
    background-color: var(--window-header);
    border-bottom-width: 0;
}

.fe-window .window-controls {
    flex-shrink: 0;
    margin: 0;
}

.fe-window .fe-window-content {
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.file-explorer {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--surface-primary);
    color: var(--text-primary);
}

.fe-window Button,
.fe-window Label {
    margin: 0;
}

/* Shared icons */

.fe-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    flex-shrink: 0;
    color: var(--text-primary);
    -unity-background-image-scale-mode: scale-to-fit;
}

.fe-vector-icon {
    width: 100%;
    height: 100%;
    color: var(--text-primary);
}

.fe-chevron {
    width: 12px;
    height: 12px;
    min-width: 12px;
    margin-left: 7px;
    opacity: 0.7;
    -unity-background-image-scale-mode: scale-to-fit;
}

/* Header tabs */

.fe-tab-bar {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 42px;
    padding-left: 8px;
    flex-direction: row;
    align-items: flex-end;
    overflow: hidden;
}

.fe-tabs {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.fe-tab {
    width: 200px;
    min-width: 96px;
    max-width: 220px;
    height: 34px;
    flex-shrink: 1;
    margin-right: 3px;
    padding-left: 12px;
    padding-right: 6px;
    flex-direction: row;
    align-items: center;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    background-color: transparent;
}

.fe-tab:hover {
    background-color: var(--gray-900);
}

.fe-tab--active,
.fe-tab--active:hover {
    background-color: var(--gray-800);
}

.fe-tab__icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 8px;
    flex-shrink: 0;
    color: var(--text-primary);
}

.fe-tab__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.fe-tab--active .fe-tab__label {
    color: var(--text-primary);
}

.fe-tab__close {
    width: 24px;
    height: 24px;
    min-width: 24px;
    flex-shrink: 0;
    margin-left: 5px;
    padding: 4px;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 5px;
    background-color: transparent;
}

.fe-tab__close:hover {
    background-color: var(--gray-700);
}

.fe-tab__close .fe-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
}

.fe-new-tab-button {
    width: 32px;
    height: 32px;
    min-width: 32px;
    flex-shrink: 0;
    align-self: center;
    margin-left: 4px;
    padding: 7px;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 6px;
    background-color: transparent;
}

.fe-new-tab-button:hover {
    background-color: var(--gray-800);
}

.fe-tab-spacer {
    flex-grow: 1;
    min-width: 12px;
    height: 100%;
}

/* Navigation */

.fe-navigation-bar {
    height: 52px;
    min-height: 52px;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
    background-color: var(--gray-800);
}

.fe-navigation-controls {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 8px;
}

.fe-nav-button {
    width: 34px;
    height: 34px;
    min-width: 34px;
    margin-right: 2px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 6px;
    background-color: transparent;
}

.fe-nav-button:hover:enabled {
    background-color: var(--gray-700);
}

.fe-nav-button:disabled {
    opacity: 0.35;
}

.fe-address-bar {
    height: 34px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 10px;
    padding-left: 10px;
    padding-right: 6px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--gray-900);
    overflow: hidden;
}

.fe-path-icon {
    margin-right: 7px;
    opacity: 0.8;
}

.fe-breadcrumb-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.fe-breadcrumb {
    height: 26px;
    flex-shrink: 0;
    padding-left: 7px;
    padding-right: 7px;
    border-width: 0;
    border-radius: 5px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: 12px;
}

.fe-breadcrumb:hover {
    background-color: var(--gray-800);
}

.fe-breadcrumb--current {
    color: var(--text-primary);
}

.fe-breadcrumb-separator {
    margin-left: 2px;
    margin-right: 2px;
    color: var(--text-muted);
    font-size: 14px;
}

/* Search */

.fe-search-container {
    width: 250px;
    min-width: 150px;
    max-width: 32%;
    height: 34px;
    flex-shrink: 1;
    padding-left: 12px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--gray-900);
}

.fe-search-entry {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    justify-content: center;
}

.fe-search-icon {
    margin-left: 8px;
    opacity: 0.75;
}

#FE-SearchField {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    background-image: none;
    color: var(--text-primary);
    font-size: 12px;
}

#FE-SearchField .unity-text-input,
#FE-SearchField .unity-base-text-field__input,
#FE-SearchField .unity-text-input:hover,
#FE-SearchField .unity-text-input:focus,
#FE-SearchField .unity-text-input:active,
#FE-SearchField .unity-base-text-field__input:hover,
#FE-SearchField .unity-base-text-field__input:focus,
#FE-SearchField .unity-base-text-field__input:active {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-color: transparent;
    border-radius: 0;
    background-color: transparent;
    background-image: none;
    color: var(--text-primary);
    font-size: 12px;
}

.fe-search-placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 12px;
    color: var(--text-muted);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Command bar */

.fe-command-bar {
    height: 48px;
    min-height: 48px;
    flex-shrink: 0;
    background-color: var(--gray-800);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.fe-command-bar .unity-scroll-view__content-container {
    flex-direction: row;
}

.fe-command-items {
    height: 47px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.fe-command-button,
.fe-command-icon-button {
    height: 32px;
    flex-shrink: 0;
    margin-right: 3px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 6px;
    background-color: transparent;
    color: var(--text-primary);
}

.fe-command-icon-button {
    width: 34px;
    min-width: 34px;
    padding: 8px;
}

.fe-command-button:hover:enabled,
.fe-command-icon-button:hover:enabled,
.fe-command-button--open {
    background-color: var(--gray-700);
}

.fe-command-button:disabled,
.fe-command-icon-button:disabled {
    opacity: 0.35;
}

.fe-command-label {
    margin-left: 8px;
    color: var(--text-primary);
    font-size: 12px;
}

.fe-command-divider {
    width: 1px;
    min-width: 1px;
    height: 20px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: var(--border-primary);
}

/* Workspace and sidebar */

.fe-workspace {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    flex-direction: row;
}

.fe-sidebar {
    width: 190px;
    min-width: 150px;
    flex-shrink: 0;
    padding: 12px 8px;
    background-color: var(--gray-900);
    border-right-width: 1px;
    border-right-color: var(--border-primary);
}

.fe-sidebar-item {
    height: 36px;
    margin-bottom: 3px;
    padding-left: 12px;
    padding-right: 10px;
    border-width: 0;
    border-radius: 6px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.fe-sidebar-item:hover {
    background-color: var(--surface-hover);
}

.fe-sidebar-item--active,
.fe-sidebar-item--active:hover {
    background-color: var(--gray-800);
    color: var(--accent-hover);
    -unity-font-style: bold;
}

.fe-sidebar-heading {
    margin-left: 12px;
    margin-top: 4px;
    margin-bottom: 8px;
    font-size: 10px;
    color: var(--text-muted);
}

.fe-sidebar-divider {
    height: 1px;
    margin: 10px 8px;
    background-color: var(--border-primary);
}

/* Main content */

.fe-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--surface-primary);
}

.fe-directory-header {
    height: 68px;
    min-height: 68px;
    flex-shrink: 0;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.fe-directory-title {
    font-size: 19px;
    color: var(--text-primary);
    -unity-font-style: bold;
}

.fe-directory-subtitle {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 11px;
}

.fe-sort-status {
    margin-left: 12px;
    color: var(--text-muted);
    font-size: 11px;
    white-space: nowrap;
}

.fe-content-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-left: 16px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.fe-content-scroll .unity-scroll-view__content-container {
    padding-left: 8px;
    padding-right: 12px;
    padding-bottom: 16px;
}

.fe-content {
    flex-grow: 1;
}

.fe-content--grid,
.fe-content--large-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

/* File cards */

.fe-file-card {
    width: 158px;
    height: 164px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 9px;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 8px;
    background-color: var(--surface-primary);
}

.fe-file-card:hover {
    background-color: var(--surface-hover);
    border-color: var(--border-secondary);
}

.fe-file-card--selected,
.fe-file-card--selected:hover {
    background-color: var(--gray-800);
    border-color: var(--accent-hover);
}

.fe-file-card__preview {
    height: 100px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background-color: var(--gray-950);
    overflow: hidden;
}

.fe-file-card__thumbnail {
    width: 100%;
    height: 100%;
}

.fe-file-card__icon {
    font-size: 34px;
    color: var(--text-secondary);
}

.fe-file-card__name {
    margin-top: 8px;
    font-size: 12px;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.fe-file-card__metadata {
    margin-top: 3px;
    font-size: 10px;
    color: var(--text-muted);
}

.fe-file-card--folder .fe-file-card__icon {
    color: var(--accent-hover);
}

.fe-content--large-grid .fe-file-card {
    width: 200px;
    height: 205px;
}

.fe-content--large-grid .fe-file-card__preview {
    height: 135px;
}

/* List and details */

.fe-content--list,
.fe-content--details {
    flex-direction: column;
}

.fe-file-row,
.fe-details-row {
    height: 42px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-radius: 6px;
}

.fe-file-row {
    margin-bottom: 2px;
}

.fe-file-row:hover,
.fe-details-row:hover {
    background-color: var(--surface-hover);
}

.fe-file-row--selected,
.fe-file-row--selected:hover,
.fe-details-row--selected,
.fe-details-row--selected:hover {
    background-color: var(--surface-active);
}

.fe-file-row__icon {
    width: 32px;
    font-size: 17px;
    color: var(--text-secondary);
}

.fe-file-row__name {
    flex-grow: 1;
    font-size: 12px;
    color: var(--text-primary);
}

.fe-file-row__metadata {
    width: 140px;
    font-size: 11px;
    color: var(--text-muted);
}

.fe-details-header {
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.fe-details-header__column {
    font-size: 10px;
    color: var(--text-muted);
}

.fe-details-name {
    flex-grow: 1;
    min-width: 180px;
    flex-direction: row;
    align-items: center;
}

.fe-details-icon {
    width: 28px;
    font-size: 15px;
    color: var(--text-secondary);
}

.fe-details-text {
    font-size: 11px;
    color: var(--text-secondary);
}

.fe-details-column--date {
    width: 160px;
}

.fe-details-column--type {
    width: 120px;
}

.fe-details-column--size {
    width: 90px;
}

/* Empty state and status */

.fe-empty-state {
    display: none;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.fe-empty-title {
    font-size: 14px;
    color: var(--text-secondary);
}

.fe-status-bar {
    height: 28px;
    min-height: 28px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--gray-900);
    border-top-width: 1px;
    border-top-color: var(--border-primary);
}

.fe-status-text {
    font-size: 10px;
    color: var(--text-muted);
}

/* Dropdown menus */

.fe-menu-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.fe-popover {
    position: absolute;
    min-width: 0;
    padding: 6px;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 8px;
    background-color: var(--gray-900);
    color: var(--text-primary);
    overflow: hidden;
}

.fe-popover-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.fe-popover-item {
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    border-width: 0;
    border-radius: 5px;
    background-color: transparent;
}

.fe-popover-item:hover:enabled,
.fe-popover-item:focus:enabled {
    background-color: var(--surface-hover);
}

.fe-popover-item:disabled {
    opacity: 0.4;
}

.fe-popover-check {
    width: 20px;
    min-width: 20px;
    color: var(--accent-hover);
    font-size: 12px;
}

.fe-popover-label {
    flex-grow: 1;
    color: var(--text-primary);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.fe-popover-item--selected .fe-popover-label {
    color: var(--accent-hover);
}

.fe-popover-divider {
    height: 1px;
    min-height: 1px;
    margin: 5px;
    background-color: var(--border-primary);
}

/* Scrollbars */

.fe-content-scroll .unity-scroller--vertical,
.fe-sidebar .unity-scroller--vertical,
.fe-popover-scroll .unity-scroller--vertical {
    width: 8px;
}

.fe-content-scroll .unity-base-slider__tracker,
.fe-sidebar .unity-base-slider__tracker,
.fe-popover-scroll .unity-base-slider__tracker {
    background-color: transparent;
}

.fe-content-scroll .unity-base-slider__dragger,
.fe-sidebar .unity-base-slider__dragger,
.fe-popover-scroll .unity-base-slider__dragger {
    width: 5px;
    border-radius: 4px;
    background-color: var(--gray-600);
}

.fe-content-scroll .unity-base-slider__dragger:hover,
.fe-sidebar .unity-base-slider__dragger:hover,
.fe-popover-scroll .unity-base-slider__dragger:hover {
    background-color: var(--gray-500);
}

/* Reusable texture icons */

.fe-icon,
.fe-tab__icon,
.fe-chevron {
    -unity-background-image-scale-mode: scale-to-fit;
}

.fe-icon-folder {
    background-image:
        resource("AppIcons/Folder Empty/icons8-folder-48");
}

.fe-icon-new {
    background-image:
        resource("Icons/Actions/New/add_circle_32dp");
}

.fe-icon-search {
    background-image:
        resource("Icons/UI/Search/search_32dp");
}

.fe-icon-back {
    background-image:
        resource("Icons/Arrows 1/Arrow-Back/arrow_back_32dp");
}

.fe-icon-forward {
    background-image:
        resource("Icons/Arrows 1/Arrow-Foward/arrow_forward_32dp");
}

.fe-icon-up {
    background-image:
        resource("Icons/Arrows 1/Arrow-Upward/arrow_upward_32dp");
}

.fe-icon-refresh {
    background-image:
        resource("Icons/System/Power/Restart/refresh_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.fe-icon-more {
    background-image:
        resource("Icons/UI/More-Horiz-Menu/more_horiz_32dp");
}

.fe-icon-close {
    background-image:
        resource("Icons/Math/Multiplication/close_small_32dp");
}

.fe-icon-chevron {
    background-image:
        resource("Icons/Arrows 1/Expand-Arrow/keyboard_arrow_down_32dp");
}

.fe-icon-grid {
    background-image:
        resource("Icons/Layout/Grid/grid_view_32dp");
}

.fe-icon-list {
    background-image:
        resource("Icons/Layout/List/list_32dp");
}

.fe-icon-home {
    background-image:
        resource("Icons/Nav/Home/home_32dp");
}

.fe-icon-recent {
    background-image:
        resource("Icons/System/Recent/schedule_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.fe-icon-starred {
    background-image:
        resource("Icons/Apps/Browser/Star/star_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.fe-icon-desktop {
    background-image:
        resource("Icons/Files/Storage-Types/Desktop/desktop_windows_32dp");
}

.fe-icon-documents {
    background-image:
        resource("Icons/Files/Storage-Types/Documents/description_32dp");
}

.fe-icon-pictures {
    background-image:
        resource("Icons/Files/Storage-Types/Images/image_32dp");
}

.fe-icon-downloads {
    background-image:
        resource("Icons/Files/Storage-Types/Downloads/download_32dp");
}

.fe-icon-shortcut {
    background-image:
        resource("Icons/Arrows 1/Diagonal-Upper-Right/north_east_32dp");
}

/* Sidebar content */

.fe-window .fe-sidebar-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.fe-window .fe-sidebar-icon {
    margin-right: 10px;
}

.fe-sidebar-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: var(--text-secondary);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.fe-sidebar-item--active .fe-sidebar-label {
    color: var(--accent-hover);
}

/* Dropdown content */

.fe-window .fe-popover-icon {
    margin-right: 9px;
}

.fe-breadcrumb-trail {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 100%;
}

.fe-address-field {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 26px;
    margin: 0;
}

.fe-address-field > .unity-text-field__input {
    background-color: transparent;
    color: var(--text-primary);
    border-width: 0;
    padding-left: 0;
    padding-right: 4px;
    -unity-text-align: middle-left;
}

.fe-address-field--invalid > .unity-text-field__input {
    color: rgb(255, 145, 145);
}

.fe-address-error {
    display: none;
    flex-shrink: 0;
    margin-left: 8px;
    color: rgb(255, 145, 145);
    font-size: 11px;
}