.file-explorer {
    flex-grow: 1;
    background-color: rgb(246, 248, 251);
    color: rgb(30, 32, 36);
}

/* ============================================================
   TAB BAR
   ============================================================ */

.fe-tab-bar {
    height: 42px;
    flex-direction: row;
    align-items: flex-end;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(235, 239, 244);
    border-bottom-width: 1px;
    border-bottom-color: rgb(214, 219, 226);
}

.fe-tabs {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    overflow: hidden;
}

.fe-tab {
    min-width: 140px;
    max-width: 220px;
    height: 34px;
    margin-right: 4px;
    padding-left: 12px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    background-color: rgb(224, 228, 234);
}

.fe-tab:hover {
    background-color: rgb(231, 235, 240);
}

.fe-tab--active {
    background-color: rgb(255, 255, 255);
}

.fe-tab__icon {
    width: 22px;
    font-size: 14px;
    color: rgb(90, 95, 104);
}

.fe-tab__label {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(56, 59, 65);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.fe-tab--active .fe-tab__label {
    -unity-font-style: bold;
    color: rgb(30, 32, 36);
}

.fe-tab__close {
    width: 24px;
    height: 24px;
    padding: 0;
    margin-left: 5px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(105, 110, 118);
}

.fe-tab__close:hover {
    background-color: rgb(217, 221, 227);
    color: rgb(45, 47, 52);
}

.fe-new-tab-button {
    width: 34px;
    height: 34px;
    margin-left: 4px;
    margin-bottom: 0;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(75, 80, 90);
    font-size: 19px;
}

.fe-new-tab-button:hover {
    background-color: rgb(215, 220, 227);
}

/* ============================================================
   NAVIGATION BAR
   ============================================================ */

.fe-navigation-bar {
    height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(227, 230, 235);
}

.fe-navigation-controls {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.fe-nav-button {
    width: 34px;
    height: 34px;
    margin-right: 3px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(75, 79, 88);
    font-size: 19px;
}

.fe-nav-button:hover {
    background-color: rgb(239, 242, 246);
}

.fe-nav-button:disabled {
    opacity: 0.35;
}

.fe-breadcrumb-container {
    flex-grow: 1;
    height: 36px;
    margin-right: 12px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(246, 248, 251);
    border-width: 1px;
    border-color: rgb(225, 228, 234);
    border-radius: 9px;
    overflow: hidden;
}

.fe-breadcrumb {
    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(79, 83, 91);
    font-size: 12px;
}

.fe-breadcrumb:hover {
    background-color: rgb(233, 237, 242);
}

.fe-breadcrumb--current {
    -unity-font-style: bold;
    color: rgb(30, 32, 36);
}

.fe-breadcrumb-separator {
    margin-left: 1px;
    margin-right: 1px;
    color: rgb(150, 154, 162);
    font-size: 13px;
}

.fe-search-container {
    width: 260px;
    height: 36px;
    padding-left: 10px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(246, 248, 251);
    border-width: 1px;
    border-color: rgb(225, 228, 234);
    border-radius: 9px;
}

.fe-search-container:focus {
    border-color: rgb(100, 139, 219);
    background-color: rgb(255, 255, 255);
}

.fe-search-icon {
    width: 22px;
    font-size: 15px;
    color: rgb(119, 124, 133);
}

.fe-search-field {
    flex-grow: 1;
}

.fe-search-field > .unity-text-input {
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(40, 42, 47);
    font-size: 12px;
}

/* ============================================================
   COMMAND BAR
   ============================================================ */

.fe-command-bar {
    height: 50px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(229, 232, 237);
}

.fe-command-spacer {
    flex-grow: 1;
}

.fe-command-button {
    height: 32px;
    margin-right: 6px;
    padding-left: 13px;
    padding-right: 13px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(72, 76, 84);
    font-size: 12px;
}

.fe-command-button:hover {
    background-color: rgb(240, 243, 247);
}

.fe-command-button--primary {
    background-color: rgb(54, 102, 204);
    color: rgb(255, 255, 255);
}

.fe-command-button--primary:hover {
    background-color: rgb(46, 91, 187);
}

.fe-command-icon-button {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(80, 84, 92);
    font-size: 16px;
}

.fe-command-icon-button:hover {
    background-color: rgb(240, 243, 247);
}

/* ============================================================
   WORKSPACE
   ============================================================ */

.fe-workspace {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* ============================================================
   SIDEBAR
   ============================================================ */

.fe-sidebar {
    width: 210px;
    min-width: 190px;
    max-width: 260px;
    padding: 14px 10px;
    background-color: rgb(249, 250, 252);
    border-right-width: 1px;
    border-right-color: rgb(225, 228, 233);
}

.fe-sidebar .unity-scroll-view__content-container {
    padding-bottom: 12px;
}

.fe-sidebar-item {
    height: 38px;
    margin-bottom: 3px;
    padding-left: 12px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(68, 72, 80);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.fe-sidebar-item:hover {
    background-color: rgb(237, 240, 244);
}

.fe-sidebar-item--active {
    background-color: rgb(226, 235, 252);
    color: rgb(44, 87, 178);
    -unity-font-style: bold;
}

.fe-sidebar-heading {
    margin-top: 14px;
    margin-bottom: 7px;
    margin-left: 12px;
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(145, 149, 158);
}

.fe-sidebar-divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(228, 231, 236);
}

/* ============================================================
   MAIN CONTENT
   ============================================================ */

.fe-main {
    flex-grow: 1;
    min-width: 0;
    background-color: rgb(255, 255, 255);
}

.fe-directory-header {
    height: 76px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.fe-directory-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(30, 32, 36);
}

.fe-directory-subtitle {
    margin-top: 3px;
    font-size: 11px;
    color: rgb(125, 129, 137);
}

.fe-directory-actions {
    flex-direction: row;
    align-items: center;
}

.fe-sort-status {
    font-size: 11px;
    color: rgb(128, 132, 141);
}

/* ============================================================
   CONTENT SCROLL VIEW
   ============================================================ */

.fe-content-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-left: 16px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.fe-content-scroll .unity-scroll-view__content-container {
    padding-left: 8px;
    padding-right: 12px;
    padding-bottom: 18px;
}

.fe-content {
    flex-grow: 1;
}

/* ============================================================
   GRID VIEW
   ============================================================ */

.fe-content--grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.fe-file-card {
    width: 158px;
    height: 164px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 9px;
    border-width: 1px;
    border-color: rgb(225, 228, 233);
    border-radius: 11px;
    background-color: rgb(255, 255, 255);
}

.fe-file-card:hover {
    border-color: rgb(185, 201, 231);
    background-color: rgb(249, 251, 255);
}

.fe-file-card--selected {
    border-color: rgb(83, 127, 215);
    background-color: rgb(235, 242, 255);
}

.fe-file-card__preview {
    height: 100px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: rgb(244, 246, 249);
    overflow: hidden;
}

.fe-file-card__thumbnail {
    width: 100%;
    height: 100%;
}

.fe-file-card__icon {
    font-size: 34px;
    color: rgb(100, 105, 114);
}

.fe-file-card__name {
    margin-top: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(45, 47, 52);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.fe-file-card__metadata {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(133, 137, 146);
}

.fe-file-card--folder .fe-file-card__preview {
    background-color: rgb(238, 243, 254);
}

.fe-file-card--folder .fe-file-card__icon {
    color: rgb(62, 105, 195);
}

/* ============================================================
   LARGE GRID VIEW
   ============================================================ */

.fe-content--large-grid .fe-file-card {
    width: 200px;
    height: 205px;
}

.fe-content--large-grid .fe-file-card__preview {
    height: 135px;
}

.fe-content--large-grid .fe-file-card__name {
    font-size: 13px;
}

/* ============================================================
   LIST VIEW
   ============================================================ */

.fe-content--list {
    flex-direction: column;
}

.fe-file-row {
    height: 46px;
    margin-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-radius: 7px;
}

.fe-file-row:hover {
    background-color: rgb(246, 248, 251);
}

.fe-file-row--selected {
    background-color: rgb(229, 238, 255);
}

.fe-file-row__icon {
    width: 32px;
    font-size: 17px;
    color: rgb(95, 100, 109);
}

.fe-file-row__name {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(45, 47, 52);
}

.fe-file-row__metadata {
    width: 140px;
    font-size: 11px;
    color: rgb(132, 136, 145);
}

/* ============================================================
   DETAILS VIEW
   ============================================================ */

.fe-content--details {
    flex-direction: column;
}

.fe-details-header {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(229, 232, 237);
}

.fe-details-header__column {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(120, 124, 133);
}

.fe-details-row {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 6px;
}

.fe-details-row:hover {
    background-color: rgb(246, 248, 251);
}

.fe-details-row--selected {
    background-color: rgb(229, 238, 255);
}

.fe-details-name {
    flex-grow: 1;
    min-width: 200px;
    flex-direction: row;
    align-items: center;
}

.fe-details-icon {
    width: 28px;
    font-size: 15px;
}

.fe-details-text {
    font-size: 11px;
    color: rgb(60, 63, 70);
}

.fe-details-column--date {
    width: 160px;
}

.fe-details-column--type {
    width: 120px;
}

.fe-details-column--size {
    width: 90px;
}

/* ============================================================
   EMPTY STATE
   ============================================================ */

.fe-empty-state {
    flex-grow: 1;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.fe-empty-icon {
    margin-bottom: 12px;
    font-size: 38px;
    color: rgb(175, 179, 187);
}

.fe-empty-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(68, 71, 78);
}

.fe-empty-description {
    margin-top: 5px;
    font-size: 11px;
    color: rgb(132, 136, 144);
}

/* ============================================================
   STATUS BAR
   ============================================================ */

.fe-status-bar {
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(249, 250, 252);
    border-top-width: 1px;
    border-top-color: rgb(226, 229, 234);
}

.fe-status-text {
    font-size: 10px;
    color: rgb(125, 129, 137);
}

/* ============================================================
   POPOVERS / MENUS
   ============================================================ */

.fe-popover {
    min-width: 190px;
    padding: 6px;
    position: absolute;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(216, 220, 227);
    border-radius: 10px;
}

.fe-popover-item {
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(66, 69, 76);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.fe-popover-item:hover {
    background-color: rgb(240, 243, 247);
}

.fe-popover-item--selected {
    background-color: rgb(229, 238, 255);
    color: rgb(46, 91, 183);
}

.fe-popover-divider {
    height: 1px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgb(230, 233, 237);
}

/* ============================================================
   CONTEXT MENU
   ============================================================ */

.fe-context-menu {
    width: 210px;
    padding: 6px;
    position: absolute;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(216, 220, 227);
    border-radius: 10px;
}

.fe-context-menu__item {
    height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(64, 67, 74);
    font-size: 11px;
}

.fe-context-menu__item:hover {
    background-color: rgb(240, 243, 247);
}

.fe-context-menu__item--danger {
    color: rgb(178, 63, 63);
}

.fe-context-menu__divider {
    height: 1px;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: rgb(230, 233, 237);
}

/* ============================================================
   SCROLLBARS
   ============================================================ */

.fe-content-scroll .unity-scroller--vertical {
    width: 10px;
}

.fe-content-scroll .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
}

.fe-content-scroll .unity-base-slider__dragger {
    width: 6px;
    border-radius: 4px;
    background-color: rgb(190, 195, 203);
}

.fe-content-scroll .unity-base-slider__dragger:hover {
    background-color: rgb(155, 161, 170);
}

.fe-sidebar .unity-scroller--vertical {
    width: 8px;
}

.fe-sidebar .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
}

.fe-sidebar .unity-base-slider__dragger {
    width: 5px;
    border-radius: 4px;
    background-color: rgb(195, 199, 207);
}