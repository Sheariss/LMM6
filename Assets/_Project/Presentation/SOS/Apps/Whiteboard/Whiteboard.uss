/* =========================================================
   WINDOW SHELL
   Shared Window.uss supplies the standard window styles.
   ========================================================= */

.wb-window {
    flex-direction: column;
    min-width: 800px;
    min-height: 680px;
    overflow: hidden;
    background-color: var(--window-bg);
    color: var(--text-primary);
    font-size: var(--text-sm);
}

.wb-window > .header {
    height: 42px;
    min-height: 42px;
    flex-shrink: 0;
    background-color: var(--window-header);
}

.wb-window > .header > .header-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 10px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.wb-window .window-controls {
    height: 42px;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    border-width: 0;
}

.wb-window .wc-button {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    flex-shrink: 0;
    margin: 0;
    padding: 6px;
    border-width: 0;
    border-radius: 0;
}

.wb-window .wc-btn-icon {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.wb-window .window-maximize-icon {
    width: 20px;
    height: 20px;
}

.wb-window .window-close-button:hover {
    background-color: var(--error-button-hover);
}

.wb-window .window-close-button:active {
    background-color: var(--error-button-pressed);
}

.wb-window > .wb-window-content {
    width: 100%;
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.wb-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

/* =========================================================
   APP CONTROLS
   Scoped to app content so window controls stay independent.
   ========================================================= */

.wb-root Button {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--border-thin);
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--radius-md);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.wb-root Button:hover {
    background-color: var(--surface-hover);
}

.wb-root Button:active {
    background-color: var(--surface-active);
}

.wb-root Button:focus {
    border-color: var(--border-focus);
}

.wb-root Button:disabled {
    opacity: var(--opacity-disabled);
}

.wb-root Label {
    margin: 0;
    padding: 0;
}

.wb-spacer {
    flex-grow: 1;
}

.wb-root .wb-icon-button {
    width: var(--control-md);
    height: var(--control-md);
}

.wb-root .wb-text-button {
    height: var(--control-md);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    font-size: var(--text-xs);
}

/* =========================================================
   DOCUMENT HEADER
   ========================================================= */

.wb-header {
    height: 88px;
    min-height: 88px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    background-color: var(--surface-primary);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--border-primary);
}

.wb-board-heading {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 200px;
    max-width: 520px;
}

.wb-board-title {
    height: var(--control-md);
    min-height: var(--control-md);
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

.wb-board-title .unity-base-text-field__input {
    height: var(--control-md);
    min-height: var(--control-md);
    margin: 0;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    padding-top: 0;
    padding-bottom: 0;
    border-width: var(--border-thin);
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--radius-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-primary);
    font-size: var(--text-lg);
    -unity-text-align: middle-left;
}

.wb-board-title .unity-text-element {
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
}

.wb-board-title .unity-base-text-field__input:hover {
    border-color: var(--border-primary);
}

.wb-board-title .unity-base-text-field__input:focus {
    border-color: var(--border-focus);
    background-color: var(--bg-primary);
}

.wb-menu-row {
    height: var(--control-xs);
    flex-shrink: 0;
    flex-direction: row;
}

.wb-root .wb-menu-button {
    height: var(--control-xs);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: var(--text-xs);
}

.wb-root .wb-save-status {
    margin-left: var(--space-4);
    margin-right: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-xs);
}

.wb-root .wb-export-button {
    min-width: 88px;
    margin-left: var(--space-2);
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    height: 40px;
    border-radius: 20px;
    border-color: var(--accent-primary);
    color: var(--accent-hover);
}

.wb-root .wb-export-button:hover {
    background-color: var(--atlas-ui-950);
    border-color: var(--accent-hover);
}

/* =========================================================
   CANVAS
   ========================================================= */

.wb-workspace {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: var(--bg-primary);
}

.wb-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wb-viewport {
    overflow: hidden;
}

.wb-board-transform {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-origin: 0% 0%;
}

/* =========================================================
   TOOL RAIL
   ========================================================= */

.wb-tool-rail {
    position: absolute;
    left: var(--space-3);
    top: var(--space-4);
    width: 56px;
    padding: var(--space-1);
    background-color: var(--surface-primary);
    border-width: var(--border-thin);
    border-color: var(--border-primary);
    border-radius: var(--radius-lg);
}

.wb-root .wb-tool {
    width: 46px;
    height: 42px;
    min-height: 42px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.wb-root .wb-tool--selected,
.wb-root .wb-tool--selected:hover {
    background-color: var(--atlas-ui-950);
    border-color: var(--accent-primary);
}

.wb-tool--selected > .wb-icon {
    -unity-background-image-tint-color: var(--accent-hover);
}

.wb-horizontal-divider {
    height: 1px;
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
    margin-left: var(--space-2);
    margin-right: var(--space-2);
    background-color: var(--border-primary);
}

#HandToolIcon {
    display: none;
}

/* Apply this state class to NavigationToolButton for hand mode. */

.wb-navigation--pan #CursorToolIcon {
    display: none;
}

.wb-navigation--pan #HandToolIcon {
    display: flex;
}

/* =========================================================
   FLOATING CONTROLS
   ========================================================= */

.wb-floating-row {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: var(--space-1);
    background-color: var(--surface-primary);
    border-width: var(--border-thin);
    border-color: var(--border-primary);
    border-radius: var(--radius-lg);
}

.wb-history-toolbar {
    left: 80px;
    top: var(--space-4);
}

.wb-bottom-left {
    left: var(--space-3);
    bottom: var(--space-3);
}

.wb-zoom-controls {
    right: var(--space-3);
    bottom: var(--space-3);
}

.wb-root .wb-zoom-value {
    width: 60px;
    height: var(--control-md);
    font-size: var(--text-xs);
}

.wb-vertical-divider {
    width: 1px;
    height: var(--icon-md);
    flex-shrink: 0;
    margin-left: var(--space-1);
    margin-right: var(--space-1);
    background-color: var(--border-primary);
}

.wb-root .wb-tool-hint {
    position: absolute;
    left: 180px;
    right: 240px;
    bottom: 28px;
    color: var(--text-muted);
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
}

.wb-context-toolbar {
    left: 80px;
    top: 76px;
}

/* =========================================================
   BOARD SETTINGS
   ========================================================= */

.wb-settings-panel {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    width: 248px;
    background-color: var(--surface-primary);
    border-width: var(--border-thin);
    border-color: var(--border-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.wb-settings-header {
    height: 48px;
    min-height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: var(--space-4);
    padding-right: var(--space-1);
    border-bottom-width: var(--border-thin);
    border-bottom-color: var(--border-primary);
}

.wb-panel-title {
    color: var(--text-primary);
    font-size: var(--text-sm);
    -unity-font-style: bold;
}

.wb-settings-body {
    padding: var(--space-4);
}

.wb-root .wb-section-label {
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-xs);
}

.wb-swatch-row {
    flex-direction: row;
    align-items: center;
}

.wb-root .wb-swatch {
    width: 30px;
    height: 30px;
    margin-right: var(--space-2);
    border-width: var(--border-thin);
    border-color: var(--border-secondary);
    border-radius: var(--radius-full);
}

.wb-root .wb-swatch:hover {
    border-color: var(--text-primary);
}

.wb-root .wb-swatch-dark,
.wb-root .wb-swatch-dark:hover {
    background-color: var(--bg-primary);
}

.wb-root .wb-swatch-slate,
.wb-root .wb-swatch-slate:hover {
    background-color: var(--bg-tertiary);
}

.wb-root .wb-swatch-blue,
.wb-root .wb-swatch-blue:hover {
    background-color: var(--atlas-ui-950);
}

.wb-root .wb-swatch-green,
.wb-root .wb-swatch-green:hover {
    background-color: var(--success-bg-subtle);
}

.wb-root .wb-swatch-selected {
    border-width: var(--border-medium);
    border-color: var(--accent-hover);
}

.wb-root .wb-swatch-custom {
    margin-right: 0;
}

.wb-swatch-custom > .wb-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
}

.wb-settings-divider {
    height: 1px;
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    background-color: var(--border-primary);
}

.wb-setting {
    margin: 0;
    margin-bottom: var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-xs);
}

.wb-setting > .unity-toggle__label {
    min-width: 0;
    flex-grow: 1;
    color: var(--text-secondary);
}

/* =========================================================
   ICONS
   Resource paths are relative to a Resources folder.
   ========================================================= */

.wb-icon {
    width: var(--icon-lg);
    height: var(--icon-lg);
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-primary);
}

.wb-icon-minimize {
    background-image: resource("Icons/UI/Minimize/remove_32dp_");
}

.wb-icon-maximize {
    background-image: resource("Icons/UI/Maximize-Exit/crop_square_32dp");
}

.wb-icon-restore {
    background-image: resource("Icons/UI/Maximize/filter_none_32dp");
}

.wb-icon-close {
    background-image: resource("Icons/UI/Close/close_32dp");
}

.wb-icon-undo {
    background-image: resource("Icons/Arrows 1/Undo/undo_32dp");
}

.wb-icon-redo {
    background-image: resource("Icons/Arrows 1/Redo/redo_32dp");
}

.wb-icon-minus {
    background-image: resource("Icons/Math/Minus/remove_32dp");
}

.wb-icon-add {
    background-image: resource("Icons/Math/Add/add_2_32dp");
}

.wb-icon-fit {
    background-image: resource("Icons/Arrows 1/Open-in-Full/open_in_full_32dp");
}

/* Add your resource links to these classes. */

.wb-app-icon {
    background-image: resource("AppIcons/Whiteboard/icons8-whiteboard-48")
}

.wb-icon-cursor {
    background-image: resource("Icons/Apps/Whiteboard/arrow_selector_tool_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-hand {
     background-image: resource("Icons/Apps/Whiteboard/pan_tool_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-note {
     background-image: resource("Icons/Apps/Whiteboard/sticky_note_2_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-text {
    background-image: resource("Icons/Apps/Whiteboard/title_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-shapes {
    background-image: resource("Icons/Apps/Whiteboard/shapes_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-draw {
    background-image: resource("Icons/Apps/Whiteboard/stylus_note_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-frame {}

.wb-icon-sticker {
    background-image: resource("Icons/Apps/Whiteboard/sticker_add_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.wb-icon-settings {}

.wb-icon-help {
    background-image: resource("Icons/Apps/Whiteboard/question_mark_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

/* =========================================================
   VISIBILITY
   ========================================================= */

.wb-hidden {
    display: none;
}