<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3#ATLAS"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Window/Window.uss?fileID=7433441132597879392&amp;guid=00c704ca2f7eb4f469f7b2b139bf1194&amp;type=3#Window"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Apps/Whiteboard/Whiteboard.uss?fileID=7433441132597879392&amp;guid=79e2ddd9f3e9ab142a36cea671676eea&amp;type=3#Whiteboard"/>
    <ui:VisualElement name="WindowRoot" class="window wb-window">
        <ui:VisualElement name="WindowHeader" class="flex-row header">
            <ui:Image name="WindowIcon" picking-mode="Ignore" class="header-icon wb-app-icon"/>
            <ui:Label name="WindowTitle" text="Whiteboard" class="spacing-reset header-title"/>
            <ui:GroupBox name="WindowControls" class="flex-row spacing-reset window-controls">
                <ui:Button name="WindowMinimizeButton" tooltip="Minimize" class="button-reset wc-button">
                    <ui:Image name="MinimizeIcon" picking-mode="Ignore" class="wc-btn-icon wb-icon-minimize"/>
                </ui:Button>
                <ui:Button name="WindowMaximizeButton" tooltip="Maximize or restore" class="button-reset wc-button">
                    <ui:Image name="FullscreenIcon" picking-mode="Ignore" class="wc-btn-icon window-maximize-icon wb-icon-maximize"/>
                    <ui:Image name="ExitFullscreenIcon" picking-mode="Ignore" class="wc-btn-icon window-maximize-icon wb-icon-restore"/>
                </ui:Button>
                <ui:Button name="WindowCloseButton" tooltip="Close" class="button-reset wc-button window-close-button">
                    <ui:Image name="CloseIcon" picking-mode="Ignore" class="wc-btn-icon wb-icon-close"/>
                </ui:Button>
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:VisualElement name="WindowContent" class="content wb-window-content">
            <ui:VisualElement name="WhiteboardRoot" class="wb-root">
                <ui:VisualElement class="wb-header">
                    <ui:VisualElement class="wb-board-heading">
                        <ui:TextField name="BoardTitleField" value="Untitled whiteboard" max-length="80" tooltip="" class="wb-board-title" style="display: flex;"/>
                        <ui:VisualElement class="wb-menu-row">
                            <ui:Button name="FileMenuButton" text="File" class="wb-menu-button"/>
                            <ui:Button name="EditMenuButton" text="Edit" class="wb-menu-button"/>
                            <ui:Button name="ViewMenuButton" text="View" class="wb-menu-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="wb-spacer"/>
                    <ui:Label name="SaveStatusLabel" text="Unsaved board" class="wb-save-status"/>
                    <ui:Button name="BoardSettingsButton" tooltip="Board settings" class="wb-icon-button">
                        <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-settings"/>
                    </ui:Button>
                    <ui:Button name="ExportButton" text="Export" class="wb-text-button wb-export-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="Workspace" class="wb-workspace">
                    <ui:VisualElement name="BoardViewport" class="wb-fill wb-viewport">
                        <ui:VisualElement name="GridLayer" picking-mode="Ignore" class="wb-fill"/>
                        <ui:VisualElement name="BoardTransform" class="wb-board-transform">
                            <ui:VisualElement name="FrameLayer" picking-mode="Ignore" class="wb-fill"/>
                            <ui:VisualElement name="ConnectorLayer" picking-mode="Ignore" class="wb-fill"/>
                            <ui:VisualElement name="ObjectLayer" picking-mode="Ignore" class="wb-fill"/>
                            <ui:VisualElement name="DrawingLayer" picking-mode="Ignore" class="wb-fill"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="SelectionLayer" picking-mode="Ignore" class="wb-fill"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ToolRail" class="wb-tool-rail">
                        <ui:Button name="NavigationToolButton" tooltip="Select / hand · V / H" class="wb-tool wb-tool--selected">
                            <ui:Image name="CursorToolIcon" picking-mode="Ignore" class="wb-icon wb-icon-cursor"/>
                            <ui:Image name="HandToolIcon" picking-mode="Ignore" class="wb-icon wb-icon-hand"/>
                        </ui:Button>
                        <ui:VisualElement class="wb-horizontal-divider"/>
                        <ui:Button name="StickyNoteToolButton" tooltip="Sticky note · N" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-note"/>
                        </ui:Button>
                        <ui:Button name="TextToolButton" tooltip="Text · T" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-text"/>
                        </ui:Button>
                        <ui:Button name="ShapesAndLinesToolButton" tooltip="Shapes and lines" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-shapes"/>
                        </ui:Button>
                        <ui:Button name="DrawToolButton" tooltip="Freehand · P" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-draw"/>
                        </ui:Button>
                        <ui:Button name="FrameToolButton" tooltip="Frame · F" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-frame"/>
                        </ui:Button>
                        <ui:Button name="StickerToolButton" tooltip="Stickers" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-sticker"/>
                        </ui:Button>
                        <ui:VisualElement class="wb-horizontal-divider"/>
                        <ui:Button name="MoreToolsButton" tooltip="More tools · Images and snips" class="wb-tool">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-add"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="HistoryTools" class="wb-floating-row wb-history-toolbar">
                        <ui:Button name="UndoButton" tooltip="Undo · Ctrl+Z" class="wb-icon-button">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-undo"/>
                        </ui:Button>
                        <ui:Button name="RedoButton" tooltip="Redo · Ctrl+Y" class="wb-icon-button">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-redo"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="wb-bottom-left wb-floating-row">
                        <ui:Button name="FramesButton" text="Frames" tooltip="Browse board frames" class="wb-text-button"/>
                        <ui:VisualElement class="wb-vertical-divider"/>
                        <ui:Button name="HelpButton" tooltip="Shortcuts and navigation" class="wb-icon-button">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-help"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="wb-zoom-controls wb-floating-row">
                        <ui:Button name="ZoomOutButton" tooltip="Zoom out" class="wb-icon-button">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-minus"/>
                        </ui:Button>
                        <ui:Button name="ZoomValueButton" text="100%" tooltip="Zoom options" class="wb-zoom-value"/>
                        <ui:Button name="ZoomInButton" tooltip="Zoom in" class="wb-icon-button">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-add"/>
                        </ui:Button>
                        <ui:VisualElement class="wb-vertical-divider"/>
                        <ui:Button name="FitToContentButton" tooltip="Fit board content" class="wb-icon-button">
                            <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-fit"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="ToolHintLabel" text="Select objects · Hold Space to pan" picking-mode="Ignore" class="wb-tool-hint"/>
                    <ui:VisualElement name="ContextToolbar" class="wb-context-toolbar wb-floating-row wb-hidden"/>
                    <ui:VisualElement name="BoardSettingsPanel" class="wb-settings-panel wb-hidden">
                        <ui:VisualElement class="wb-settings-header">
                            <ui:Label text="Board settings" class="wb-panel-title"/>
                            <ui:VisualElement class="wb-spacer"/>
                            <ui:Button name="CloseBoardSettingsButton" tooltip="Close board settings" class="wb-icon-button">
                                <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-close"/>
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="wb-settings-body">
                            <ui:Label text="BACKGROUND" class="wb-section-label"/>
                            <ui:VisualElement class="wb-swatch-row">
                                <ui:Button name="BackgroundDarkButton" tooltip="Dark" class="wb-swatch wb-swatch-dark wb-swatch-selected"/>
                                <ui:Button name="BackgroundSlateButton" tooltip="Slate" class="wb-swatch wb-swatch-slate"/>
                                <ui:Button name="BackgroundBlueButton" tooltip="Blue" class="wb-swatch wb-swatch-blue"/>
                                <ui:Button name="BackgroundGreenButton" tooltip="Green" class="wb-swatch wb-swatch-green"/>
                                <ui:Button name="CustomBackgroundButton" tooltip="Choose a custom background color" class="wb-swatch wb-swatch-custom">
                                    <ui:Image picking-mode="Ignore" class="wb-icon wb-icon-add"/>
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement class="wb-settings-divider"/>
                            <ui:Label text="CANVAS" class="wb-section-label"/>
                            <ui:Toggle name="ShowGridToggle" label="Show grid" value="true" class="wb-setting"/>
                            <ui:Toggle name="SnapToGridToggle" label="Snap to grid" value="false" class="wb-setting"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="PopupLayer" picking-mode="Ignore" class="wb-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
