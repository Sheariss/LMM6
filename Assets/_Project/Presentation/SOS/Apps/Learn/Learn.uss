/* App content; the existing SOS window provides the title bar. */
.learn-root {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    background-color: rgb(244, 245, 247);
    color: rgb(35, 43, 54);
    font-size: 14px;
    overflow: hidden;
}

.learn-root Label {
    margin: 0;
    padding: 0;
}

.learn-hidden {
    display: none;
}

.learn-wrap {
    white-space: normal;
}

.learn-sidebar {
    width: 190px;
    flex-shrink: 0;
    padding: 28px 16px 20px;
    background-color: rgb(250, 250, 251);
    border-right-width: 1px;
    border-right-color: rgb(225, 229, 234);
}

.learn-brand {
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(31, 54, 77);
}

.learn-brand-subtitle {
    margin-top: 2px;
    font-size: 16px;
    color: rgb(98, 108, 122);
}

.learn-sidebar-heading {
    margin-top: 40px;
    margin-bottom: 12px;
    font-size: 10px;
    color: rgb(105, 114, 127);
}

.learn-sidebar-footer {
    margin-top: auto;
    padding-top: 28px;
}

.learn-progress-label {
    margin-top: 8px;
    font-size: 14px;
    -unity-font-style: bold;
}

.learn-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.learn-topbar {
    height: 64px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(225, 229, 234);
}

.learn-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.learn-page {
    padding: 28px;
}

.learn-intro {
    padding: 26px;
    margin-bottom: 28px;
    background-color: white;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(228, 232, 236);
}

.learn-title {
    margin-bottom: 14px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(31, 42, 57);
}

.learn-section-title {
    margin-bottom: 16px;
    font-size: 19px;
    -unity-font-style: bold;
}

.learn-body {
    margin-bottom: 14px;
    font-size: 14px;
    color: rgb(83, 94, 109);
}

.learn-muted {
    font-size: 12px;
    color: rgb(107, 117, 130);
}

.learn-eyebrow {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(90, 105, 121);
}

.learn-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -16px;
}

.learn-card {
    width: 245px;
    flex-grow: 1;
    flex-shrink: 0;
    margin-right: 16px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: rgb(225, 229, 234);
    border-radius: 12px;
    background-color: white;
    overflow: hidden;
}

.learn-card-banner {
    height: 104px;
    flex-shrink: 0;
    padding: 18px;
    justify-content: space-between;
}

.learn-banner-email {
    background-color: rgb(223, 233, 241);
}

.learn-banner-account {
    background-color: rgb(228, 234, 224);
}

.learn-banner-information {
    background-color: rgb(239, 231, 216);
}

.learn-module-number {
    font-size: 30px;
    color: rgb(70, 88, 108);
}

.learn-card-body {
    flex-grow: 1;
    padding: 20px;
}

.learn-card-title {
    margin-bottom: 12px;
    font-size: 18px;
    -unity-font-style: bold;
}

.learn-status {
    align-self: flex-start;
    margin-top: auto;
    margin-bottom: 16px;
    padding: 5px 9px;
    border-radius: 6px;
    background-color: rgb(241, 243, 246);
    color: rgb(91, 103, 117);
    font-size: 11px;
}

.learn-card-body > .learn-muted {
    margin-bottom: 18px;
}

.learn-button {
    margin: 0;
    padding: 10px 16px;
    min-height: 40px;
    border-width: 1px;
    border-color: transparent;
    border-radius: 8px;
    font-size: 13px;
    -unity-font-style: normal;
    white-space: normal;
    color: rgb(35, 43, 54);
}

.learn-primary {
    background-color: rgb(43, 80, 112);
    color: white;
}

.learn-primary:hover {
    background-color: rgb(35, 67, 96);
}

.learn-primary:active {
    background-color: rgb(27, 53, 78);
}

.learn-secondary {
    background-color: white;
    border-color: rgb(212, 219, 227);
}

.learn-secondary:hover {
    background-color: rgb(237, 241, 245);
}

.learn-button:disabled {
    background-color: rgb(239, 241, 244);
    border-color: rgb(228, 232, 236);
    color: rgb(123, 132, 144);
}

.learn-button:focus {
    border-color: rgb(58, 113, 164);
}

.learn-nav {
    -unity-text-align: middle-left;
    background-color: transparent;
}

.learn-nav:hover {
    background-color: rgb(234, 239, 244);
}

.learn-nav--selected {
    background-color: rgb(224, 233, 242);
    color: rgb(34, 69, 104);
    -unity-font-style: bold;
}

.learn-progress {
    height: 8px;
    margin-top: 12px;
    margin-bottom: 16px;
}

.learn-progress .unity-progress-bar__container {
    padding: 0;
}

.learn-progress .unity-progress-bar__background {
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(224, 229, 235);
    overflow: hidden;
}

.learn-progress .unity-progress-bar__progress {
    border-radius: 4px;
    background-color: rgb(63, 105, 142);
}

.learn-progress .unity-progress-bar__title {
    display: none;
}

.learn-lesson-page {
    width: 100%;
    max-width: 880px;
    align-self: center;
}

.learn-lesson-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.learn-lesson-header > .learn-section-title {
    margin-bottom: 0;
}

.learn-lesson-card {
    padding: 30px;
    background-color: white;
    border-width: 1px;
    border-color: rgb(225, 229, 234);
    border-radius: 14px;
}

.learn-lesson-card .learn-eyebrow {
    margin-bottom: 12px;
}

.learn-example {
    margin-top: 12px;
    padding: 22px;
    border-width: 1px;
    border-color: rgb(219, 225, 232);
    border-radius: 10px;
    background-color: rgb(248, 249, 251);
}

.learn-example-subject {
    margin-bottom: 18px;
    font-size: 15px;
    -unity-font-style: bold;
}

.learn-example-link {
    color: rgb(43, 80, 112);
    -unity-font-style: bold;
}

.learn-lesson-navigation {
    margin-top: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.learn-answer {
    margin-bottom: 12px;
    padding: 16px;
    background-color: rgb(248, 249, 251);
    border-color: rgb(218, 224, 232);
    -unity-text-align: middle-left;
}

.learn-answer:hover {
    background-color: rgb(231, 239, 247);
    border-color: rgb(119, 151, 181);
}

.learn-answer--selected {
    background-color: rgb(224, 235, 245);
    border-color: rgb(63, 105, 142);
}

.learn-feedback {
    margin-top: 8px;
    padding: 18px;
    background-color: rgb(237, 242, 247);
    border-radius: 8px;
}

.learn-feedback .learn-body {
    margin-bottom: 0;
}

.learn-takeaway {
    margin-bottom: 16px;
    padding-left: 14px;
    border-left-width: 3px;
    border-left-color: rgb(119, 151, 181);
    font-size: 14px;
    color: rgb(83, 94, 109);
}

#ReturnToLibraryButton {
    margin-top: 12px;
    align-self: flex-start;
}