<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
 <Style src="Notepad.uss"/>
 <ui:VisualElement name="WindowRoot" class="window">
  <ui:VisualElement name="WindowHeader" class="header">
   <ui:VisualElement name="WindowIcon" class="header-icon"/>
   <ui:Label name="WindowTitle" text="Notepad" class="header-title"/>
   <ui:VisualElement class="window-controls"><ui:Button name="WindowMinimizeButton" text="_" tooltip="Minimize"/><ui:Button name="WindowMaximizeButton" text="[]" tooltip="Maximize"/><ui:Button name="WindowCloseButton" text="X" tooltip="Close"/></ui:VisualElement>
  </ui:VisualElement>
  <ui:VisualElement name="WindowContent" class="content"><ui:VisualElement class="toolbar"><ui:Button name="New" text="New"/><ui:Button name="Clear" text="Clear"/><ui:Button name="Open" text="Open"/><ui:Button name="Save" text="Save"/><ui:TextField name="FileName" label="File name" value="Untitled.txt" class="filename"/></ui:VisualElement><ui:VisualElement name="Prompt" class="prompt"><ui:Label name="PromptText"/><ui:VisualElement class="toolbar"><ui:Button name="Confirm" text="Discard changes"/><ui:Button name="Cancel" text="Cancel"/></ui:VisualElement></ui:VisualElement><ui:TextField name="Editor" multiline="true" class="editor"/><ui:Label name="Status" class="status"/></ui:VisualElement>
 </ui:VisualElement>
</ui:UXML>
