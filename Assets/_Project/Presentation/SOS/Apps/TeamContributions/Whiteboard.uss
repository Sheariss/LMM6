#WhiteboardRoot {
    flex-grow: 1;
    background-color: rgb(230, 232, 235);
}

.whiteboard-toolbar {
    height: 65px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(215, 218, 223);
    border-bottom-width: 1px;
    border-bottom-color: rgb(185, 185, 185);
}

.whiteboard-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 25px;
}

.toolbar-label {
    -unity-font-style: bold;
    margin-right: 7px;
}

.color-label {
    margin-left: 18px;
}

.toolbar-button {
    width: 75px;
    height: 34px;
    margin-right: 6px;
}

.clear-button {
    width: 75px;
    height: 34px;
    margin-left: 18px;
}

.drawing-area {
    flex-grow: 1;
    margin: 15px;
    background-color: rgb(255, 255, 255);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(175, 175, 175);
    border-right-color: rgb(175, 175, 175);
    border-top-color: rgb(175, 175, 175);
    border-bottom-color: rgb(175, 175, 175);
}