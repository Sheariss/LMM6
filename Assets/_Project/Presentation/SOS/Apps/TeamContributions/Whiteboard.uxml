<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Whiteboard.uss" />

    <ui:VisualElement
        name="WhiteboardRoot"
        class="whiteboard-root">

        <ui:VisualElement class="whiteboard-toolbar">

            <ui:Label
                text="Whiteboard"
                class="whiteboard-title" />

            <ui:Label
                text="Brush:"
                class="toolbar-label" />

            <ui:Button
                name="SmallBrushButton"
                text="Small"
                class="toolbar-button" />

            <ui:Button
                name="MediumBrushButton"
                text="Medium"
                class="toolbar-button" />

            <ui:Button
                name="LargeBrushButton"
                text="Large"
                class="toolbar-button" />

            <ui:Label
                text="Color:"
                class="toolbar-label color-label" />

            <ui:Button
                name="BlackButton"
                text="Black"
                class="toolbar-button" />

            <ui:Button
                name="RedButton"
                text="Red"
                class="toolbar-button" />

            <ui:Button
                name="BlueButton"
                text="Blue"
                class="toolbar-button" />

            <ui:Button
                name="ClearButton"
                text="Clear"
                class="clear-button" />

        </ui:VisualElement>

        <ui:VisualElement
            name="DrawingArea"
            class="drawing-area" />

    </ui:VisualElement>
</ui:UXML>