#root {
    flex-grow: 1;
    background-color: rgb(24, 24, 28);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

#title-label {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

#photo-image {
    flex-grow: 1;
    min-height: 300px;

    background-color: rgb(15, 15, 18);

    margin-bottom: 14px;

    -unity-background-scale-mode: scale-to-fit;
}

#photo-name-label {
    font-size: 22px;
    color: white;
    margin-bottom: 6px;
}

#counter-label {
    font-size: 17px;
    color: rgb(180, 180, 180);
    margin-bottom: 16px;
}

#previous-button,
#next-button {
    height: 58px;
    margin-top: 8px;

    background-color: rgb(45, 45, 52);
    color: white;

    font-size: 22px;

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}