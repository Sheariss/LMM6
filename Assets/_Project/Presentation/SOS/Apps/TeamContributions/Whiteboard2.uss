/* Self-contained app styles. All colors are scoped to this window. */

.wb-window {
    --wb-ink: rgb(32, 33, 36);
    --wb-muted: rgb(95, 99, 104);
    --wb-line: rgb(225, 228, 232);
    --wb-blue: rgb(26, 115, 232);
    --wb-blue-soft: rgb(232, 240, 254);
    --wb-hover: rgb(241, 243, 244);

    position: absolute;
    flex-direction: column;
    min-width: 960px;
    min-height: 740px;

    background-color: white;
    border-width: 1px;
    border-color: rgb(210, 214, 220);
    border-radius: 10px;
    overflow: hidden;

    color: var(--wb-ink);
    font-size: 13px;
}

/* Remove Unity's default button chrome within this app. */

.wb-window Button {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--wb-ink);
    -unity-text-align: middle-center;
}

.wb-window Button:hover {
    background-color: var(--wb-hover);
}

.wb-window Button:active {
    background-color: rgb(225, 229, 235);
}

.wb-window Button:focus {
    border-width: 1px;
    border-color: var(--wb-blue);
}

.wb-window Button:disabled {
    opacity: 0.4;
}

.wb-window Label {
    margin: 0;
    padding: 0;
}

.wb-spacer {
    flex-grow: 1;
}

/* Native-style window header */

.wb-window-header {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    background-color: rgb(247, 249, 252);
    border-bottom-width: 1px;
    border-bottom-color: var(--wb-line);
}

.wb-window-icon {
    width: 15px;
    height: 15px;
    margin-right: 9px;
    border-radius: 4px;
    background-color: var(--wb-blue);
    -unity-background-scale-mode: scale-to-fit;
}

.wb-window-title {
    flex-grow: 1;
    font-size: 12px;
    color: var(--wb-muted);
}

.wb-window-controls {
    height: 100%;
    flex-direction: row;
}

.wb-window .wb-window-button {
    width: 42px;
    height: 33px;
    border-radius: 0;
    font-size: 19px;
}

.wb-window .wb-window-close:hover {
    background-color: rgb(234, 67, 53);
    color: white;
}

#ExitFullscreenIcon {
    display: none;
}

.window-button--restore #FullscreenIcon {
    display: none;
}

.window-button--restore #ExitFullscreenIcon {
    display: flex;
}

/* App header */

.wb-window-content,
.wb-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.wb-header {
    height: 80px;
    min-height: 80px;
    flex-direction: row;
    align-items: center;
    padding-left: 22px;
    padding-right: 20px;
    background-color: white;
    border-bottom-width: 1px;
    border-bottom-color: var(--wb-line);
}

.wb-brand {
    width: 30px;
    height: 30px;
    margin-right: 15px;
    justify-content: center;
    flex-shrink: 0;
}

.wb-brand-row {
    flex-direction: row;
}

.wb-brand-tile {
    width: 11px;
    height: 11px;
    margin: 2px;
    border-radius: 3px;
}

.wb-blue {
    background-color: rgb(66, 133, 244);
}

.wb-red {
    background-color: rgb(234, 67, 53);
}

.wb-yellow {
    background-color: rgb(251, 188, 4);
}

.wb-green {
    background-color: rgb(52, 168, 83);
}

.wb-board-heading {
    width: 320px;
    min-width: 180px;
    flex-shrink: 1;
}

.wb-board-title {
    margin: 0;
    padding: 0;
    height: 30px;
}

.wb-board-title > .unity-text-field__input {
    margin: 0;
    padding-left: 7px;
    padding-right: 7px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--wb-ink);
    font-size: 19px;
}

.wb-board-title > .unity-text-field__input:hover {
    border-color: var(--wb-line);
}

.wb-board-title > .unity-text-field__input:focus {
    border-color: var(--wb-blue);
    background-color: white;
}

.wb-menu-row {
    flex-direction: row;
    margin-top: 2px;
}

.wb-window .wb-menu-button {
    height: 24px;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 5px;
    color: var(--wb-muted);
    font-size: 12px;
}

.wb-save-status {
    margin-right: 16px;
    color: var(--wb-muted);
    font-size: 11px;
}

.wb-window .wb-button {
    height: 36px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 12px;
    flex-shrink: 0;
}

.wb-window .wb-button-outlined {
    margin-left: 10px;
    border-width: 1px;
    border-color: rgb(210, 218, 230);
    border-radius: 18px;
    color: var(--wb-blue);
}

.wb-window .wb-button-outlined:hover {
    background-color: var(--wb-blue-soft);
}

.wb-window .wb-icon-button {
    width: 36px;
    height: 36px;
    font-size: 20px;
    flex-shrink: 0;
}

.wb-window .wb-icon-button-small {
    width: 28px;
    height: 28px;
}

/* Canvas and transform layers */

.wb-workspace {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(248, 249, 251);
}

.wb-viewport,
.wb-overlay-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.wb-viewport {
    overflow: hidden;
}

.wb-board-transform {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform-origin: 0% 0%;
}

.wb-board-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* Empty board guidance */

.wb-empty-state {
    position: absolute;
    left: 100px;
    right: 280px;
    top: 42%;
    align-items: center;
}

.wb-empty-title {
    font-size: 23px;
    color: rgb(118, 127, 142);
    -unity-text-align: middle-center;
    white-space: normal;
}

.wb-empty-description {
    margin-top: 10px;
    font-size: 13px;
    color: rgb(145, 153, 165);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Floating tool rail */

.wb-tool-rail {
    position: absolute;
    left: 16px;
    top: 16px;
    width: 66px;
    padding: 6px;
    background-color: white;
    border-width: 1px;
    border-color: var(--wb-line);
    border-radius: 16px;
}

.wb-window .wb-tool {
    height: 44px;
    min-height: 44px;
    margin-top: 1px;
    margin-bottom: 1px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
}

.wb-tool-symbol {
    height: 24px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.wb-tool-caption {
    font-size: 9px;
    color: var(--wb-muted);
    -unity-text-align: middle-center;
}

.wb-window .wb-tool--selected,
.wb-window .wb-tool--selected:hover {
    background-color: var(--wb-blue-soft);
    color: var(--wb-blue);
}

.wb-tool--selected .wb-tool-caption {
    color: var(--wb-blue);
}

.wb-note-symbol {
    width: 17px;
    height: 17px;
    margin-top: 3px;
    margin-bottom: 4px;
    background-color: rgb(253, 226, 147);
    border-width: 1px;
    border-color: rgb(222, 184, 75);
    border-radius: 3px;
}

.wb-divider-horizontal {
    height: 1px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: var(--wb-line);
}

.wb-divider-vertical {
    width: 1px;
    height: 20px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: var(--wb-line);
    flex-shrink: 0;
}

/* Floating control groups */

.wb-top-controls,
.wb-bottom-left,
.wb-zoom-controls,
.wb-context-toolbar {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 5px;
    background-color: white;
    border-width: 1px;
    border-color: var(--wb-line);
    border-radius: 12px;
}

.wb-top-controls {
    left: 96px;
    top: 16px;
}

.wb-bottom-left {
    left: 16px;
    bottom: 16px;
}

.wb-zoom-controls {
    right: 16px;
    bottom: 16px;
}

.wb-window .wb-zoom-value {
    width: 58px;
    height: 36px;
    font-size: 12px;
}

.wb-tool-hint {
    position: absolute;
    left: 160px;
    right: 240px;
    bottom: 29px;
    color: rgb(126, 135, 148);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.wb-context-toolbar {
    left: 96px;
    top: 76px;
}

/* Properties panel */

.wb-properties {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 224px;
    max-height: 420px;
    background-color: white;
    border-width: 1px;
    border-color: var(--wb-line);
    border-radius: 14px;
    overflow: hidden;
}

.wb-panel-header {
    height: 48px;
    min-height: 48px;
    padding-left: 16px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--wb-line);
}

.wb-panel-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.wb-properties-scroll {
    padding: 16px;
    min-height: 0;
    flex-shrink: 1;
}

.wb-section-label {
    margin-bottom: 12px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--wb-muted);
}

.wb-swatch-row {
    flex-direction: row;
    margin-bottom: 24px;
}

.wb-window .wb-swatch {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgb(218, 223, 230);
    border-radius: 15px;
}

.wb-window .wb-swatch-white,
.wb-window .wb-swatch-white:hover {
    background-color: white;
}

.wb-window .wb-swatch-warm,
.wb-window .wb-swatch-warm:hover {
    background-color: rgb(248, 249, 251);
}

.wb-window .wb-swatch-blue,
.wb-window .wb-swatch-blue:hover {
    background-color: rgb(232, 240, 254);
}

.wb-window .wb-swatch-green,
.wb-window .wb-swatch-green:hover {
    background-color: rgb(230, 244, 234);
}

.wb-window .wb-swatch--selected {
    border-width: 2px;
    border-color: var(--wb-blue);
}

.wb-setting {
    margin: 0;
    margin-bottom: 12px;
    font-size: 12px;
}

.wb-setting > .unity-toggle__label {
    min-width: 0;
    flex-grow: 1;
    color: var(--wb-muted);
}

.wb-panel-divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 20px;
    background-color: var(--wb-line);
}

.wb-panel-hint {
    margin-bottom: 8px;
    white-space: normal;
    font-size: 12px;
    color: rgb(128, 137, 150);
}

/* Utility state */

.wb-hidden {
    display: none;
}