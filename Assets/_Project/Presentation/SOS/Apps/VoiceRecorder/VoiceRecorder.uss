/* Base */
.recorder {
    flex-grow: 1;
    min-width: 760px;
    min-height: 580px;
    padding: 20px;
    background-color: #f2f5fa;
    color: #202124;
    font-size: 13px;
}

.recorder Label {
    margin: 0;
    padding: 0;
}

.recorder Button {
    margin: 0;
    border-width: 0;
    border-radius: 12px;
    background-image: none;
    -unity-font-style: normal;
}

.spacer {
    flex-grow: 1;
}

.muted-label {
    color: #747b87;
    font-size: 11px;
}

/* App header */
.app-header {
    height: 48px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.app-mark {
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    border-radius: 12px;
    background-color: #dce8ff;
}

.app-mark-icon {
    color: #1967d2;
    font-size: 20px;
}

.app-title {
    font-size: 19px;
    -unity-font-style: bold;
}

.text-button {
    height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: transparent;
    color: #566174;
}

.text-button:hover {
    background-color: #e6ecf5;
    color: #174ea6;
}

/* Main layout */
.workspace {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.sidebar {
    width: 264px;
    flex-shrink: 0;
    padding-right: 20px;
}

.sidebar-heading {
    height: 34px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.section-title {
    flex-grow: 1;
    font-size: 15px;
    -unity-font-style: bold;
}

.count-badge {
    min-width: 26px;
    height: 24px;
    border-radius: 12px;
    background-color: #e2e8f1;
    color: #596579;
    -unity-text-align: middle-center;
}

/* Search */
.search-field {
    height: 42px;
    margin: 0;
    margin-bottom: 22px;
}

.search-field > .unity-text-field__input {
    padding-left: 14px;
    padding-right: 14px;
    border-width: 1px;
    border-color: #dfe5ee;
    border-radius: 14px;
    background-color: #e9eef6;
    color: #344054;
}

.search-field > .unity-text-field__input:focus {
    border-color: #8ab4f8;
    background-color: #ffffff;
}

.group-label {
    margin-bottom: 10px;
    padding-left: 12px;
    color: #7b8493;
    font-size: 10px;
    -unity-font-style: bold;
}

.recordings-list {
    flex-grow: 1;
    min-height: 0;
}

.recording-item {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 12px;
    border-radius: 18px;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.recording-item:hover {
    background-color: #e7edf6;
}

.recording-item.selected {
    background-color: #dce8ff;
}

.recording-item.selected:hover {
    background-color: #d2e1fc;
}

.recording-icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    border-radius: 12px;
    background-color: #ffffff;
    color: #5f718c;
}

.selected .recording-icon {
    background-color: #c4d8fc;
    color: #185abc;
}

.recording-details {
    flex-grow: 1;
    min-width: 0;
}

.recording-title {
    overflow: hidden;
    color: #28354a;
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-font-style: bold;
}

.recording-meta {
    margin-top: 6px;
    color: #6f7a8c;
    font-size: 10px;
}

.selected-dot {
    margin-left: 8px;
    color: #1967d2;
    font-size: 10px;
}

.sidebar-footer {
    padding-top: 16px;
    padding-left: 12px;
}

/* Player card */
.player-card {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: #e4e9f1;
    border-radius: 26px;
    background-color: #ffffff;
}

.player-toolbar {
    height: 64px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 26px;
    padding-right: 18px;
}

.eyebrow {
    color: #8792a3;
    font-size: 10px;
    -unity-font-style: bold;
}

.more-button {
    width: 34px;
    height: 34px;
    background-color: transparent;
    color: #5f6b7d;
    font-size: 22px;
}

.more-button:hover {
    background-color: #eef3fa;
}

.player-content {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 12px 36px 24px 36px;
}

.recording-heading {
    color: #253147;
    font-size: 27px;
    -unity-font-style: bold;
}

.recording-subheading {
    margin-top: 9px;
    color: #8a93a1;
    font-size: 12px;
}

/* Decorative waveform */
.waveform {
    height: 110px;
    align-self: stretch;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    margin-bottom: 12px;
}

.waveform-baseline {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background-color: #edf2fa;
}

.wave-bar {
    width: 5px;
    max-width: 7px;
    flex-grow: 1;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 4px;
    background-color: #dce7f9;
}

.wave-bar.played {
    background-color: #6599ec;
}

.h1 { height: 14px; }
.h2 { height: 28px; }
.h3 { height: 44px; }
.h4 { height: 62px; }
.h5 { height: 82px; }
.h6 { height: 100px; }

/* Timeline */
.playback-slider {
    height: 20px;
    align-self: stretch;
    margin: 0;
}

.playback-slider .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    background-color: #e4ecfa;
}

.playback-slider .unity-base-slider__dragger {
    width: 12px;
    height: 12px;
    margin-top: -4px;
    border-width: 0;
    border-radius: 6px;
    background-color: #4285f4;
}

.time-labels {
    align-self: stretch;
    flex-direction: row;
    margin-top: 2px;
    color: #8a93a1;
    font-size: 11px;
}

/* Playback controls */
.playback-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}

.skip-button {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: transparent;
    color: #637187;
    font-size: 13px;
}

.skip-button:hover {
    background-color: #eef3fb;
}

.play-button {
    width: 64px;
    height: 64px;
    margin-left: 24px;
    margin-right: 24px;
    padding-left: 5px;
    border-radius: 24px;
    background-color: #dce8ff;
    color: #185abc;
    font-size: 25px;
}

.play-button:hover {
    background-color: #cbdcfc;
}

.play-button:active {
    background-color: #b7cff9;
}

.speed-button {
    height: 28px;
    margin-top: 14px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 14px;
    background-color: #f2f5fa;
    color: #68758a;
    font-size: 10px;
}

.speed-button:hover {
    background-color: #e5edfa;
}

/* Player footer */
.player-footer {
    height: 62px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 26px;
    padding-right: 20px;
    border-top-width: 1px;
    border-top-color: #eef1f6;
}

.export-button {
    height: 34px;
    margin-left: 8px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: #edf3ff;
    color: #1967d2;
}

.export-button:hover {
    background-color: #dce8ff;
}

/* Bottom recording dock */
.recording-dock {
    height: 82px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    padding-left: 20px;
    padding-right: 14px;
    border-width: 1px;
    border-color: #e4e9f1;
    border-radius: 24px;
    background-color: #ffffff;
}

.input-title {
    margin-bottom: 6px;
    color: #3c485c;
    font-size: 13px;
    -unity-font-style: bold;
}

.record-hint {
    margin-right: 18px;
    color: #7b8493;
    font-size: 12px;
}

.record-button {
    width: 56px;
    height: 56px;
    border-radius: 20px;
    background-color: #ea4335;
    color: #ffffff;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.record-button:hover {
    background-color: #d9382c;
}

.record-button:active {
    background-color: #c52f25;
}