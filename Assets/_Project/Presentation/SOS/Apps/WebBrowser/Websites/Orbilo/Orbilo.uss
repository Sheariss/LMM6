:root{
    --orbilo-logo-size: 90px;
}

/* Load Global-Colors.uss and Global-Tokens.uss before this stylesheet
   through the parent UIDocument UXML or add their project:// Style refs. */
.orbilo-page {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--bg-primary);
    align-items: center;
    justify-content: center;
    padding-left: 32px;
    padding-right: 32px;
}
.orbilo-content {
    width: 100%;
    max-width: 960px;
    align-items: center;
    margin-top: -64px;
}
.orbilo-brand {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 44px;
}
.orbilo-symbol {
    width: var(--orbilo-logo-size);
    height: var(--orbilo-logo-size);
    margin-right: var(--space-5);
    -unity-background-scale-mode: scale-to-fit;
}
.orbilo-wordmark { flex-direction: row; align-items: center; }
.orbilo-wordmark-main, .orbilo-wordmark-accent {
    font-size: 72px;
    -unity-font-style: bold;
}
.orbilo-wordmark-main { color: var(--text-primary); }
.orbilo-wordmark-accent { color: var(--atlas-ui-400); }
.orbilo-search-row {
    width: 100%;
    height: 64px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 32px;
    background-color: var(--surface-primary);
    padding-left: 22px;
    padding-right: 16px;
}
.orbilo-search-row:focus-within { border-color: var(--border-focus); }
.orbilo-search-icon {
    font-size: 34px;
    color: var(--text-muted);
    width: 42px;
    -unity-text-align: middle-center;
}
.orbilo-search-input { flex-grow: 1; height: 48px; margin-left: 10px; margin-right: 10px; }
.orbilo-search-input .unity-text-field__input {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--text-primary);
    font-size: 20px;
    padding-left: 0;
    padding-right: 0;
}
.orbilo-search-tool {
    width: 42px;
    height: 42px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--atlas-ui-400);
    font-size: 26px;
    -unity-text-align: middle-center;
}
.orbilo-search-tool:hover { background-color: var(--surface-hover); border-radius: 21px; }
.orbilo-search-divider { width: 1px; height: 26px; background-color: var(--border-primary); margin-left: 6px; margin-right: 6px; }
.orbilo-actions { flex-direction: row; justify-content: center; margin-top: 28px; }
.orbilo-action {
    height: 46px;
    min-width: 180px;
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    border-width: 1px;
    border-color: rgba(0,0,0,0);
    border-radius: 10px;
    font-size: 16px;
}
.orbilo-action:hover { background-color: var(--surface-active); border-color: var(--border-secondary); }
.orbilo-action:active { background-color: var(--accent-active); }
.orbilo-shortcuts { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 54px; }
.orbilo-shortcut { width: 132px; align-items: center; margin-bottom: 16px; }
.orbilo-shortcut-icon {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    border-width: 1px;
    border-color: var(--border-primary);
    background-color: var(--surface-primary);
    font-size: 34px;
    -unity-text-align: middle-center;
}
.orbilo-shortcut-icon:hover { background-color: var(--surface-hover); border-color: var(--border-focus); }
.orbilo-shortcut-icon:active { background-color: var(--surface-active); }
.orbilo-shortcut-label { color: var(--text-secondary); font-size: 15px; margin-top: 12px; -unity-text-align: middle-center; }
.shortcut-news { color: var(--info-400); }
.shortcut-weather { color: var(--warning-400); }
.shortcut-videos { color: var(--error-400); }
.shortcut-shopping { color: var(--success-400); }
.shortcut-travel { color: var(--atlas-ui-400); }
.shortcut-add { color: var(--text-secondary); }
