:root{
    --logo-area-width: 175px;
}

.news-site {
    flex-grow: 1;
    background-color: #f7f7f7;
    color: #181818;
}

.news-utility {
    height: 30px;
    padding-left: 32px;
    padding-right: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #ffffff;
    border-bottom-width: 1px;
    border-bottom-color: #eeeeee;
}

.news-utility__right {
    flex-direction: row;
    align-items: center;
}

.news-utility__text {
    font-size: 11px;
    color: #666666;
}

.news-utility__weather {
    margin-left: 18px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #333333;
}

.news-brand {
    height: 72px;
    padding-left: 32px;
    padding-right: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #ffffff;
}

.news-brand__logo {
    padding: var(--space-1);
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #111111;
    height: 100%;
    width: var(--logo-area-width);

}

.news-brand__logo:hover {
    color: #a51e2d;
}

.news-brand__logo-image{
    height: 100%;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.news-brand__actions {
    flex-direction: row;
    align-items: center;
}

.news-search {
    height: 32px;
    flex-direction: row;
    margin-right: 10px;
}

.news-search__field {
    width: 210px;
    height: 32px;
}

.news-search__field > .unity-text-input {
    padding-left: 10px;
    padding-right: 10px;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #cccccc;
    border-radius: 2px 0 0 2px;
    color: #222222;
    font-size: 11px;
}

.news-search__field:focus-within > .unity-text-input {
    border-color: #777777;
}

.news-search__button {
    width: 64px;
    height: 32px;
    margin-left: -1px;
    background-color: #333333;
    border-width: 0;
    border-radius: 0 2px 2px 0;
    color: #ffffff;
    font-size: 9px;
    -unity-font-style: bold;
}

.news-search__button:hover {
    background-color: #ffaa51;
    color:  #343434;
}

.news-sign-in {
    height: 32px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: transparent;
    border-width: 1px;
    border-color: #cccccc;
    border-radius: 2px;
    color: #333333;
    font-size: 10px;
    -unity-font-style: bold;
}

.news-sign-in:hover {
    background-color: #eeeeee;
}

.news-nav {
    height: 38px;
    padding-left: 24px;
    padding-right: 24px;
    flex-direction: row;
    align-items: stretch;
    background-color: #202020;
}

.news-nav__button {
    height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    color: #eeeeee;
    font-size: 10px;
    -unity-font-style: bold;
}

.news-nav__button:hover {
    background-color: #343434;
}

.news-nav__button--active {
    background-color: #ffaa51;
    color:  #343434;
}

.news-content-container {
    flex-grow: 1;
    min-height: 0;
}

.breaking-news {
    height: 34px;
    flex-direction: row;
    background-color: #ffffff;
    border-bottom-width: 1px;
    border-bottom-color: #d6d6d6;
    overflow: hidden;
}

.breaking-news__badge {
    width: 90px;
    min-width: 90px;
    height: 34px;
    align-items: center;
    justify-content: center;
    background-color: #a51e2d;
}

.breaking-news__badge-text {
    color: #ffffff;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.breaking-news__viewport {
    flex-grow: 1;
    height: 34px;
    overflow: hidden;
    justify-content: center;
}

.breaking-news__track {
    position: absolute;
    left: 0;
    height: 34px;
    flex-direction: row;
    align-items: center;
    white-space: nowrap;
}

.breaking-news__text {
    font-size: 11px;
    color: #333333;
    white-space: nowrap;
}