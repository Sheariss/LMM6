<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Window/Window.uss?fileID=7433441132597879392&amp;guid=00c704ca2f7eb4f469f7b2b139bf1194&amp;type=3#Window"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Apps/Calculator/Calculator.uss?fileID=7433441132597879392&amp;guid=1ac2649b43a836748b0ca9b43c44c7e7&amp;type=3"/>
    <ui:VisualElement name="WindowRoot" class="window" style="width: 352px;">
        <ui:VisualElement name="WindowHeader" class="flex-row header" style="opacity: 1;">
            <ui:VisualElement class="header-icon-area">
                <ui:Image name="WindowIcon" class="header-icon" style="background-image: resource(&quot;AppIcons/calculator&quot;);"/>
            </ui:VisualElement>
            <ui:Label text="Calculator" name="WindowTitle" class="spacing-reset header-title"/>
            <ui:GroupBox name="WindowControls" class="flex-row spacing-reset window-controls">
                <ui:Button text="" name="MinimizeBtn" class="button-reset wc-button">
                    <ui:Image name="MinimizeIcon" class="wc-btn-icon minimize-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Minimize/remove_32dp_.png?fileID=21300000&amp;guid=8ba13ee49df28774c813618f06427c37&amp;type=3#remove_32dp_&quot;);"/>
                </ui:Button>
                <ui:Button text="" name="MaximizeBtn" class="button-reset wc-button">
                    <ui:Image name="FullscreenIcon" class="wc-btn-icon window-maximize-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Maximize-Exit/crop_square_32dp.png?fileID=21300000&amp;guid=2fe5b0aec98d3e84387083094b2987e4&amp;type=3#crop_square_32dp&quot;); display: flex;"/>
                    <ui:Image name="ExitFullscreenIcon" class="wc-btn-icon window-maximize-icon" style="display: none; background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Maximize/filter_none_32dp.png?fileID=21300000&amp;guid=40a6434316977444baf5ceb2ad0f4953&amp;type=3#filter_none_32dp&quot;);"/>
                </ui:Button>
                <ui:Button text="" name="CloseBtn" class="button-reset wc-button window-close-button">
                    <ui:Image name="CloseIcon" class="wc-btn-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Close/close_32dp.png?fileID=21300000&amp;guid=f388726a89c92bb42abb8d4656bb544d&amp;type=3#close_32dp&quot;);"/>
                </ui:Button>
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:VisualElement name="WindowContent" class="content">
            <ui:VisualElement name="ContentRoot" class="fullscreen white-text calculator">
                <ui:GroupBox class="calculator-display-area">
                    <ui:Label text="" name="CalculatorExpression" class="spacing-reset calculator-expression"/>
                    <ui:TextField label="" placeholder-text="0" keyboard-type="NumbersAndPunctuation" auto-correction="false" picking-mode="Ignore" name="CalculatorDisplay" class="button-reset calculator-display"/>
                </ui:GroupBox>
                <ui:GroupBox class="spacing-reset calc-button-area">
                    <ui:GroupBox class="spacing-reset calculator-row">
                        <ui:Button text="%" name="PercentButton" class="button-reset calculator-button calculator-button--utility"/>
                        <ui:Button text="CE" name="ClearEntryButton" class="button-reset calculator-button calculator-button--utility"/>
                        <ui:Button text="C" name="ClearButton" class="button-reset calculator-button calculator-button--utility"/>
                        <ui:Button text="" name="BackspaceButton" class="button-reset calculator-button calculator-button--utility">
                            <ui:Image class="calculator-button-icon" style="background-image: resource(&quot;Icons/Math/Backspace/backspace_64dp&quot;);"/>
                        </ui:Button>
                    </ui:GroupBox>
                    <ui:GroupBox class="spacing-reset calculator-row">
                        <ui:Button text="1/x" name="FractionButton" class="button-reset calculator-button calculator-button--utility"/>
                        <ui:Button text=" x&lt;sup&gt;2 " name="SquareButton" class="button-reset calculator-button calculator-button--utility"/>
                        <ui:Button text="√x" name="RootButton" class="button-reset calculator-button calculator-button--utility"/>
                        <ui:Button text="÷" name="DivideButton" class="button-reset calculator-button calculator-button--operator"/>
                    </ui:GroupBox>
                    <ui:GroupBox class="spacing-reset calculator-row">
                        <ui:Button text="7" name="SevenButton" class="button-reset calculator-button"/>
                        <ui:Button text="8" name="EightButton" class="button-reset calculator-button"/>
                        <ui:Button text="9" name="NineButton" class="button-reset calculator-button"/>
                        <ui:Button text="×" name="MultiplyButton" class="button-reset calculator-button calculator-button--operator"/>
                    </ui:GroupBox>
                    <ui:GroupBox class="spacing-reset calculator-row">
                        <ui:Button text="4" name="FourButton" class="button-reset calculator-button"/>
                        <ui:Button text="5" name="FiveButton" class="button-reset calculator-button"/>
                        <ui:Button text="6" name="SixButton" class="button-reset calculator-button"/>
                        <ui:Button text="-" name="SubtractButton" class="button-reset calculator-button calculator-button--operator"/>
                    </ui:GroupBox>
                    <ui:GroupBox class="spacing-reset calculator-row">
                        <ui:Button text="1" name="OneButton" class="button-reset calculator-button"/>
                        <ui:Button text="2" name="TwoButton" class="button-reset calculator-button"/>
                        <ui:Button text="3" name="ThreeButton" class="button-reset calculator-button"/>
                        <ui:Button text="+" name="AddButton" class="button-reset calculator-button calculator-button--operator"/>
                    </ui:GroupBox>
                    <ui:GroupBox class="spacing-reset calculator-row">
                        <ui:Button text="+/-" name="SignButton" class="button-reset calculator-button"/>
                        <ui:Button text="0" name="ZeroButton" class="button-reset calculator-button"/>
                        <ui:Button text="." name="DecimalButton" class="button-reset calculator-button"/>
                        <ui:Button text="=" name="EqualButton" class="button-reset calculator-button calculator-button--operator calculator-button--equals"/>
                    </ui:GroupBox>
                </ui:GroupBox>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WindowFooter" class="footer"/>
    </ui:VisualElement>
</ui:UXML>
