<ui:UXML xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">

    <Style src="../../../Tokens/Global-Colors.uss"/>
    <Style src="../../../Tokens/Global-Tokens.uss"/>
    <Style src="../../../Tokens/ATLAS.uss"/>
    <Style src="../../Window/Window.uss"/>
    <Style src="Email.uss"/>

    <ui:VisualElement name="WindowRoot"
                      class="window email-window">

        <ui:VisualElement name="WindowHeader"
                          class="flex-row header">

            <ui:VisualElement class="email-header-icon-area">
                <ui:Image name="WindowIcon"
                          class="header-icon"
                          picking-mode="Ignore"/>
            </ui:VisualElement>

            <ui:Label name="WindowTitle"
                      text="Email"
                      class="spacing-reset header-title"/>

            <ui:GroupBox name="WindowControls"
                         class="flex-row spacing-reset window-controls">

                <ui:Button name="WindowMinimizeButton"
                           tooltip="Minimize"
                           class="button-reset wc-button">
                    <ui:Image name="MinimizeIcon"
                              class="wc-btn-icon email-minimize-icon"
                              picking-mode="Ignore"/>
                </ui:Button>

                <ui:Button name="WindowMaximizeButton"
                           tooltip="Maximize"
                           class="button-reset wc-button">
                    <ui:Image name="FullscreenIcon"
                              class="wc-btn-icon email-maximize-icon"
                              picking-mode="Ignore"/>
                    <ui:Image name="ExitFullscreenIcon"
                              class="wc-btn-icon email-restore-icon"
                              picking-mode="Ignore"/>
                </ui:Button>

                <ui:Button name="WindowCloseButton"
                           tooltip="Close"
                           class="button-reset wc-button window-close-button">
                    <ui:Image name="CloseIcon"
                              class="wc-btn-icon email-close-icon"
                              picking-mode="Ignore"/>
                </ui:Button>
            </ui:GroupBox>
        </ui:VisualElement>

        <ui:VisualElement name="WindowContent" class="content">

            <ui:VisualElement name="MailRoot" class="mail">

                <ui:VisualElement class="mail-header">

                    <ui:VisualElement class="mail-brand">
                        <ui:Button name="MenuButton"
                                   tooltip="Expand or collapse navigation"
                                   class="mail-icon-button mail-menu">
                            <ui:Image class="mail-icon icon-menu"
                                      picking-mode="Ignore"/>
                        </ui:Button>

                        <ui:Image class="mail-logo icon-mail"
                                  picking-mode="Ignore"/>

                        <ui:Label text="Mail" class="mail-wordmark"/>
                    </ui:VisualElement>

                    <ui:VisualElement class="mail-search">
                        <ui:Image class="mail-icon icon-search"
                                  picking-mode="Ignore"/>

                        <ui:TextField name="SearchField"
                                      class="mail-search-field"/>

                        <ui:Button name="ClearSearchButton"
                                   tooltip="Clear search"
                                   class="mail-icon-button">
                            <ui:Image class="mail-icon icon-close"
                                      picking-mode="Ignore"/>
                        </ui:Button>
                    </ui:VisualElement>

                    <ui:Button name="AccountButton"
                               tooltip="Mailbox"
                               class="mail-account"/>
                </ui:VisualElement>

                <ui:VisualElement class="mail-body">

                    <ui:VisualElement name="MailSidebar"
                                      class="mail-sidebar">

                        <ui:Button name="ComposeButton"
                                   tooltip="Compose"
                                   class="mail-compose">
                            <ui:Image class="mail-icon icon-compose"
                                      picking-mode="Ignore"/>
                            <ui:Label text="Compose"
                                      class="mail-compose-label"/>
                        </ui:Button>

                        <ui:ScrollView mode="Vertical"
                                       horizontal-scroller-visibility="Hidden"
                                       class="mail-navigation-scroll">
                            <ui:VisualElement name="Navigation"/>
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <ui:VisualElement name="InboxPanel"
                                      class="mail-inbox">

                        <ui:VisualElement name="ListToolbar"
                                          class="mail-toolbar">

                            <ui:Toggle name="SelectAllToggle"
                                       tooltip="Select this page"
                                       class="mail-check"/>

                            <ui:Button name="RefreshButton"
                                       tooltip="Refresh"
                                       class="mail-icon-button">
                                <ui:Image class="mail-icon icon-refresh"
                                          picking-mode="Ignore"/>
                            </ui:Button>

                            <ui:VisualElement class="mail-toolbar-spacer"/>

                            <ui:Label name="MessageRangeLabel"
                                      class="mail-range"/>

                            <ui:Button name="PreviousPageButton"
                                       tooltip="Previous page"
                                       class="mail-icon-button">
                                <ui:Image class="mail-icon icon-previous"
                                          picking-mode="Ignore"/>
                            </ui:Button>

                            <ui:Button name="NextPageButton"
                                       tooltip="Next page"
                                       class="mail-icon-button">
                                <ui:Image class="mail-icon icon-next"
                                          picking-mode="Ignore"/>
                            </ui:Button>
                        </ui:VisualElement>

                        <ui:VisualElement name="MailTabs"
                                          class="mail-tabs"/>

                        <ui:ScrollView name="MessageScroll"
                                       mode="Vertical"
                                       horizontal-scroller-visibility="Hidden"
                                       class="mail-message-scroll">
                            <ui:VisualElement name="MessageList"
                                              class="mail-message-list"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="WindowFooter"
                          class="email-window-footer"/>
    </ui:VisualElement>
</ui:UXML>