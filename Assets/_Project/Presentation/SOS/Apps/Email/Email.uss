/* Window */

.email-window #WindowContent {
    height: auto;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}

.email-header-icon-area {
    width: 40px;
    height: 42px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.email-window #WindowIcon {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.email-window-footer {
    display: none;
}

.email-minimize-icon {
    background-image: resource("Icons/UI/Minimize/remove_32dp_");
}

.email-maximize-icon {
    background-image: resource("Icons/UI/Maximize-Exit/crop_square_32dp");
}

.email-restore-icon {
    background-image: resource("Icons/UI/Maximize/filter_none_32dp");
}

.email-close-icon {
    background-image: resource("Icons/UI/Close/close_32dp");
}

/* Base */

.mail {
    --mail-shell: var(--pd-950);
    --mail-panel: var(--surface-primary);
    --mail-chrome: var(--bg-tertiary);
    --mail-hover: var(--atlas-ui-950);
    --mail-selected: var(--atlas-ui-800);
    --mail-divider: var(--pd-800);

    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;

    background-color: var(--mail-shell);
    color: var(--text-secondary);
    font-size: var(--text-sm);
}

.mail Label {
    margin: 0;
    padding: 0;
}

.mail Button {
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: transparent;
    background-image: none;
    color: var(--text-secondary);
    -unity-font-style: normal;
}

.mail Button:focus {
    border-color: var(--border-focus);
}

.mail Button:disabled {
    opacity: var(--opacity-disabled);
}

.mail .mail-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-muted);
}

.mail .mail-icon-button,
.mail .mail-star {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 5px;
    border-radius: 16px;
    background-color: transparent;
}

.mail .mail-icon-button:hover:enabled,
.mail .mail-star:hover:enabled {
    background-color: var(--mail-hover);
}

.mail .mail-icon-button:active:enabled {
    background-color: var(--mail-selected);
}

/* Header */

.mail-header {
    height: 64px;
    min-height: 64px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 16px 8px 12px;
}

.mail-brand {
    width: 232px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.mail .mail-menu {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    border-radius: 20px;
}

.mail-logo {
    width: 30px;
    height: 26px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--atlas-ui-300);
}

.mail .mail-wordmark {
    font-size: 22px;
    color: var(--text-primary);
}

.mail-search {
    height: 48px;
    max-width: 720px;
    min-width: 80px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 0 16px;
    border-width: 1px;
    border-color: transparent;
    border-radius: 24px;
    background-color: var(--mail-chrome);
}

.mail-search-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 8px;
    --unity-cursor-color: var(--text-primary);
    --unity-selection-color: var(--accent-active);
}

.mail-search-field .unity-text-field__input {
    height: 36px;
    min-width: 0;
    padding: 0 4px;
    border-width: 0;
    background-image: none;
    background-color: transparent;
    color: var(--text-primary);
    font-size: 16px;
    --unity-cursor-color: var(--text-primary);
    --unity-selection-color: var(--atlas-ui-300);
}

.mail-search-field .unity-base-text-field__input--placeholder {
    color: var(--text-muted);
}

.mail-search-field .unity-text-field__input:focus {
    background-color: var(--atlas-ui-50);
    color: var(--text-inverse);

    border-width: 1px;
    border-color: var(--border-focus);
    border-radius: 12px;

    --unity-cursor-color: var(--text-inverse);
    --unity-selection-color: var(--atlas-ui-300);
}

.mail .mail-account {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    margin-left: 16px;
    border-radius: 16px;
    background-color: var(--atlas-ui-800);
    color: var(--atlas-ui-100);
    -unity-text-align: middle-center;
}

/* Layout and navigation */

.mail-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    padding: 0 12px 12px 0;
}

.mail-sidebar {
    width: 244px;
    flex-shrink: 0;
    padding: 6px 8px 0 8px;
}

.mail-navigation-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mail .mail-compose {
    height: 56px;
    width: 100%;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    margin-bottom: 16px;
    border-radius: 16px;
    background-color: var(--atlas-ui-200);
    color: var(--text-inverse);
}

.mail .mail-compose-label {
    margin-left: 16px;
    color: var(--text-inverse);
}

.mail .mail-compose > .mail-icon {
    -unity-background-image-tint-color: var(--text-inverse);
}

.mail .mail-compose:hover {
    background-color: var(--atlas-ui-100);
}

.mail .mail-nav {
    position: relative;
    height: 34px;
    min-height: 34px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    border-radius: 17px;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.mail .mail-nav:hover {
    background-color: var(--mail-hover);
}

.mail .mail-nav--active {
    background-color: var(--atlas-ui-900);
}

.mail .mail-nav-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 16px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mail .mail-count {
    flex-shrink: 0;
    margin-left: 8px;
    font-size: 12px;
}

.mail-nav--active .mail-nav-label {
    -unity-font-style: bold;
    color: var(--text-primary);
}

.mail-nav-dot {
    display: none;
    position: absolute;
    right: 8px;
    top: 5px;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: var(--error-text-light);
}

.mail-labels-heading {
    height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    margin-top: 12px;
}

.mail .mail-labels-title {
    flex-grow: 1;
    color: var(--text-primary);
    font-size: 16px;
}

.mail-more-folders {
    display: none;
}

.mail--more-open .mail-more-folders {
    display: flex;
}

/* Collapsed icon rail */

.mail--rail .mail-sidebar {
    width: 72px;
}

.mail--rail .mail-nav {
    padding: 0;
    align-items: center;
    justify-content: center;
}

.mail--rail .mail-nav-label,
.mail--rail .mail-count,
.mail--rail .mail-compose-label,
.mail--rail .mail-labels-title {
    display: none;
}

.mail--rail .mail-compose {
    padding: 0;
    justify-content: center;
}

.mail--rail .mail-labels-heading {
    padding: 0;
    justify-content: center;
}

.mail--rail .mail-nav.has-unread .mail-nav-dot {
    display: flex;
}

/* Inbox */

.mail-inbox {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 16px;
    background-color: var(--mail-panel);
}

.mail-toolbar,
.mail-reader-toolbar {
    height: 48px;
    min-height: 48px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    background-color: var(--mail-chrome);
}

.mail-toolbar-spacer {
    flex-grow: 1;
    min-width: 0;
}

.mail .mail-range {
    margin-right: 8px;
    color: var(--text-muted);
    font-size: 12px;
}

.mail-check {
    width: 18px;
    min-width: 18px;
    flex-shrink: 0;
    align-self: center;
    margin: 0 4px 0 0;
    padding: 0;
}

.mail-check .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    border-width: 1px;
    border-color: var(--text-disabled);
    border-radius: 2px;
    background-color: transparent;
    -unity-background-image-tint-color: var(--text-primary);
}

.mail-check:checked .unity-toggle__checkmark {
    background-color: var(--accent-active);
    border-color: var(--accent-hover);
}

.mail-tabs {
    height: 56px;
    min-height: 56px;
    flex-shrink: 0;
    flex-direction: row;
    background-color: var(--mail-chrome);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.mail .mail-tab {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    max-width: 250px;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    background-color: transparent;
    border-radius: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
}

.mail .mail-tab > .mail-icon {
    margin-right: 16px;
}

.mail .mail-tab:hover {
    background-color: var(--mail-hover);
}

.mail .mail-tab--active {
    border-bottom-color: var(--atlas-ui-300);
    color: var(--text-primary);
}

.mail .mail-tab--active > .mail-icon {
    -unity-background-image-tint-color: var(--atlas-ui-300);
}

.mail-message-scroll,
.mail-reader-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.mail-message-list {
    min-width: 0;
}

.mail-row {
    min-height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    padding-left: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--mail-divider);
    background-color: var(--mail-panel);
}

.mail-row > .mail-check {
    align-self: flex-start;
    margin-top: 12px;
}

.mail-row > .mail-star {
    margin-top: 4px;
}

.mail-row--unread {
    background-color: var(--surface-hover);
}

.mail-row:hover {
    background-color: var(--mail-hover);
}

.mail-row--selected,
.mail-row--selected:hover {
    background-color: var(--mail-selected);
}

.mail-row-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mail .mail-message {
    height: 40px;
    flex-shrink: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px 0 6px;
    border-radius: 0;
    background-color: transparent;
}

.mail .mail-sender {
    width: 180px;
    flex-shrink: 0;
    padding-right: 16px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mail-summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    overflow: hidden;
}

.mail-subject,
.mail-preview {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mail .mail-preview {
    color: var(--text-muted);
}

.mail .mail-time {
    width: 72px;
    flex-shrink: 0;
    margin-left: 12px;
    color: var(--text-muted);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.mail-row--unread .mail-sender,
.mail-row--unread .mail-subject,
.mail-row--unread .mail-time {
    color: var(--text-primary);
    -unity-font-style: bold;
}

.mail-list-attachments {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 6px;
    padding-right: 12px;
}

.mail .mail-empty {
    padding: 32px 24px;
    color: var(--text-muted);
}

/* Stars */

.mail .mail-star .mail-icon {
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: var(--text-disabled);
}

.mail .mail-star--active .mail-icon {
    -unity-background-image-tint-color: var(--warning-text-light);
}

/* Filled sprite is supplied through EmailController's Inspector. */
.mail .mail-star--active .icon-star-filled {
    -unity-background-image-tint-color: var(--warning-text-light);
}

/* Reader */

.mail-reader {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.mail-reader-scroll {
    padding: 20px 24px 24px 24px;
    background-color: var(--mail-panel);
}

.mail .mail-reader-subject {
    margin-left: 56px;
    margin-bottom: 20px;
    font-size: 22px;
    color: var(--text-primary);
    white-space: normal;
}

.mail-thread-card {
    flex-shrink: 0;
    min-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--mail-divider);
}

.mail-thread-header {
    min-height: 64px;
    flex-direction: row;
    align-items: center;
}

.mail-avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: 16px;
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--atlas-ui-800);
}

.mail .mail-thread-summary {
    min-height: 64px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 8px;
    border-radius: 8px;
    background-color: transparent;
}

.mail .mail-thread-summary:hover {
    background-color: var(--atlas-ui-900);
}

.mail-thread-identity {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mail .mail-thread-sender {
    color: var(--text-primary);
    -unity-font-style: bold;
}

.mail .mail-thread-address,
.mail .mail-thread-preview,
.mail .mail-thread-date {
    color: var(--text-muted);
    font-size: 12px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mail .mail-thread-date {
    flex-shrink: 0;
    margin-left: 12px;
}

.mail-thread-details {
    min-width: 0;
    padding: 4px 8px 24px 56px;
}

.mail .mail-reader-meta {
    margin-bottom: 6px;
    color: var(--text-muted);
    font-size: 12px;
    white-space: normal;
}

.mail .mail-reader-body {
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 14px;
    white-space: normal;
}

.mail-message-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 24px;
}

/* Attachments */

.mail-attachments {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 20px;
}

.mail .mail-attachment {
    height: 36px;
    max-width: 100%;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 18px;
    background-color: var(--mail-panel);
    color: var(--text-secondary);
}

.mail .mail-attachment:hover:enabled {
    background-color: var(--atlas-ui-900);
    border-color: var(--accent-hover);
}

.mail-file-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: 8px;
}

.mail .mail-attachment-name {
    flex-shrink: 1;
    min-width: 0;
    color: var(--text-secondary);
    font-size: 13px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mail .mail-attachment-size {
    flex-shrink: 0;
    margin-left: 8px;
    color: var(--text-muted);
    font-size: 12px;
}

/* Buttons and menus */

.mail .mail-pill-button,
.mail .mail-primary-button {
    min-height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    margin-right: 8px;
    margin-bottom: 4px;
    border-radius: 18px;
    background-color: transparent;
    border-color: var(--border-secondary);
}

.mail .mail-pill-button > .mail-icon {
    margin-right: 8px;
}

.mail .mail-pill-button:hover {
    background-color: var(--atlas-ui-900);
}

.mail .mail-primary-button {
    background-color: var(--atlas-ui-200);
    color: var(--text-inverse);
    border-color: transparent;
}

.mail .mail-primary-button .mail-button-text {
    color: var(--text-inverse);
}

.mail .mail-primary-button > .mail-icon {
    margin-right: 8px;
    -unity-background-image-tint-color: var(--text-inverse);
}

.mail .mail-primary-button:hover {
    background-color: var(--atlas-ui-100);
}

.mail .mail-actions-menu {
    position: absolute;
    padding: 6px 4px;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 8px;
    background-color: var(--mail-chrome);
}

.mail .mail-actions-item {
    height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    border-radius: 4px;
    background-color: transparent;
}

.mail .mail-actions-item > .mail-icon {
    margin-right: 12px;
}

.mail .mail-actions-item:hover:enabled {
    background-color: var(--atlas-ui-900);
}

/* Dialogs */

.mail-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-overlay);
}

.mail-dialog {
    width: 440px;
    max-width: 92%;
    max-height: 92%;
    padding: 20px;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 16px;
    background-color: var(--mail-panel);
}

.mail-composer {
    width: 600px;
    height: 480px;
}

.mail-dialog-header {
    min-height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.mail .mail-dialog-title {
    flex-grow: 1;
    color: var(--text-primary);
    font-size: 20px;
}

.mail-dialog-footer {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.mail-field {
    min-height: 40px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.mail-field > .unity-base-field__label {
    width: 64px;
    min-width: 64px;
    color: var(--text-muted);
}

.mail-field .unity-text-field__input,
.mail-compose-body .unity-text-field__input {
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 6px;
    padding: 8px;
    background-color: var(--mail-shell);
    color: var(--text-primary);
    --unity-cursor-color: var(--text-primary);
    --unity-selection-color: var(--accent-primary);
}

.mail-field .unity-text-field__input:focus,
.mail-compose-body .unity-text-field__input:focus {
    border-color: var(--border-focus);
}

.mail-compose-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
}

.mail .mail-choice {
    min-height: 40px;
    flex-shrink: 0;
    padding: 8px 12px;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.mail .mail-choice:hover {
    background-color: var(--atlas-ui-900);
}

.mail-label-toggle {
    min-height: 36px;
    padding: 6px;
}

.mail .mail-error {
    margin-bottom: 12px;
    padding: 10px;
    border-radius: 6px;
    background-color: var(--error-bg-subtle);
    color: var(--error-text-light);
    white-space: normal;
}

.mail .mail-toast {
    position: absolute;
    left: 24px;
    bottom: 24px;
    max-width: 80%;
    padding: 12px 18px;
    border-radius: 8px;
    background-color: var(--atlas-ui-900);
    color: var(--text-primary);
    white-space: normal;
}

/* Scrollbars */

.mail .unity-scroller,
.mail .unity-base-slider__tracker {
    background-color: transparent;
}

.mail .unity-scroller--vertical {
    width: 8px;
}

.mail .unity-scroller .unity-base-slider__dragger {
    background-image: none;
    background-color: var(--border-secondary);
    border-color: transparent;
    border-radius: 4px;
}

.mail .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--text-muted);
}

.mail .unity-scroller__low-button,
.mail .unity-scroller__high-button {
    display: none;
}

/* Compact windows */

.mail--compact .mail-sidebar {
    width: 196px;
}

/* Keep the collapsed rail narrow in compact windows. */
.mail--compact.mail--rail .mail-sidebar {
    width: 72px;
}

.mail--compact .mail-brand {
    width: 184px;
}

.mail--compact .mail-sender {
    width: 120px;
}

.mail--compact .mail-preview {
    display: none;
}

.mail--compact .mail-tab {
    padding: 0 10px;
}

.mail--compact .mail-tab > .mail-icon {
    margin-right: 8px;
}

.mail--compact .mail-reader-scroll {
    padding: 16px 12px;
}

.mail--compact .mail-thread-date {
    margin-left: 6px;
    font-size: 11px;
}

/* Image resources */

.mail .icon-menu {
    background-image: resource("Icons/Apps/Notepad/Align Justify/format_align_justify_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-mail,
.mail .icon-unread {
    background-image: resource("Icons/Apps/Contacts/Email/mail_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-search {
    background-image: resource("Icons/UI/Search/search_32dp");
}

.mail .icon-close {
    background-image: resource("Icons/UI/Close/close_32dp");
}

.mail .icon-compose {
    background-image: resource("Icons/Apps/Whiteboard/stylus_note_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-star {
    background-image: resource("Icons/Apps/Browser/Star/star_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-sent,
.mail .icon-forward {
    background-image: resource("Icons/Arrows 1/Arrow-Foward/arrow_forward_32dp");
}

.mail .icon-reply {
    background-image: resource("Icons/Arrows 1/Undo/undo_32dp");
}

.mail .icon-draft,
.mail .icon-label,
.mail .icon-labels {
    background-image: resource("Icons/Files/Storage-Types/Documents/description_32dp");
}

.mail .icon-expand {
    background-image: resource("Icons/Arrows 1/Expand-Arrow/keyboard_arrow_down_32dp");
}

.mail--more-open #MoreFoldersButton .icon-expand {
    background-image: resource("Icons/Arrows 1/Collapse-Arrow/keyboard_control_key_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-add {
    background-image: resource("Icons/Math/Add/add_2_32dp");
}

.mail .icon-refresh {
    background-image: resource("Icons/System/Power/Restart/refresh_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-more {
    background-image: resource("Icons/Apps/Browser/More Vert/more_vert_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-previous {
    background-image: resource("Icons/Arrows 1/Less/arrow_back_ios_new_32dp");
}

.mail .icon-next {
    background-image: resource("Icons/Arrows 1/More/arrow_forward_ios_32dp");
}

.mail .icon-social {
    background-image: resource("Icons/Apps/Contacts/Friends/group_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-delete {
    background-image: resource("Icons/Apps/Photos/Delete/delete_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.mail .icon-spam {
    background-image: resource("Icons/System/Status/Warning/warning_32dp");
}

.mail .icon-archive {
    background-image: resource("Icons/Files/Storage-Types/Downloads/download_32dp");
}

.mail .icon-move {
    background-image: resource("Icons/Arrows 1/Arrow-Foward/arrow_forward_32dp");
}