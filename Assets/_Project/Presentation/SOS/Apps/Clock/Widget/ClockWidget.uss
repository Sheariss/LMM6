.clock-widget {
    width: 340px;
    padding: 16px 20px 14px;

    background-color: rgb(32, 32, 32);
    color: rgb(245, 245, 245);

    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 12px;

    flex-shrink: 0;
}

.clock-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.widget-title {
    margin: 0;
    padding: 0;

    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(243, 243, 243);
}

.options-button {
    width: 30px;
    height: 28px;
    margin: 0;
    padding: 0;

    background-color: rgba(0, 0, 0, 0);
    background-image: none;

    border-width: 0;
    border-radius: 5px;

    font-size: 22px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

.options-button:hover {
    background-color: rgb(47, 47, 47);
}

.options-button:active {
    background-color: rgb(57, 57, 57);
}

.clock-content {
    padding-top: 25px;
    padding-bottom: 28px;
    align-items: center;
}

.date-label {
    margin: 0;
    padding: 0;

    font-size: 14px;
    color: rgb(205, 205, 205);
}

.time-row {
    margin-top: 6px;
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
}

.time-label {
    margin: 0;
    padding: 0;

    font-size: 68px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
}

.period-label {
    margin: 0 0 0 8px;
    padding: 0;

    font-size: 17px;
    color: rgb(205, 205, 205);
}

.location-label {
    margin: 3px 0 0;
    padding: 0;

    font-size: 12px;
    color: rgb(155, 155, 155);
}

.divider {
    height: 1px;
    background-color: rgb(57, 57, 57);
}

.clock-footer {
    padding-top: 12px;
    flex-direction: row;
    align-items: center;
}

.status-dot {
    width: 6px;
    height: 6px;
    margin-right: 9px;

    border-radius: 3px;
    background-color: rgb(118, 185, 237);
}

.alarm-label {
    margin: 0;
    padding: 0;
    flex-grow: 1;

    font-size: 12px;
    color: rgb(183, 183, 183);
}

.add-button {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;

    background-color: rgb(45, 45, 45);
    background-image: none;

    border-width: 1px;
    border-color: rgb(66, 66, 66);
    border-radius: 5px;

    font-size: 20px;
    color: rgb(230, 230, 230);
    -unity-text-align: middle-center;
}

.add-button:hover {
    background-color: rgb(57, 57, 57);
    border-color: rgb(82, 82, 82);
}

.add-button:active {
    background-color: rgb(40, 40, 40);
}