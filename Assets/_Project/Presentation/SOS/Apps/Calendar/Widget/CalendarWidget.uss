.calendar-widget {
    width: 360px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(36, 36, 36);
    color: rgb(245, 245, 245);
    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 8px;
    -unity-font-style: normal;
    font-size: 14px;
}

/* Reset Unity's default button styling within this widget. */
.calendar-widget Button {
    margin: 0;
    padding: 0;
    min-width: 0;
    min-height: 0;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    color: rgb(245, 245, 245);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.calendar-widget Button:focus {
    border-color: rgb(180, 180, 180);
}

.calendar-header {
    height: 61px;
    padding-left: 24px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgb(27, 27, 27);
}

.calendar-date {
    margin: 0;
    padding: 0;
    font-size: 14px;
}

.calendar-widget .calendar-icon-button {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    font-size: 20px;
}

.calendar-widget .calendar-icon-button:hover {
    background-color: rgb(55, 55, 55);
}

.calendar-widget .calendar-icon-button:active {
    background-color: rgb(46, 46, 46);
}

.calendar-body {
    padding: 12px 16px 18px 16px;
}

.calendar-month-header {
    height: 42px;
    padding-left: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.calendar-month {
    margin: 0;
    padding: 0;
    font-size: 14px;
}

.calendar-navigation {
    flex-direction: row;
}

.calendar-navigation > Button {
    margin-left: 8px;
}

.calendar-weekdays {
    height: 36px;
    flex-direction: row;
    align-items: center;
}

.calendar-weekday {
    width: 14.2857%;
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: rgb(225, 225, 225);
    -unity-text-align: middle-center;
}

.calendar-week {
    height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
}

.calendar-widget .calendar-day {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 20px;
    font-size: 13px;
}

.calendar-widget .calendar-day:hover {
    background-color: rgb(58, 58, 58);
}

.calendar-widget .calendar-day:active {
    background-color: rgb(70, 70, 70);
}

.calendar-widget .calendar-day-outside {
    color: rgb(145, 145, 145);
}

.calendar-widget .calendar-day-today {
    background-color: rgb(96, 205, 255);
    color: rgb(0, 42, 60);
}

.calendar-widget .calendar-day-today:hover {
    background-color: rgb(123, 215, 255);
}

.calendar-widget .calendar-day-today:active {
    background-color: rgb(80, 180, 225);
}

/* Apply this class from C# when selecting another day. */
.calendar-widget .calendar-day-selected {
    border-width: 2px;
    border-color: rgb(96, 205, 255);
}

.calendar-focus-footer {
    height: 65px;
    padding-left: 20px;
    padding-right: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(30, 30, 30);
    border-top-width: 1px;
    border-top-color: rgb(26, 26, 26);
}

.calendar-focus-duration {
    flex-direction: row;
    align-items: center;
}

.calendar-widget .calendar-duration-button {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(46, 46, 46);
    font-size: 17px;
}

.calendar-duration-label {
    min-width: 64px;
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.calendar-widget .calendar-focus-button {
    width: 94px;
    height: 32px;
    border-radius: 4px;
    border-color: rgb(68, 68, 68);
    background-color: rgb(49, 49, 49);
    font-size: 13px;
}

.calendar-widget .calendar-focus-button:hover {
    background-color: rgb(62, 62, 62);
}

.calendar-widget .calendar-focus-button:active {
    background-color: rgb(42, 42, 42);
}