<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3#ATLAS"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Window/Window.uss?fileID=7433441132597879392&amp;guid=00c704ca2f7eb4f469f7b2b139bf1194&amp;type=3#Window"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Apps/Calendar/Calendar.uss?fileID=7433441132597879392&amp;guid=dc626dd6685a89243bbcc37c0c3b1a09&amp;type=3#Calendar"/>
    <ui:VisualElement name="WindowRoot" class="window">
        <ui:VisualElement name="WindowHeader" class="flex-row header" style="opacity: 1;">
            <ui:VisualElement name="" class="header-icon-area">
                <ui:Image name="WindowIcon" class="header-icon"/>
            </ui:VisualElement>
            <ui:Label text="Window Name" name="WindowTitle" class="spacing-reset header-title"/>
            <ui:GroupBox name="WindowControls" class="flex-row spacing-reset window-controls">
                <ui:Button text="" name="WindowMinimizeButton" class="button-reset wc-button">
                    <ui:Image name="MinimizeIcon" class="wc-btn-icon minimize-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Minimize/remove_32dp_.png?fileID=21300000&amp;guid=8ba13ee49df28774c813618f06427c37&amp;type=3#remove_32dp_&quot;);"/>
                </ui:Button>
                <ui:Button text="" name="WindowMaximizeButton" class="button-reset wc-button">
                    <ui:Image name="FullscreenIcon" class="wc-btn-icon window-maximize-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Maximize-Exit/crop_square_32dp.png?fileID=21300000&amp;guid=2fe5b0aec98d3e84387083094b2987e4&amp;type=3#crop_square_32dp&quot;);"/>
                    <ui:Image name="ExitFullscreenIcon" class="wc-btn-icon window-maximize-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Maximize/filter_none_32dp.png?fileID=21300000&amp;guid=40a6434316977444baf5ceb2ad0f4953&amp;type=3#filter_none_32dp&quot;);"/>
                </ui:Button>
                <ui:Button text="" name="WindowCloseButton" class="button-reset wc-button window-close-button">
                    <ui:Image name="CloseIcon" class="wc-btn-icon" style="background-image: url(&quot;project://database/Assets/_Project/Resources/Icons/UI/Close/close_32dp.png?fileID=21300000&amp;guid=f388726a89c92bb42abb8d4656bb544d&amp;type=3#close_32dp&quot;);"/>
                </ui:Button>
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:VisualElement name="WindowContent" class="content">
            <ui:VisualElement name="CalendarRoot" class="cal-root">
                <ui:VisualElement class="cal-toolbar">
                    <ui:Button name="ToggleSidebarButton" text="☰" tooltip="Toggle sidebar" class="cal-button cal-icon-button"/>
                    <ui:Label text="31" class="cal-logo"/>
                    <ui:Label text="Calendar" class="cal-brand"/>
                    <ui:Button name="TodayButton" text="Today" class="cal-button cal-outline-button"/>
                    <ui:Button name="PreviousPeriodButton" text="‹" tooltip="Previous period" class="cal-button cal-icon-button"/>
                    <ui:Button name="NextPeriodButton" text="›" tooltip="Next period" class="cal-button cal-icon-button"/>
                    <ui:Label name="PeriodLabel" text="October 2026" class="cal-period"/>
                    <ui:VisualElement class="cal-spacer"/>
                    <ui:TextField name="SearchField" tooltip="Search events" class="cal-search"/>
                    <ui:VisualElement class="cal-view-switcher">
                        <ui:Button name="DayViewButton" text="Day" class="cal-button cal-view-button"/>
                        <ui:Button name="WeekViewButton" text="Week" class="cal-button cal-view-button"/>
                        <ui:Button name="MonthViewButton" text="Month" class="cal-button cal-view-button cal-view-button--selected"/>
                        <ui:Button name="AgendaViewButton" text="Agenda" class="cal-button cal-view-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="cal-body">
                    <ui:VisualElement name="CalendarSidebar" class="cal-sidebar">
                        <ui:Button name="CreateEventButton" text="+  Create event" class="cal-button cal-create-button"/>
                        <ui:Label text="MY CALENDARS" class="cal-section-heading"/>
                        <ui:Toggle name="PersonalCalendarToggle" text="Personal" value="true" class="cal-calendar-toggle cal-personal-toggle"/>
                        <ui:Toggle name="WorkCalendarToggle" text="Work" value="true" class="cal-calendar-toggle cal-work-toggle"/>
                        <ui:Toggle name="RemindersCalendarToggle" text="Reminders" value="true" class="cal-calendar-toggle cal-reminders-toggle"/>
                        <ui:VisualElement class="cal-divider"/>
                        <ui:Label text="UPCOMING" class="cal-section-heading"/>
                        <ui:ScrollView name="UpcomingEventsScroll" mode="Vertical" class="cal-upcoming-scroll">
                            <ui:VisualElement name="UpcomingEventsContainer">
                                <ui:Button name="UpcomingReviewButton" class="cal-button cal-upcoming-card">
                                    <ui:Label text="TODAY · 10:00 AM" class="cal-caption"/>
                                    <ui:Label text="Project review" class="cal-upcoming-title"/>
                                    <ui:Label text="Work · Meeting room" class="cal-caption"/>
                                </ui:Button>
                                <ui:Button name="UpcomingLunchButton" class="cal-button cal-upcoming-card">
                                    <ui:Label text="TODAY · 12:30 PM" class="cal-caption"/>
                                    <ui:Label text="Lunch with Alex" class="cal-upcoming-title"/>
                                    <ui:Label text="Personal · Downtown" class="cal-caption"/>
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:ScrollView>
                        <ui:Label name="TimezoneLabel" text="GMT−04:00" class="cal-timezone"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="cal-main">
                        <ui:VisualElement name="MonthView" class="cal-month-view">
                            <ui:VisualElement class="cal-weekday-header">
                                <ui:Label text="SUN" class="cal-weekday"/>
                                <ui:Label text="MON" class="cal-weekday"/>
                                <ui:Label text="TUE" class="cal-weekday"/>
                                <ui:Label text="WED" class="cal-weekday"/>
                                <ui:Label text="THU" class="cal-weekday"/>
                                <ui:Label text="FRI" class="cal-weekday"/>
                                <ui:Label text="SAT" class="cal-weekday"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="MonthGrid" class="cal-month-grid">
                                <ui:VisualElement class="cal-week-row">
                                    <ui:VisualElement name="Day20260927" class="cal-day cal-day--outside">
                                        <ui:Label text="27" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20260928" class="cal-day cal-day--outside">
                                        <ui:Label text="28" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20260929" class="cal-day cal-day--outside">
                                        <ui:Label text="29" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20260930" class="cal-day cal-day--outside">
                                        <ui:Label text="30" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261001" class="cal-day">
                                        <ui:Label text="1" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261002" class="cal-day">
                                        <ui:Label text="2" class="cal-day-number"/>
                                        <ui:Button text="9:00  Planning" class="cal-button cal-event cal-event--work"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261003" class="cal-day">
                                        <ui:Label text="3" class="cal-day-number"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="cal-week-row">
                                    <ui:VisualElement name="Day20261004" class="cal-day">
                                        <ui:Label text="4" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261005" class="cal-day">
                                        <ui:Label text="5" class="cal-day-number"/>
                                        <ui:Button text="10:00  Team sync" class="cal-button cal-event cal-event--work"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261006" class="cal-day">
                                        <ui:Label text="6" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261007" class="cal-day">
                                        <ui:Label text="7" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261008" class="cal-day">
                                        <ui:Label text="8" class="cal-day-number"/>
                                        <ui:Button text="18:00  Dinner" class="cal-button cal-event cal-event--personal"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261009" class="cal-day">
                                        <ui:Label text="9" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261010" class="cal-day">
                                        <ui:Label text="10" class="cal-day-number"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="cal-week-row">
                                    <ui:VisualElement name="Day20261011" class="cal-day">
                                        <ui:Label text="11" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261012" class="cal-day">
                                        <ui:Label text="12" class="cal-day-number"/>
                                        <ui:Button text="10:00  Team sync" class="cal-button cal-event cal-event--work"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261013" class="cal-day">
                                        <ui:Label text="13" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261014" class="cal-day">
                                        <ui:Label text="14" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261015" class="cal-day cal-day--today">
                                        <ui:Label text="15" class="cal-day-number"/>
                                        <ui:Button name="ReviewEventButton" text="10:00  Project review" class="cal-button cal-event cal-event--work"/>
                                        <ui:Button name="LunchEventButton" text="12:30  Lunch with Alex" class="cal-button cal-event cal-event--personal"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261016" class="cal-day">
                                        <ui:Label text="16" class="cal-day-number"/>
                                        <ui:Button text="Submit report" class="cal-button cal-event cal-event--reminder"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261017" class="cal-day">
                                        <ui:Label text="17" class="cal-day-number"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="cal-week-row">
                                    <ui:VisualElement name="Day20261018" class="cal-day">
                                        <ui:Label text="18" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261019" class="cal-day">
                                        <ui:Label text="19" class="cal-day-number"/>
                                        <ui:Button text="10:00  Team sync" class="cal-button cal-event cal-event--work"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261020" class="cal-day">
                                        <ui:Label text="20" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261021" class="cal-day">
                                        <ui:Label text="21" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261022" class="cal-day">
                                        <ui:Label text="22" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261023" class="cal-day">
                                        <ui:Label text="23" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261024" class="cal-day">
                                        <ui:Label text="24" class="cal-day-number"/>
                                        <ui:Button text="Weekend trip" class="cal-button cal-event cal-event--personal"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="cal-week-row">
                                    <ui:VisualElement name="Day20261025" class="cal-day">
                                        <ui:Label text="25" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261026" class="cal-day">
                                        <ui:Label text="26" class="cal-day-number"/>
                                        <ui:Button text="10:00  Team sync" class="cal-button cal-event cal-event--work"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261027" class="cal-day">
                                        <ui:Label text="27" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261028" class="cal-day">
                                        <ui:Label text="28" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261029" class="cal-day">
                                        <ui:Label text="29" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261030" class="cal-day">
                                        <ui:Label text="30" class="cal-day-number"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement name="Day20261031" class="cal-day">
                                        <ui:Label text="31" class="cal-day-number"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="ScheduleView" class="cal-schedule-view cal-hidden">
                            <ui:VisualElement name="ScheduleHeader" class="cal-schedule-header"/>
                            <ui:VisualElement name="AllDayEvents" class="cal-all-day-events"/>
                            <ui:ScrollView name="ScheduleScroll" mode="Vertical" class="cal-schedule-scroll">
                                <ui:VisualElement name="ScheduleGrid" class="cal-schedule-grid"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                        <ui:ScrollView name="AgendaView" mode="Vertical" class="cal-agenda-view cal-hidden">
                            <ui:Label name="AgendaHeading" text="Upcoming events" class="cal-agenda-heading"/>
                            <ui:VisualElement name="AgendaEventsContainer"/>
                            <ui:Label name="EmptyAgendaLabel" text="No events to show." class="cal-empty-state"/>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="EventEditorOverlay" class="cal-overlay cal-hidden">
                    <ui:VisualElement name="EventEditor" class="cal-editor">
                        <ui:VisualElement class="cal-editor-header">
                            <ui:Label name="EventEditorHeading" text="New event" class="cal-editor-heading"/>
                            <ui:VisualElement class="cal-spacer"/>
                            <ui:Button name="CloseEventEditorButton" text="×" tooltip="Close editor" class="cal-button cal-icon-button"/>
                        </ui:VisualElement>
                        <ui:ScrollView mode="Vertical" class="cal-editor-scroll">
                            <ui:TextField name="EventTitleField" label="Title" class="cal-field cal-title-field"/>
                            <ui:Toggle name="AllDayToggle" text="All-day event" class="cal-all-day-toggle"/>
                            <ui:VisualElement class="cal-form-row">
                                <ui:TextField name="StartDateField" label="Start date" tooltip="YYYY-MM-DD" class="cal-field cal-form-half"/>
                                <ui:TextField name="StartTimeField" label="Start time" tooltip="HH:mm, 24-hour time" class="cal-field cal-form-half"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="cal-form-row">
                                <ui:TextField name="EndDateField" label="End date" tooltip="YYYY-MM-DD" class="cal-field cal-form-half"/>
                                <ui:TextField name="EndTimeField" label="End time" tooltip="HH:mm, 24-hour time" class="cal-field cal-form-half"/>
                            </ui:VisualElement>
                            <ui:DropdownField name="EventCalendarField" label="Calendar" class="cal-field"/>
                            <ui:DropdownField name="RepeatField" label="Repeat" class="cal-field"/>
                            <ui:TextField name="LocationField" label="Location" class="cal-field"/>
                            <ui:TextField name="DescriptionField" label="Description" multiline="true" class="cal-field cal-description-field"/>
                            <ui:Label name="EventValidationLabel" text="" class="cal-validation cal-hidden"/>
                        </ui:ScrollView>
                        <ui:VisualElement class="cal-editor-footer">
                            <ui:Button name="DeleteEventButton" text="Delete" class="cal-button cal-delete-button cal-hidden"/>
                            <ui:VisualElement class="cal-spacer"/>
                            <ui:Button name="CancelEventButton" text="Cancel" class="cal-button cal-outline-button"/>
                            <ui:Button name="SaveEventButton" text="Save event" class="cal-button cal-primary-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WindowFooter" class="footer"/>
    </ui:VisualElement>
</ui:UXML>
