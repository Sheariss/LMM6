/* Root */

.cal-root {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 720px;
    min-height: 460px;
    position: relative;
    overflow: hidden;
    background-color: #ffffff;
    color: #202124;
    font-size: 13px;
}

.cal-root Label {
    margin: 0;
    padding: 0;
}

.cal-spacer {
    flex-grow: 1;
    min-width: 8px;
}

/* Shared buttons */

.cal-button {
    margin: 0;
    padding: 6px 12px;
    border-width: 0;
    border-radius: 5px;
    background-color: transparent;
    background-image: none;
    color: #3c4043;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.cal-button:hover {
    background-color: #f1f3f4;
}

.cal-button:active {
    background-color: #e3e7eb;
}

.cal-button:focus {
    border-width: 1px;
    border-color: #1a73e8;
}

.cal-button:disabled {
    opacity: 0.45;
}

.cal-icon-button {
    width: 34px;
    height: 34px;
    padding: 0;
    flex-shrink: 0;
    border-radius: 17px;
    font-size: 23px;
}

.cal-outline-button {
    height: 34px;
    border-width: 1px;
    border-color: #dadce0;
    padding-left: 16px;
    padding-right: 16px;
}

.cal-primary-button {
    height: 36px;
    padding-left: 20px;
    padding-right: 20px;
    color: #ffffff;
    background-color: #1a73e8;
    -unity-font-style: bold;
}

.cal-primary-button:hover {
    background-color: #1765cc;
}

.cal-primary-button:active {
    background-color: #1456ae;
}

/* Toolbar */

.cal-toolbar {
    height: 72px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    border-bottom-width: 1px;
    border-bottom-color: #dadce0;
}

.cal-logo {
    width: 34px;
    height: 34px;
    margin-left: 12px;
    margin-right: 10px;
    border-radius: 6px;
    background-color: #1a73e8;
    color: #ffffff;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cal-brand {
    margin-right: 26px;
    font-size: 21px;
    color: #5f6368;
}

.cal-toolbar > .cal-outline-button {
    margin-right: 12px;
}

.cal-period {
    margin-left: 12px;
    flex-shrink: 0;
    font-size: 20px;
}

.cal-search {
    width: 150px;
    min-width: 70px;
    flex-shrink: 1;
    margin: 0 12px;
}

.cal-search > .unity-text-field__input {
    min-height: 34px;
    padding: 6px 10px;
    border-width: 1px;
    border-color: #dadce0;
    border-radius: 6px;
    background-color: #f8fafd;
    color: #202124;
}

.cal-search > .unity-text-field__input:focus {
    border-color: #1a73e8;
}

.cal-view-switcher {
    flex-direction: row;
    flex-shrink: 0;
    padding: 3px;
    border-width: 1px;
    border-color: #dadce0;
    border-radius: 7px;
}

.cal-view-button {
    height: 28px;
    padding: 4px 10px;
}

.cal-view-button--selected {
    background-color: #e8f0fe;
    color: #1967d2;
    -unity-font-style: bold;
}

.cal-view-button--selected:hover {
    background-color: #d9e7fd;
}

/* Sidebar */

.cal-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

.cal-sidebar {
    width: 210px;
    flex-shrink: 0;
    padding: 20px 16px 14px 16px;
    border-right-width: 1px;
    border-right-color: #dadce0;
    background-color: #ffffff;
}

.cal-create-button {
    height: 48px;
    margin-bottom: 28px;
    border-radius: 14px;
    background-color: #c2e7ff;
    color: #001d35;
    font-size: 15px;
    -unity-font-style: bold;
}

.cal-create-button:hover {
    background-color: #b1dcf9;
}

.cal-section-heading {
    margin-bottom: 14px;
    color: #5f6368;
    font-size: 10px;
    -unity-font-style: bold;
}

.cal-calendar-toggle {
    min-height: 34px;
    margin: 0;
    padding: 4px 2px;
}

.cal-calendar-toggle .unity-toggle__input {
    flex-grow: 1;
}

.cal-calendar-toggle .unity-toggle__text {
    margin-left: 10px;
    color: #3c4043;
    font-size: 13px;
}

.cal-calendar-toggle .unity-toggle__checkmark {
    width: 17px;
    height: 17px;
    border-width: 2px;
    border-radius: 3px;
    border-color: #9aa0a6;
    background-color: #ffffff;
}

.cal-personal-toggle:checked .unity-toggle__checkmark {
    background-color: #1a73e8;
    border-color: #1a73e8;
    -unity-background-image-tint-color: #ffffff;
}

.cal-work-toggle:checked .unity-toggle__checkmark {
    background-color: #188038;
    border-color: #188038;
    -unity-background-image-tint-color: #ffffff;
}

.cal-reminders-toggle:checked .unity-toggle__checkmark {
    background-color: #b06000;
    border-color: #b06000;
    -unity-background-image-tint-color: #ffffff;
}

.cal-divider {
    height: 1px;
    flex-shrink: 0;
    margin-top: 20px;
    margin-bottom: 20px;
    background-color: #e8eaed;
}

.cal-upcoming-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.cal-upcoming-card {
    min-height: 84px;
    margin-bottom: 10px;
    padding: 12px;
    align-items: flex-start;
    border-radius: 9px;
    background-color: #f8fafd;
}

.cal-upcoming-card:hover {
    background-color: #edf2fa;
}

.cal-caption {
    color: #70757a;
    font-size: 10px;
}

.cal-upcoming-title {
    margin-top: 7px;
    margin-bottom: 7px;
    font-size: 13px;
    -unity-font-style: bold;
}

.cal-timezone {
    margin-top: 16px;
    color: #70757a;
    font-size: 11px;
}

/* Month view */

.cal-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.cal-month-view {
    flex-grow: 1;
    min-height: 0;
}

.cal-weekday-header {
    height: 34px;
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: #dadce0;
}

.cal-weekday {
    width: 0;
    flex-grow: 1;
    padding-top: 10px;
    color: #70757a;
    font-size: 10px;
    -unity-text-align: upper-center;
}

.cal-month-grid {
    flex-grow: 1;
    min-height: 0;
}

.cal-week-row {
    height: 0;
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
}

.cal-day {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    padding: 5px 3px;
    overflow: hidden;
    border-right-width: 1px;
    border-right-color: #dadce0;
    border-bottom-width: 1px;
    border-bottom-color: #dadce0;
    background-color: #ffffff;
}

.cal-day:hover {
    background-color: #f8fafd;
}

.cal-day--outside {
    background-color: #fafafa;
}

.cal-day-number {
    width: 27px;
    height: 27px;
    align-self: center;
    flex-shrink: 0;
    margin-bottom: 5px;
    border-radius: 14px;
    color: #3c4043;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.cal-day--outside > .cal-day-number {
    color: #9aa0a6;
}

.cal-day--today > .cal-day-number {
    background-color: #1a73e8;
    color: #ffffff;
    -unity-font-style: bold;
}

.cal-day--selected {
    background-color: #edf3ff;
}

.cal-day--drop-target {
    background-color: #d2e3fc;
}

/* Event chips */

.cal-event {
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin-bottom: 3px;
    padding: 3px 6px;
    border-radius: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.cal-event--personal {
    background-color: #d2e3fc;
    color: #174ea6;
}

.cal-event--personal:hover {
    background-color: #bdd5fa;
}

.cal-event--work {
    background-color: #ceead6;
    color: #0d652d;
}

.cal-event--work:hover {
    background-color: #b8dfc3;
}

.cal-event--reminder {
    background-color: #feefc3;
    color: #8a4b00;
}

.cal-event--reminder:hover {
    background-color: #fce4a0;
}

.cal-event--dragging {
    opacity: 0.55;
}

.cal-more-events {
    height: 20px;
    padding: 2px 6px;
    color: #5f6368;
    font-size: 10px;
    -unity-text-align: middle-left;
}

/* Day / week view hooks */

.cal-schedule-view {
    flex-grow: 1;
    min-height: 0;
}

.cal-schedule-header {
    min-height: 56px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #dadce0;
}

.cal-schedule-day-heading {
    width: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.cal-all-day-events {
    min-height: 32px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #dadce0;
}

.cal-schedule-scroll {
    flex-grow: 1;
    min-height: 0;
}

.cal-schedule-grid {
    position: relative;
    height: 1440px;
    flex-shrink: 0;
}

/* Controller can use 60px per hour. */
.cal-hour-row {
    height: 60px;
    flex-shrink: 0;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #e8eaed;
}

.cal-hour-label {
    width: 60px;
    flex-shrink: 0;
    padding: 4px 8px;
    color: #70757a;
    font-size: 10px;
}

.cal-time-slot {
    width: 0;
    flex-grow: 1;
    border-left-width: 1px;
    border-left-color: #e8eaed;
}

.cal-time-slot:hover {
    background-color: #f8fafd;
}

.cal-timed-event {
    position: absolute;
    padding: 5px 7px;
    border-radius: 5px;
    overflow: hidden;
    font-size: 11px;
}

.cal-current-time-line {
    position: absolute;
    height: 2px;
    background-color: #ea4335;
}

/* Agenda / search */

.cal-agenda-view {
    flex-grow: 1;
    min-height: 0;
    padding: 24px;
}

.cal-agenda-heading {
    margin-bottom: 22px;
    font-size: 22px;
}

.cal-agenda-row {
    min-height: 68px;
    flex-direction: row;
    align-items: center;
    padding: 12px;
    border-bottom-width: 1px;
    border-bottom-color: #e8eaed;
}

.cal-agenda-date {
    width: 100px;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.cal-agenda-time {
    width: 125px;
    flex-shrink: 0;
    color: #70757a;
}

.cal-agenda-title {
    flex-grow: 1;
    font-size: 14px;
}

.cal-empty-state {
    margin-top: 30px;
    color: #70757a;
    -unity-text-align: middle-center;
}

/* Event editor */

.cal-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(32, 33, 36, 0.32);
}

.cal-editor {
    width: 460px;
    max-width: 92%;
    max-height: 92%;
    padding: 20px;
    border-width: 1px;
    border-color: #dadce0;
    border-radius: 14px;
    background-color: #ffffff;
}

.cal-editor-header {
    min-height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.cal-editor-heading {
    font-size: 21px;
}

.cal-editor-scroll {
    flex-shrink: 1;
    min-height: 0;
}

.cal-field {
    margin: 0 0 14px 0;
    flex-direction: column;
}

.cal-field > .unity-base-field__label {
    min-width: 0;
    margin: 0 0 6px 0;
    padding: 0;
    color: #5f6368;
    font-size: 11px;
}

.cal-field > .unity-base-field__input {
    min-height: 36px;
    margin: 0;
    padding: 7px 10px;
    border-width: 1px;
    border-color: #dadce0;
    border-radius: 6px;
    background-color: #f8fafd;
    color: #202124;
}

.cal-field > .unity-base-field__input:focus {
    border-color: #1a73e8;
}

.cal-title-field > .unity-base-field__input {
    font-size: 18px;
}

.cal-all-day-toggle {
    margin: 0 0 16px 0;
}

.cal-form-row {
    flex-direction: row;
}

.cal-form-half {
    width: 0;
    flex-grow: 1;
}

.cal-form-half:first-child {
    margin-right: 12px;
}

.cal-description-field > .unity-base-field__input {
    min-height: 90px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.cal-validation {
    margin-bottom: 12px;
    color: #b3261e;
    white-space: normal;
    font-size: 12px;
}

.cal-editor-footer {
    min-height: 48px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: #e8eaed;
}

.cal-editor-footer > .cal-primary-button {
    margin-left: 10px;
}

.cal-delete-button {
    color: #b3261e;
}

.cal-delete-button:hover {
    background-color: #fce8e6;
}

/* Keep last so it overrides view display rules. */

.cal-hidden {
    display: none;
}

/* Dark theme */

.cal-root {
    background-color: #202124;
    color: #e8eaed;
}

.cal-toolbar {
    background-color: #202124;
    border-bottom-color: #3c4043;
}

.cal-brand,
.cal-period {
    color: #e8eaed;
}

.cal-logo {
    background-color: #8ab4f8;
    color: #202124;
}

/* Buttons */

.cal-button {
    color: #e8eaed;
}

.cal-button:hover {
    background-color: #35363a;
}

.cal-button:active {
    background-color: #45464b;
}

.cal-button:focus {
    border-color: #8ab4f8;
}

.cal-outline-button {
    border-color: #5f6368;
}

.cal-primary-button {
    background-color: #8ab4f8;
    color: #202124;
}

.cal-primary-button:hover {
    background-color: #a6c8ff;
}

.cal-primary-button:active {
    background-color: #78a5ed;
}

.cal-view-switcher {
    border-color: #5f6368;
}

.cal-view-button--selected {
    background-color: #394457;
    color: #aecbfa;
}

.cal-view-button--selected:hover {
    background-color: #45536b;
}

/* Search */

.cal-search > .unity-text-field__input {
    background-color: #303134;
    border-color: #5f6368;
    color: #e8eaed;
}

.cal-search > .unity-text-field__input:focus {
    border-color: #8ab4f8;
}

/* Sidebar */

.cal-sidebar {
    background-color: #202124;
    border-right-color: #3c4043;
}

.cal-create-button {
    background-color: #394a63;
    color: #d3e3fd;
}

.cal-create-button:hover {
    background-color: #465b79;
}

.cal-section-heading,
.cal-caption,
.cal-timezone {
    color: #9aa0a6;
}

.cal-calendar-toggle .unity-toggle__text {
    color: #e8eaed;
}

.cal-calendar-toggle .unity-toggle__checkmark {
    background-color: #202124;
    border-color: #9aa0a6;
}

.cal-personal-toggle:checked .unity-toggle__checkmark {
    background-color: #8ab4f8;
    border-color: #8ab4f8;
    -unity-background-image-tint-color: #202124;
}

.cal-work-toggle:checked .unity-toggle__checkmark {
    background-color: #81c995;
    border-color: #81c995;
    -unity-background-image-tint-color: #202124;
}

.cal-reminders-toggle:checked .unity-toggle__checkmark {
    background-color: #fdd663;
    border-color: #fdd663;
    -unity-background-image-tint-color: #202124;
}

.cal-divider {
    background-color: #3c4043;
}

.cal-upcoming-card {
    background-color: #292a2d;
}

.cal-upcoming-card:hover {
    background-color: #35363a;
}

.cal-upcoming-title {
    color: #e8eaed;
}

/* Month grid */

.cal-weekday-header {
    border-bottom-color: #3c4043;
}

.cal-weekday {
    color: #9aa0a6;
}

.cal-day {
    background-color: #202124;
    border-right-color: #3c4043;
    border-bottom-color: #3c4043;
}

.cal-day:hover {
    background-color: #292a2d;
}

.cal-day--outside {
    background-color: #1c1d20;
}

.cal-day--outside:hover {
    background-color: #252629;
}

.cal-day-number {
    color: #e8eaed;
}

.cal-day--outside > .cal-day-number {
    color: #80868b;
}

.cal-day--today > .cal-day-number {
    background-color: #8ab4f8;
    color: #202124;
}

.cal-day--selected,
.cal-day--selected:hover {
    background-color: #2d3b50;
}

.cal-day--drop-target,
.cal-day--drop-target:hover {
    background-color: #394a63;
}

/* Events */

.cal-event--personal {
    background-color: #394a63;
    color: #d3e3fd;
}

.cal-event--personal:hover {
    background-color: #465b79;
}

.cal-event--work {
    background-color: #254b36;
    color: #b7e1c2;
}

.cal-event--work:hover {
    background-color: #306044;
}

.cal-event--reminder {
    background-color: #57471f;
    color: #fde293;
}

.cal-event--reminder:hover {
    background-color: #6b5827;
}

.cal-more-events {
    color: #bdc1c6;
}

/* Day, week and agenda */

.cal-schedule-header,
.cal-all-day-events,
.cal-agenda-row {
    border-bottom-color: #3c4043;
}

.cal-hour-row {
    border-bottom-color: #35363a;
}

.cal-time-slot {
    border-left-color: #3c4043;
}

.cal-time-slot:hover {
    background-color: #292a2d;
}

.cal-hour-label,
.cal-agenda-time,
.cal-empty-state {
    color: #9aa0a6;
}

.cal-current-time-line {
    background-color: #f28b82;
}

/* Event editor */

.cal-overlay {
    background-color: rgba(0, 0, 0, 0.62);
}

.cal-editor {
    background-color: #292a2d;
    border-color: #5f6368;
}

.cal-editor-heading {
    color: #e8eaed;
}

.cal-field > .unity-base-field__label {
    color: #bdc1c6;
}

.cal-field > .unity-base-field__input {
    background-color: #202124;
    border-color: #5f6368;
    color: #e8eaed;
}

.cal-field > .unity-base-field__input:focus {
    border-color: #8ab4f8;
}

.cal-field .unity-base-popup-field__text {
    color: #e8eaed;
}

.cal-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #bdc1c6;
}

.cal-all-day-toggle .unity-toggle__text {
    color: #e8eaed;
}

.cal-all-day-toggle .unity-toggle__checkmark {
    background-color: #202124;
    border-color: #9aa0a6;
}

.cal-all-day-toggle:checked .unity-toggle__checkmark {
    background-color: #8ab4f8;
    border-color: #8ab4f8;
    -unity-background-image-tint-color: #202124;
}

.cal-editor-footer {
    border-top-color: #3c4043;
}

.cal-validation,
.cal-delete-button {
    color: #f28b82;
}

.cal-delete-button:hover {
    background-color: #503331;
}

/* Scrollbars */

.cal-root .unity-scroller--vertical {
    width: 10px;
}

.cal-root .unity-scroller--horizontal {
    height: 10px;
}

.cal-root .unity-scroller .unity-slider__tracker {
    background-color: #292a2d;
    border-width: 0;
}

.cal-root .unity-scroller .unity-slider__dragger {
    background-color: #5f6368;
    border-width: 0;
    border-radius: 5px;
}

.cal-root .unity-scroller .unity-slider__dragger:hover {
    background-color: #80868b;
}

.cal-root .unity-scroller .unity-repeat-button {
    background-color: #292a2d;
    border-width: 0;
    -unity-background-image-tint-color: #9aa0a6;
}