/* Panel */

.wifi-panel {
    position: absolute;
    right: 12px;
    bottom: 64px;

    width: 360px;
    max-width: 100%;
    height: 480px;

    flex-direction: column;
    overflow: hidden;

    background-color: rgb(39, 39, 39);

    border-width: 1px;
    border-color: rgb(66, 66, 66);
    border-radius: 8px;

    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: normal;
}

/* Shared button reset */

.wifi-panel .wifi-button {
    margin: 0;
    padding: 0;

    border-width: 1px;
    border-color: transparent;
    border-radius: 4px;

    background-color: transparent;
    background-image: none;

    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;

    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.wifi-panel .wifi-button:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.wifi-panel .wifi-button:active {
    background-color: rgba(255, 255, 255, 0.04);
}

.wifi-panel .wifi-button:focus {
    border-color: rgb(255, 255, 255);
}

/* Header */

.wifi-header {
    height: 64px;
    min-height: 64px;

    flex-direction: row;
    align-items: center;

    padding-left: 12px;
    padding-right: 20px;

    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.wifi-panel .wifi-back {
    width: 32px;
    height: 32px;

    align-items: center;
    justify-content: center;

    margin-right: 8px;
}

.wifi-title {
    flex-grow: 1;

    margin: 0;
    padding: 0;

    font-size: 16px;
    -unity-font-style: bold;
}

/* Existing project icons */

.wifi-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;

    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;

    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.wifi-back-icon {
    width: 18px;
    height: 18px;

    background-image:
        resource("Icons/Arrows 1/Arrow-Back/arrow_back_32dp");
}

.wifi-signal {
    width: 24px;
    height: 24px;
    margin-right: 16px;
}

.wifi-signal-secured {
    background-image:
        resource("Icons/System/Network/Wifi-Locked/wifi_lock_32dp");
}

.wifi-signal-full {
    background-image:
        resource("Icons/System/Network/Wifi-3-Bar/wifi_32dp");
}

.wifi-signal-weak {
    background-image:
        resource("Icons/System/Network/Wifi-1-Bar/wifi_1_bar_32dp");
}

/* Wi-Fi switch: styles the native Toggle */

.wifi-switch {
    width: 40px;
    height: 22px;

    flex-grow: 0;
    flex-shrink: 0;

    margin: 0;
    padding: 0;
}

.wifi-switch > .unity-toggle__label {
    display: none;
}

.wifi-switch > .unity-toggle__input {
    width: 40px;
    min-width: 40px;
    height: 22px;

    flex-grow: 0;
    flex-shrink: 0;
    align-items: flex-start;
    justify-content: center;

    margin: 0;
    padding: 3px;

    background-color: rgb(39, 39, 39);
    background-image: none;

    border-width: 1px;
    border-color: rgb(162, 162, 162);
    border-radius: 11px;
}

.wifi-switch > .unity-toggle__input:checked {
    background-color: rgb(96, 205, 255);
    border-color: rgb(96, 205, 255);
}

.wifi-switch:hover > .unity-toggle__input:checked {
    background-color: rgb(119, 213, 255);
    border-color: rgb(119, 213, 255);
}

.wifi-switch .unity-toggle__checkmark {
    width: 12px;
    height: 12px;

    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;

    margin: 0;
    padding: 0;

    background-image: none;
    background-color: rgb(220, 220, 220);

    border-width: 0;
    border-radius: 6px;
}

.wifi-switch > .unity-toggle__input:checked .unity-toggle__checkmark {
    align-self: flex-end;
    background-color: rgb(0, 54, 76);
}

.wifi-switch:focus > .unity-toggle__input {
    border-color: rgb(255, 255, 255);
}

/* Network list */

.wifi-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;

    margin: 0;
    padding: 0;
}

.wifi-list .unity-scroll-view__content-container {
    padding: 4px;
}

/* Connected network */

.wifi-connected {
    flex-shrink: 0;

    margin-bottom: 4px;
    padding: 16px 16px 12px;

    background-color: rgba(255, 255, 255, 0.045);
    border-radius: 4px;
}

.wifi-network-heading {
    flex-direction: row;
    align-items: center;
}

.wifi-network-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;

    flex-direction: column;
}

.wifi-network-name {
    margin: 0;
    padding: 0;

    color: rgb(255, 255, 255);
    font-size: 14px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wifi-network-status {
    margin: 3px 0 0;
    padding: 0;

    color: rgb(190, 190, 190);
    font-size: 12px;
}

.wifi-connected-actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    margin-top: 16px;
    margin-left: 40px;
}

.wifi-panel .wifi-link {
    height: 30px;
    padding: 0 4px;

    color: rgb(153, 235, 255);
    font-size: 12px;
}

.wifi-panel .wifi-disconnect {
    width: 124px;
    height: 32px;

    background-color: rgb(58, 58, 58);

    border-color: rgb(80, 80, 80);
    border-bottom-color: rgb(48, 48, 48);

    -unity-text-align: middle-center;
}

.wifi-panel .wifi-disconnect:hover {
    background-color: rgb(66, 66, 66);
}

.wifi-panel .wifi-disconnect:active {
    background-color: rgb(52, 52, 52);
}

/* Available network rows */

.wifi-panel .wifi-network {
    min-height: 64px;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    margin-bottom: 2px;
    padding: 10px 16px;
}

/* Footer */

.wifi-footer {
    height: 58px;
    min-height: 58px;

    justify-content: center;
    align-items: flex-start;

    padding-left: 16px;
    padding-right: 16px;

    background-color: rgb(32, 32, 32);

    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.wifi-panel .wifi-settings-link {
    height: 32px;
    padding: 0 4px;

    color: rgb(153, 235, 255);
    font-size: 12px;
}