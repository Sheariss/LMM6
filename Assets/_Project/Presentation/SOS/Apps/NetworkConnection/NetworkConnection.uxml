<ui:UXML xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">

    <Style src="NetworkConnection.uss" />

    <ui:VisualElement name="WiFiPanel" class="wifi-panel">

        <!-- Header -->
        <ui:VisualElement class="wifi-header">
            <ui:Button name="BackButton"
                       tooltip="Back to quick settings"
                       class="wifi-button wifi-back">
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-icon wifi-back-icon" />
            </ui:Button>

            <ui:Label text="Wi-Fi" class="wifi-title" />

            <ui:Toggle name="WiFiToggle"
                       value="true"
                       tooltip="Turn Wi-Fi on or off"
                       class="wifi-switch" />
        </ui:VisualElement>

        <!-- Available networks -->
        <ui:ScrollView name="NetworkList"
                       mode="Vertical"
                       horizontal-scroller-visibility="Hidden"
                       vertical-scroller-visibility="Auto"
                       class="wifi-list">

            <!-- Connected network -->
            <ui:VisualElement name="ConnectedNetwork"
                              class="wifi-connected">

                <ui:VisualElement class="wifi-network-heading">
                    <ui:VisualElement picking-mode="Ignore"
                                      class="wifi-icon wifi-signal wifi-signal-secured" />

                    <ui:VisualElement class="wifi-network-copy">
                        <ui:Label text="Home Network"
                                  class="wifi-network-name" />
                        <ui:Label text="Connected, secured"
                                  class="wifi-network-status" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="wifi-connected-actions">
                    <ui:Button name="NetworkPropertiesButton"
                               text="Properties"
                               class="wifi-button wifi-link" />

                    <ui:Button name="DisconnectButton"
                               text="Disconnect"
                               class="wifi-button wifi-disconnect" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="OfficeNetworkButton"
                       class="wifi-button wifi-network">
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-icon wifi-signal wifi-signal-secured" />
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-network-copy">
                    <ui:Label text="Office Network"
                              class="wifi-network-name" />
                    <ui:Label text="Secured"
                              class="wifi-network-status" />
                </ui:VisualElement>
            </ui:Button>

            <ui:Button name="GuestNetworkButton"
                       class="wifi-button wifi-network">
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-icon wifi-signal wifi-signal-full" />
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-network-copy">
                    <ui:Label text="Guest Wi-Fi"
                              class="wifi-network-name" />
                    <ui:Label text="Open"
                              class="wifi-network-status" />
                </ui:VisualElement>
            </ui:Button>

            <ui:Button name="StudioNetworkButton"
                       class="wifi-button wifi-network">
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-icon wifi-signal wifi-signal-secured" />
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-network-copy">
                    <ui:Label text="Studio_5G"
                              class="wifi-network-name" />
                    <ui:Label text="Secured"
                              class="wifi-network-status" />
                </ui:VisualElement>
            </ui:Button>

            <ui:Button name="HiddenNetworkButton"
                       class="wifi-button wifi-network">
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-icon wifi-signal wifi-signal-weak" />
                <ui:VisualElement picking-mode="Ignore"
                                  class="wifi-network-copy">
                    <ui:Label text="Hidden Network"
                              class="wifi-network-name" />
                    <ui:Label text="Secured"
                              class="wifi-network-status" />
                </ui:VisualElement>
            </ui:Button>

        </ui:ScrollView>

        <!-- Footer -->
        <ui:VisualElement class="wifi-footer">
            <ui:Button name="NetworkSettingsButton"
                       text="More Wi-Fi settings"
                       class="wifi-button wifi-settings-link" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>