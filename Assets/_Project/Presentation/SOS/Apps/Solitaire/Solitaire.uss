/* Designed for a desktop panel of at least 900 × 720.
   Use Panel Settings > Scale With Screen Size. */

.app {
    flex-grow: 1;
    align-items: center;
    justify-content: center;

    padding: 28px;

    background-color: #111315;
    color: #e3e3e3;
}

.header {
    width: 100%;
    max-width: 1040px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 24px;
}

.brand {
    flex-direction: row;
    align-items: center;
}

.brand-icon {
    width: 48px;
    height: 48px;

    margin-right: 14px;

    border-radius: 16px;
    background-color: #283b31;
    color: #a8dab5;

    font-size: 30px;
    -unity-text-align: middle-center;
}

.title {
    margin: 0;

    font-size: 26px;
    -unity-font-style: bold;
    color: #f1f3f4;
}

.subtitle {
    margin: 4px 0 0 0;

    font-size: 12px;
    color: #9aa0a6;
}

.header-actions,
.footer-actions {
    flex-direction: row;
    align-items: center;
}

.button {
    height: 40px;

    margin: 0 0 0 10px;
    padding: 0 20px;

    border-width: 1px;
    border-color: transparent;
    border-radius: 22px;

    font-size: 13px;
    -unity-font-style: bold;

    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.button-primary {
    background-color: #a8c7fa;
    color: #102440;
}

.button-primary:hover {
    background-color: #c2d8fc;
}

.button-secondary {
    background-color: #282c30;
    border-color: #3c4247;
    color: #e0e3e7;
}

.button-secondary:hover {
    background-color: #363c42;
    border-color: #69737c;
}

.button-hint {
    background-color: #334b3d;
    border-color: #526f5c;
    color: #c2e7cd;
}

.button-hint:hover {
    background-color: #42614e;
}

.button:active {
    background-color: #4b5965;
    color: #ffffff;
}

.button:focus {
    border-color: #d3e3fd;
}

.button:disabled {
    background-color: #24282b;
    border-color: #30363a;
    color: #6d767b;
}

.game-panel {
    width: 100%;
    max-width: 1040px;
    min-width: 800px;

    padding: 24px;

    border-width: 1px;
    border-color: #34453c;
    border-radius: 28px;

    background-color: #1b3027;
}

.game-info {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 28px;
}

.game-mode {
    margin: 0;
    padding: 8px 12px;

    border-width: 1px;
    border-color: #42564a;
    border-radius: 12px;

    background-color: #253c30;
    color: #bad0c1;

    font-size: 10px;
    -unity-font-style: bold;
}

.stats {
    flex-direction: row;
    align-items: center;
}

.stat {
    min-width: 72px;
    margin-right: 24px;
}

.stat-last {
    margin-right: 0;
}

.stat-label {
    margin: 0 0 4px 0;

    color: #9eb4a6;
    font-size: 9px;
}

.stat-value {
    margin: 0;

    color: #edf5ef;
    font-size: 20px;
    -unity-font-style: bold;
}

.board {
    width: 100%;
}

.top-row,
.tableau {
    flex-direction: row;
    justify-content: space-between;
}

.top-row {
    margin-bottom: 30px;
}

.board-column,
.tableau-column {
    width: 88px;
    flex-shrink: 0;
}

.board-column {
    align-items: center;
}

.tableau-column {
    position: relative;
    height: 300px;
}

.card,
.card-slot {
    width: 88px;
    height: 124px;

    flex-shrink: 0;

    border-width: 1px;
    border-radius: 11px;
}

.card-slot {
    align-items: center;
    justify-content: center;

    background-color: #192c23;
    border-color: #496151;
}

.slot-symbol {
    margin: 0;

    color: #52705d;
    font-size: 34px;
    -unity-text-align: middle-center;
}

.pile-caption {
    margin: 10px 0 0 0;

    color: #8fa99a;
    font-size: 8px;
    -unity-text-align: middle-center;
}

.card-back {
    align-items: center;
    justify-content: center;

    background-color: #345c4d;
    border-color: #769b86;
}

.card-back-inner {
    width: 70px;
    height: 106px;

    align-items: center;
    justify-content: center;

    border-width: 1px;
    border-color: #688d77;
    border-radius: 7px;

    background-color: #2b4c3f;
}

.card-back-symbol {
    margin: 0;

    font-size: 37px;
    color: #b0cfb7;
}

.card-face {
    background-color: #edf0e9;
    border-color: #c3cfc4;
}

.card-face:hover {
    background-color: #ffffff;
    border-color: #a8c7fa;
}

.card-corner {
    margin: 9px 0 0 9px;

    font-size: 17px;
    -unity-font-style: bold;
}

.card-suit {
    position: absolute;
    top: 32px;
    right: 0;
    bottom: 10px;
    left: 0;

    margin: 0;

    font-size: 42px;
    -unity-text-align: middle-center;
}

.black {
    color: #26352f;
}

.red {
    color: #c44850;
}

/* Later siblings render above earlier cards. */
.tableau-column > .card {
    position: absolute;
    left: 0;
}

.depth-0 { top: 0; }
.depth-1 { top: 24px; }
.depth-2 { top: 48px; }
.depth-3 { top: 72px; }
.depth-4 { top: 96px; }
.depth-5 { top: 120px; }
.depth-6 { top: 144px; }

/* Apply these classes from your game controller. */
.card.selected {
    border-width: 3px;
    border-color: #a8c7fa;
}

.card.hinted {
    border-width: 3px;
    border-color: #f6d980;
}

.card-slot.drop-target {
    background-color: #304c3b;
    border-width: 2px;
    border-color: #a8dab5;
}

.footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding-top: 18px;
    margin-top: 10px;

    border-top-width: 1px;
    border-top-color: #344c3d;
}

.footer-message {
    margin: 0;

    color: #a7bbae;
    font-size: 12px;
}