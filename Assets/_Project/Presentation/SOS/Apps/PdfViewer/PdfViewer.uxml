<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3#ATLAS"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Window/Window.uss?fileID=7433441132597879392&amp;guid=00c704ca2f7eb4f469f7b2b139bf1194&amp;type=3#Window"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Apps/PdfViewer/PdfViewer.uss?fileID=7433441132597879392&amp;guid=b33eb8d624939d94ebaea9a8da17cd4f&amp;type=3#PdfViewer"/>
    <ui:VisualElement name="WindowRoot" class="window pdf-window">
        <ui:VisualElement name="WindowHeader" class="flex-row header pdf-header">
            <ui:VisualElement name="WindowIcon" class="pdf-icon pdf-document-icon"/>
            <ui:Label name="WindowTitle" text="PDF Viewer" class="spacing-reset header-title"/>
            <ui:GroupBox name="WindowControls" class="flex-row spacing-reset window-controls">
                <ui:Button name="WindowMinimizeButton" tooltip="Minimize" class="button-reset wc-button">
                    <ui:Image name="MinimizeIcon" picking-mode="Ignore" class="pdf-icon pdf-minimize-icon"/>
                </ui:Button>
                <ui:Button name="WindowMaximizeButton" tooltip="Maximize or restore" class="button-reset wc-button">
                    <ui:Image name="FullscreenIcon" picking-mode="Ignore" class="pdf-icon pdf-maximize-icon"/>
                    <ui:Image name="ExitFullscreenIcon" picking-mode="Ignore" class="pdf-icon pdf-restore-icon"/>
                </ui:Button>
                <ui:Button name="WindowCloseButton" tooltip="Close" class="button-reset wc-button window-close-button">
                    <ui:Image name="CloseIcon" picking-mode="Ignore" class="pdf-icon pdf-close-icon"/>
                </ui:Button>
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:VisualElement name="WindowContent" class="pdf-content">
            <ui:VisualElement name="PdfToolbar" class="pdf-toolbar">
                <ui:VisualElement class="pdf-toolbar-left">
                    <ui:Button name="SidebarToggleButton" tooltip="Show or hide sidebar" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-sidebar-icon"/>
                    </ui:Button>
                    <ui:Label name="DocumentTitle" text="FileName.pdf" class="pdf-document-title"/>
                </ui:VisualElement>
                <ui:VisualElement class="pdf-toolbar-center">
                    <ui:Button name="PreviousPageButton" tooltip="Previous page" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-up-icon"/>
                    </ui:Button>
                    <ui:Button name="NextPageButton" tooltip="Next page" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-down-icon"/>
                    </ui:Button>
                    <ui:IntegerField name="PageNumberField" value="1" is-delayed="true" tooltip="Page number; press Enter to navigate" class="pdf-field pdf-page-number"/>
                    <ui:Label name="PageCountLabel" text="of 0" class="pdf-page-count"/>
                    <ui:VisualElement class="pdf-divider"/>
                    <ui:Button name="ZoomOutButton" tooltip="Zoom out" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-minus-icon"/>
                    </ui:Button>
                    <ui:FloatField name="ZoomField" value="100" is-delayed="true" tooltip="Zoom percentage; press Enter to apply" class="pdf-field pdf-zoom-field"/>
                    <ui:Label text="%" class="pdf-percent"/>
                    <ui:Button name="ZoomInButton" tooltip="Zoom in" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-plus-icon"/>
                    </ui:Button>
                    <ui:DropdownField name="FitDropdown" choices="Automatic,Fit page,Fit width,Actual size" index="2" tooltip="Page fitting" class="pdf-field pdf-fit-field"/>
                </ui:VisualElement>
                <ui:VisualElement class="pdf-toolbar-right">
                    <ui:Button name="SearchButton" tooltip="Find in document (Ctrl+F)" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-search-icon"/>
                    </ui:Button>
                    <ui:Button name="ViewerFullscreenButton" tooltip="Fill workspace (F11); Escape exits" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-fullscreen-icon"/>
                    </ui:Button>
                    <ui:Button name="MoreOptionsButton" tooltip="More options" class="pdf-button pdf-icon-button">
                        <ui:Image picking-mode="Ignore" class="pdf-icon pdf-more-icon"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SearchBar" class="pdf-search-bar pdf-hidden">
                <ui:TextField name="SearchField" tooltip="Find text in document" class="pdf-field pdf-search-field"/>
                <ui:Button name="PreviousMatchButton" tooltip="Previous match (Shift+Enter)" class="pdf-button pdf-icon-button">
                    <ui:Image picking-mode="Ignore" class="pdf-icon pdf-up-icon"/>
                </ui:Button>
                <ui:Button name="NextMatchButton" tooltip="Next match (Enter)" class="pdf-button pdf-icon-button">
                    <ui:Image picking-mode="Ignore" class="pdf-icon pdf-down-icon"/>
                </ui:Button>
                <ui:Label name="SearchResultLabel" text="0 matches" class="pdf-search-results"/>
                <ui:Button name="CloseSearchButton" tooltip="Close find (Escape)" class="pdf-button pdf-icon-button">
                    <ui:Image picking-mode="Ignore" class="pdf-icon pdf-close-icon"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="ViewerBody" class="pdf-body">
                <ui:VisualElement name="Sidebar" class="pdf-sidebar pdf-hidden">
                    <ui:VisualElement class="pdf-sidebar-header">
                        <ui:Label name="SidebarTitle" text="Pages" class="pdf-sidebar-title"/>
                        <ui:Button name="CloseSidebarButton" tooltip="Close sidebar" class="pdf-button pdf-icon-button">
                            <ui:Image picking-mode="Ignore" class="pdf-icon pdf-close-icon"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="pdf-sidebar-tabs">
                        <ui:Button name="ThumbnailsTabButton" tooltip="Page thumbnails" class="pdf-button pdf-icon-button">
                            <ui:Image picking-mode="Ignore" class="pdf-icon pdf-thumbnails-icon"/>
                        </ui:Button>
                        <ui:Button name="OutlineTabButton" tooltip="Document outline" class="pdf-button pdf-icon-button">
                            <ui:Image picking-mode="Ignore" class="pdf-icon pdf-outline-icon"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:ScrollView name="ThumbnailsPanel" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="pdf-scroll pdf-thumbnails">
                        <ui:VisualElement name="ThumbnailItems" class="pdf-thumbnail-items"/>
                    </ui:ScrollView>
                    <ui:VisualElement name="OutlinePanel" class="pdf-outline-panel pdf-hidden">
                        <ui:TreeView name="DocumentOutline" class="pdf-scroll pdf-outline"/>
                        <ui:Label name="OutlineEmptyLabel" text="No document outline available." class="pdf-muted"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SidebarResizeHandle" tooltip="Drag to resize; arrow keys also adjust width" class="pdf-sidebar-resize pdf-hidden"/>
                <ui:VisualElement name="DocumentViewport" class="pdf-viewport">
                    <ui:ScrollView name="DocumentScrollView" mode="VerticalAndHorizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Auto" class="pdf-scroll pdf-document-scroll">
                        <ui:VisualElement name="DocumentPages" class="pdf-pages"/>
                    </ui:ScrollView>
                    <ui:Label name="EmptyDocumentLabel" text="No PDF loaded" picking-mode="Ignore" class="pdf-empty-state"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="MoreOptionsMenu" class="pdf-more-menu pdf-hidden">
                <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="pdf-scroll pdf-menu-scroll">
                    <ui:Button name="PresentationModeButton" text="Presentation mode" class="pdf-button pdf-menu-item"/>
                    <ui:Button name="CurrentPageButton" text="Go to current page" class="pdf-button pdf-menu-item"/>
                    <ui:Button name="FirstPageButton" text="Go to first page" class="pdf-button pdf-menu-item"/>
                    <ui:Button name="LastPageButton" text="Go to last page" class="pdf-button pdf-menu-item"/>
                    <ui:VisualElement class="pdf-menu-divider"/>
                    <ui:Button name="RotateClockwiseButton" text="Rotate clockwise" class="pdf-button pdf-menu-item"/>
                    <ui:Button name="RotateCounterclockwiseButton" text="Rotate counterclockwise" class="pdf-button pdf-menu-item"/>
                    <ui:VisualElement class="pdf-menu-divider"/>
                    <ui:Button name="HandToolButton" text="Hand tool" tooltip="Enable or disable left-mouse dragging" class="pdf-button pdf-menu-item"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="PresentationControls" class="pdf-presentation-controls pdf-hidden">
                <ui:Button name="PresentationPreviousButton" tooltip="Previous page" class="pdf-button pdf-icon-button">
                    <ui:Image picking-mode="Ignore" class="pdf-icon pdf-up-icon"/>
                </ui:Button>
                <ui:Button name="PresentationNextButton" tooltip="Next page" class="pdf-button pdf-icon-button">
                    <ui:Image picking-mode="Ignore" class="pdf-icon pdf-down-icon"/>
                </ui:Button>
                <ui:Button name="ExitPresentationButton" text="Exit presentation" tooltip="Exit presentation (Escape)" class="pdf-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WindowFooter" class="pdf-hidden"/>
    </ui:VisualElement>
</ui:UXML>
