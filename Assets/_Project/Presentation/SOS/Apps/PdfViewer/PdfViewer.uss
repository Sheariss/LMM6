.pdf-window {
    width: 1100px;
    height: 720px;
    min-width: 960px;
    min-height: 420px;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--window-bg);
    border-color: var(--window-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: var(--text-xs);
}

.pdf-window .pdf-hidden {
    display: none;
}

.pdf-header {
    flex-shrink: 0;
    padding-left: 12px;
    background-color: var(--window-header);
}

.pdf-header > .pdf-icon {
    margin-right: 8px;
}

.pdf-content,
.pdf-body,
.pdf-viewport,
.pdf-document-scroll,
.pdf-thumbnails,
.pdf-outline-panel,
.pdf-outline,
.pdf-menu-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.pdf-content {
    position: relative;
    overflow: hidden;
}

.pdf-body,
.pdf-toolbar,
.pdf-toolbar-left,
.pdf-toolbar-center,
.pdf-toolbar-right,
.pdf-search-bar,
.pdf-sidebar-header,
.pdf-sidebar-tabs,
.pdf-presentation-controls {
    flex-direction: row;
}

.pdf-toolbar {
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    padding: 0 8px;
    background-color: var(--bg-secondary);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.pdf-toolbar-left,
.pdf-toolbar-right {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
}

.pdf-toolbar-center {
    flex-shrink: 0;
    align-items: center;
}

.pdf-toolbar-right {
    justify-content: flex-end;
}

.pdf-document-title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-primary);
    -unity-text-align: middle-left;
}

.pdf-window .pdf-button {
    height: 30px;
    min-height: 30px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 8px;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    background-image: none;
    border-width: 1px;
    border-color: transparent;
    border-radius: 5px;
    color: var(--text-primary);
    font-size: var(--text-xs);
    -unity-font-style: normal;
}

.pdf-window .pdf-icon-button {
    width: 30px;
    padding: 0;
}

.pdf-window .pdf-button:hover {
    background-color: var(--surface-hover);
}

.pdf-window .pdf-button:active {
    background-color: var(--surface-active);
}

.pdf-window .pdf-button:focus {
    border-color: var(--border-focus);
}

.pdf-window .pdf-button:disabled {
    opacity: 0.4;
}

.pdf-window .pdf-button.pdf-selected {
    background-color: var(--surface-active);
    border-color: var(--accent-primary);
}

.pdf-window .pdf-button.pdf-selected:hover {
    background-color: var(--surface-hover);
    border-color: var(--accent-hover);
}

.pdf-divider {
    width: 1px;
    height: 20px;
    flex-shrink: 0;
    margin: 0 8px;
    background-color: var(--border-primary);
}

.pdf-field {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

.pdf-field .unity-base-field__input {
    min-height: 30px;
    padding: 0 6px;
    background-color: var(--bg-tertiary);
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 5px;
    color: var(--text-primary);
}

.pdf-field .unity-base-field__input:hover {
    background-color: var(--surface-hover);
}

.pdf-field .unity-base-field__input:focus {
    border-color: var(--border-focus);
}

.pdf-field .unity-text-element,
.pdf-field .unity-base-popup-field__text {
    color: var(--text-primary);
    font-size: var(--text-xs);
}

.pdf-field .unity-base-popup-field__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.pdf-field .unity-base-popup-field__arrow {
    width: 14px;
    min-width: 14px;
    height: 14px;
    min-height: 14px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    margin-left: 4px;
    background-color: transparent;
    background-image: resource("Icons/Arrows 1/Expand-Arrow/keyboard_arrow_down_24dp");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-secondary);
}

.pdf-page-number {
    width: 48px;
    margin-left: 4px;
}

.pdf-zoom-field {
    width: 54px;
}

.pdf-page-number .unity-text-element,
.pdf-zoom-field .unity-text-element {
    -unity-text-align: middle-center;
}

.pdf-page-count,
.pdf-percent {
    flex-shrink: 0;
    margin: 0;
    color: var(--text-secondary);
}

.pdf-page-count {
    padding: 0 6px;
}

.pdf-percent {
    padding: 0 4px;
}

.pdf-fit-field {
    width: 100px;
    margin-left: 6px;
}

.pdf-search-bar {
    flex-shrink: 0;
    align-items: center;
    padding: 8px;
    background-color: var(--bg-secondary);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.pdf-search-field {
    width: 240px;
    margin-right: 8px;
}

.pdf-search-results {
    flex-grow: 1;
    margin-left: 8px;
    color: var(--text-secondary);
}

.pdf-sidebar {
    width: 260px;
    min-width: 200px;
    flex-shrink: 0;
    min-height: 0;
    background-color: var(--bg-secondary);
}

.pdf-sidebar-header {
    height: 42px;
    flex-shrink: 0;
    align-items: center;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.pdf-sidebar-title {
    flex-grow: 1;
    min-width: 0;
    color: var(--text-primary);
    font-size: var(--text-sm);
}

.pdf-sidebar-tabs {
    flex-shrink: 0;
    align-items: center;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.pdf-sidebar-tabs > .pdf-button {
    margin-right: 4px;
}

.pdf-sidebar-resize {
    width: 6px;
    flex-shrink: 0;
    background-color: var(--border-primary);
}

.pdf-sidebar-resize:hover,
.pdf-sidebar-resize:focus {
    background-color: var(--accent-primary);
}

.pdf-thumbnails {
    padding: 12px 8px;
}

.pdf-thumbnail-items {
    align-items: center;
}

.pdf-window .pdf-thumbnail {
    width: 156px;
    height: auto;
    min-height: 0;
    flex-shrink: 0;
    margin: 0 0 14px 0;
    padding: 4px;
    align-items: center;
    background-color: transparent;
    background-image: none;
    border-width: 2px;
    border-color: transparent;
    border-radius: 10px;
}

.pdf-window .pdf-thumbnail:hover {
    background-color: var(--surface-hover);
    border-color: var(--border-secondary);
}

.pdf-window .pdf-thumbnail:focus {
    border-color: var(--border-focus);
}

.pdf-window .pdf-thumbnail.pdf-selected {
    background-color: var(--surface-active);
    border-color: var(--accent-primary);
}

.pdf-thumbnail-card {
    position: relative;
    width: 144px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 6px;
    background-color: white;
}

.pdf-thumbnail-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.pdf-thumbnail-number {
    position: absolute;
    bottom: 6px;
    left: 52px;
    width: 40px;
    height: 22px;
    margin: 0;
    padding: 0;
    border-radius: 11px;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.pdf-selected .pdf-thumbnail-number {
    background-color: var(--accent-primary);
    color: white;
}

.pdf-outline-panel {
    padding: 8px;
}

.pdf-outline,
.pdf-outline .unity-collection-view__item {
    background-color: transparent;
    color: var(--text-primary);
}

.pdf-outline .unity-collection-view__item {
    border-left-width: 3px;
    border-left-color: transparent;
    border-radius: 4px;
}

.pdf-outline .unity-collection-view__item:hover {
    background-color: var(--surface-hover);
}

.pdf-outline .unity-collection-view__item--selected {
    background-color: var(--surface-active);
    border-left-color: var(--accent-primary);
}

.pdf-outline .unity-collection-view__item--selected:hover {
    background-color: var(--surface-hover);
}

.pdf-outline-label {
    flex-grow: 1;
    margin: 0;
    padding: 0 6px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-primary);
    -unity-text-align: middle-left;
}

.pdf-muted {
    color: var(--text-muted);
    white-space: normal;
}

.pdf-viewport {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-primary);
}

.pdf-document-scroll > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}

.pdf-pages {
    flex-grow: 1;
    flex-shrink: 0;
    align-items: center;
    padding: 16px;
}

.pdf-page {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: var(--border-secondary);
    background-color: white;
}

.pdf-page-image {
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.pdf-dragging .pdf-page {
    border-color: var(--accent-primary);
}

.pdf-empty-state {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-md);
    -unity-text-align: middle-center;
}

.pdf-more-menu {
    position: absolute;
    top: 44px;
    right: 8px;
    width: 240px;
    max-height: 85%;
    padding: 8px;
    background-color: var(--bg-secondary);
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 8px;
}

.pdf-window .pdf-menu-item {
    align-items: stretch;
    -unity-text-align: middle-left;
}

.pdf-menu-divider {
    height: 1px;
    flex-shrink: 0;
    margin: 6px 0;
    background-color: var(--border-primary);
}

.pdf-fullscreen > .pdf-header {
    display: none;
}

.pdf-fullscreen {
    border-radius: 0;
}

.pdf-presentation .pdf-toolbar {
    display: none;
}

.pdf-presentation .pdf-viewport {
    background-color: black;
}

.pdf-presentation .pdf-page {
    margin-bottom: 0;
}

.pdf-presentation-controls {
    position: absolute;
    right: 16px;
    bottom: 16px;
    align-items: center;
    padding: 6px;
    border-width: 1px;
    border-color: var(--border-primary);
    border-radius: 8px;
    background-color: var(--bg-secondary);
}

.pdf-presentation-controls > .pdf-button {
    margin-left: 4px;
}

.pdf-scroll .unity-scroll-view__vertical-scroller {
    width: 10px;
    min-width: 10px;
    background-color: transparent;
    border-width: 0;
}

.pdf-scroll .unity-scroll-view__horizontal-scroller {
    height: 10px;
    min-height: 10px;
    background-color: transparent;
    border-width: 0;
}

.pdf-scroll .unity-scroller__low-button,
.pdf-scroll .unity-scroller__high-button {
    display: none;
}

.pdf-scroll .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.pdf-scroll .unity-base-slider__dragger {
    background-image: none;
    background-color: var(--text-muted);
    border-width: 0;
    border-radius: 4px;
}

.pdf-scroll .unity-base-slider__dragger:hover {
    background-color: var(--text-secondary);
}

.pdf-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-primary);
}

.pdf-document-icon {
    background-image: resource("AppIcons/Pdf Viewer/icons8-pdf-48");
}

.pdf-sidebar-icon,
.pdf-outline-icon {
    background-image: resource("Icons/Apps/Notepad/Sidebar/chrome_reader_mode_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.pdf-thumbnails-icon {
    background-image: resource("Icons/Layout/Grid/grid_view_24dp");
}

.pdf-up-icon {
    background-image: resource("Icons/Arrows 1/Collapse-Arrow/keyboard_control_key_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.pdf-down-icon {
    background-image: resource("Icons/Arrows 1/Expand-Arrow/keyboard_arrow_down_32dp");
}

.pdf-minus-icon {
    background-image: resource("Icons/Math/Minus/remove_24dp");
}

.pdf-plus-icon {
    background-image: resource("Icons/Math/Add/add_2_24dp");
}

.pdf-search-icon {
    background-image: resource("Icons/UI/Search/search_24dp");
}

.pdf-fullscreen-icon {
    background-image: resource("Icons/Apps/Photos/FullScreen Pan/pan_zoom_32dp_FFFFFF_FILL0_wght400_GRAD0_opsz40");
}

.pdf-more-icon {
    background-image: resource("Icons/Apps/Browser/More Vert/more_vert_24dp_FFFFFF_FILL0_wght400_GRAD0_opsz24");
}

.pdf-minimize-icon {
    background-image: resource("Icons/UI/Minimize/remove_24dp");
}

.pdf-maximize-icon {
    background-image: resource("Icons/UI/Maximize-Exit/crop_square_24dp");
}

.pdf-restore-icon {
    background-image: resource("Icons/UI/Maximize/filter_none_24dp");
}

.pdf-close-icon {
    background-image: resource("Icons/UI/Close/close_24dp");
}

.pdf-zoom-field {
    width: 68px;
}