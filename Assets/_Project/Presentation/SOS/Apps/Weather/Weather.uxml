<ui:UXML xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">

    <Style src="../../../Tokens/Global-Colors.uss"/>
    <Style src="../../../Tokens/Global-Tokens.uss"/>
    <Style src="../../../Tokens/ATLAS.uss"/>
    <Style src="../../Window/Window.uss"/>
    <Style src="Weather.uss"/>

    <ui:VisualElement name="WindowRoot"
                      class="window weather-window"
                      style="width: 480px; height: 760px;">

        <ui:VisualElement name="WindowHeader" class="flex-row header">
            <ui:VisualElement class="header-icon-area">
                <ui:VisualElement name="WindowIcon" class="header-icon"/>
            </ui:VisualElement>

            <ui:Label name="WindowTitle"
                      text="Weather"
                      class="spacing-reset header-title"/>

            <ui:GroupBox name="WindowControls"
                         class="flex-row spacing-reset window-controls">

                <ui:Button name="WindowMinimizeButton"
                           tooltip="Minimize"
                           class="button-reset wc-button">
                    <ui:Image
                        class="wc-btn-icon minimize-icon"
                        style="background-image: resource('Icons/UI/Minimize/remove_32dp_');"/>
                </ui:Button>

                <ui:Button name="WindowMaximizeButton"
                           tooltip="Maximize or restore"
                           class="button-reset wc-button">
                    <ui:Image
                        name="FullscreenIcon"
                        class="wc-btn-icon window-maximize-icon"
                        style="background-image: resource('Icons/UI/Maximize-Exit/crop_square_32dp');"/>
                    <ui:Image
                        name="ExitFullscreenIcon"
                        class="wc-btn-icon window-maximize-icon"
                        style="background-image: resource('Icons/UI/Maximize/filter_none_32dp');"/>
                </ui:Button>

                <ui:Button name="WindowCloseButton"
                           tooltip="Close"
                           class="button-reset wc-button window-close-button">
                    <ui:Image
                        class="wc-btn-icon"
                        style="background-image: resource('Icons/UI/Close/close_32dp');"/>
                </ui:Button>
            </ui:GroupBox>
        </ui:VisualElement>

        <ui:VisualElement name="WindowContent"
                          class="content weather-window-content">

            <ui:VisualElement name="WeatherRoot" class="weather-screen">

                <ui:ScrollView name="weather-scroll"
                               mode="Vertical"
                               horizontal-scroller-visibility="Hidden"
                               vertical-scroller-visibility="Auto"
                               class="weather-scroll">

                    <ui:VisualElement name="weather-app" class="weather-app">

                        <ui:VisualElement class="weather-header">
                            <ui:VisualElement class="weather-header-copy">
                                <ui:Label text="WEATHER" class="eyebrow"/>
                                <ui:Label name="location-label"
                                          text="Westbrook"
                                          class="location"/>
                                <ui:Label name="date-label"
                                          text="Thursday, October 15"
                                          class="secondary"/>
                            </ui:VisualElement>

                            <ui:Button name="locations-button"
                                       text="Locations"
                                       class="pill-button"/>
                        </ui:VisualElement>

                        <ui:VisualElement name="locations-panel"
                                          class="weather-locations-panel">
                            <ui:Label text="Choose a location"
                                      class="card-heading"/>
                            <ui:DropdownField name="location-picker"
                                              class="weather-location-picker"/>
                        </ui:VisualElement>

                        <ui:VisualElement class="current-card">
                            <ui:VisualElement class="current-top">
                                <ui:Label text="Current conditions"
                                          class="card-heading"/>

                                <ui:VisualElement class="live-badge">
                                    <ui:VisualElement class="live-dot"/>
                                    <ui:Label text="Live" class="live-label"/>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="current-body">
                                <ui:VisualElement class="temperature-block">
                                    <ui:Label name="temperature-label"
                                              text="24&#176;"
                                              class="temperature"/>
                                    <ui:Label name="condition-label"
                                              text="Partly cloudy"
                                              class="condition"/>
                                    <ui:Label name="temperature-range-label"
                                              text="High 26&#176;  &#183;  Low 18&#176;"
                                              class="secondary"/>
                                </ui:VisualElement>

                                <ui:VisualElement class="weather-art">
                                    <ui:VisualElement
                                        name="weather-illustration"
                                        class="weather-illustration">
                                        <ui:VisualElement class="sun-halo"/>
                                        <ui:VisualElement class="sun"/>
                                        <ui:VisualElement class="cloud cloud-back"/>
                                        <ui:VisualElement class="cloud cloud-front"/>
                                    </ui:VisualElement>

                                    <ui:Image name="weather-artwork"
                                              class="weather-artwork"/>
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="summary-strip">
                                <ui:Label
                                    name="summary-label"
                                    text="A clear afternoon ahead. Rain expected tonight."
                                    class="summary-text"/>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="hourly-card"
                                          class="card hourly-card">

                            <ui:VisualElement class="section-header">
                                <ui:Label text="Hourly forecast"
                                          class="card-heading"/>
                                <ui:Label text="Next 6 hours"
                                          class="secondary"/>
                            </ui:VisualElement>

                            <ui:ScrollView
                                mode="Horizontal"
                                horizontal-scroller-visibility="Auto"
                                vertical-scroller-visibility="Hidden"
                                class="forecast-scroll">

                                <ui:VisualElement name="hourly-container"
                                                  class="hourly-row">

                                    <!-- Runtime replaces this preview entry. -->
                                    <ui:VisualElement class="hour-item hour-selected">
                                        <ui:Label text="Now" class="hour-time"/>
                                        <ui:Image
                                            class="forecast-icon"
                                            style="background-image: resource('WeatherIcons/icons8-partly-cloudy-day-48');"/>
                                        <ui:VisualElement class="hour-divider"/>
                                        <ui:Label text="24&#176;" class="hour-temp"/>
                                        <ui:Label text="Rain 5%" class="metric-value"/>
                                        <ui:Label text="1012 hPa" class="metric-value"/>
                                    </ui:VisualElement>

                                </ui:VisualElement>
                            </ui:ScrollView>
                        </ui:VisualElement>

                        <ui:VisualElement name="details-grid"
                                          class="details-grid">

                            <ui:VisualElement class="detail-card">
                                <ui:Label text="Feels like" class="secondary"/>
                                <ui:Label name="feels-like-label"
                                          text="26&#176;"
                                          class="detail-value"/>
                                <ui:Label name="feels-like-caption"
                                          text="Slightly warmer"
                                          class="detail-caption"/>
                            </ui:VisualElement>

                            <ui:VisualElement class="detail-card">
                                <ui:Label text="Wind" class="secondary"/>
                                <ui:Label name="wind-label"
                                          text="12 km/h"
                                          class="detail-value"/>
                                <ui:Label name="wind-caption"
                                          text="From the northeast"
                                          class="detail-caption"/>
                            </ui:VisualElement>

                            <ui:VisualElement class="detail-card">
                                <ui:Label text="Humidity" class="secondary"/>
                                <ui:Label name="humidity-label"
                                          text="64%"
                                          class="detail-value"/>
                                <ui:Label name="humidity-caption"
                                          text="Comfortable"
                                          class="detail-caption"/>
                            </ui:VisualElement>

                            <ui:VisualElement class="detail-card">
                                <ui:Label text="Visibility" class="secondary"/>
                                <ui:Label name="visibility-label"
                                          text="10 km"
                                          class="detail-value"/>
                                <ui:Label name="visibility-caption"
                                          text="Clear conditions"
                                          class="detail-caption"/>
                            </ui:VisualElement>

                        </ui:VisualElement>

                        <ui:VisualElement name="forecast-grid"
                                          class="forecast-grid">

                            <ui:VisualElement class="card daily-card">
                                <ui:VisualElement class="section-header">
                                    <ui:Label text="5-day forecast"
                                              class="card-heading"/>
                                    <ui:Label text="Day and night"
                                              class="secondary"/>
                                </ui:VisualElement>

                                <ui:ScrollView
                                    mode="Horizontal"
                                    horizontal-scroller-visibility="Auto"
                                    vertical-scroller-visibility="Hidden"
                                    class="forecast-scroll">

                                    <ui:VisualElement name="daily-container"
                                                      class="daily-list">

                                        <!-- Runtime replaces this preview entry. -->
                                        <ui:VisualElement class="day-card">
                                            <ui:Label text="Today, Oct 15"
                                                      class="day-date"/>

                                            <ui:Label text="Day"
                                                      class="day-period"/>

                                            <ui:VisualElement class="day-reading">
                                                <ui:Label text="26&#176;"
                                                          class="day-temperature"/>
                                                <ui:Image
                                                    class="day-icon"
                                                    style="background-image: resource('WeatherIcons/icons8-partly-cloudy-day-48');"/>
                                            </ui:VisualElement>

                                            <ui:Label text="Partly cloudy"
                                                      class="day-condition"/>

                                            <ui:VisualElement class="day-divider"/>

                                            <ui:Label text="Night"
                                                      class="day-period"/>

                                            <ui:VisualElement class="day-reading">
                                                <ui:Label text="18&#176;"
                                                          class="night-temperature"/>
                                                <ui:Image
                                                    class="day-icon"
                                                    style="background-image: resource('WeatherIcons/icons8-night-48');"/>
                                            </ui:VisualElement>

                                            <ui:Label text="Clear night"
                                                      class="day-condition"/>

                                            <ui:VisualElement class="day-metrics">
                                                <ui:Label text="Wind           12 km/h"
                                                          class="day-metric-label"/>
                                                <ui:Label text="Humidity          64%"
                                                          class="day-metric-label"/>
                                                <ui:Label text="UV index            3"
                                                          class="day-metric-label"/>
                                                <ui:Label text="Rain                5%"
                                                          class="day-metric-label"/>
                                            </ui:VisualElement>
                                        </ui:VisualElement>

                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>

                        </ui:VisualElement>

                        <ui:Label name="weather-footer"
                                  text="Report updated at 14:00"
                                  class="weather-footer"/>

                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="WindowFooter" class="footer"/>
    </ui:VisualElement>
</ui:UXML>