.weather-screen {
    flex-grow: 1;
    background-color: #101318;
    color: #e3e7ef;
    -unity-font-style: normal;
}

.weather-scroll {
    flex-grow: 1;
}

.weather-app {
    width: 100%;
    max-width: 760px;
    align-self: center;
    padding: 28px 24px 20px 24px;
}

Label {
    margin: 0;
    padding: 0;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.eyebrow {
    font-size: 10px;
    letter-spacing: 3px;
    color: #a8c7fa;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.location {
    font-size: 30px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.secondary {
    font-size: 12px;
    color: #a6afbd;
}

.pill-button {
    height: 36px;
    padding: 0 18px;
    margin: 0;
    background-color: #252e3c;
    color: #c2d8ff;
    border-width: 1px;
    border-color: #39475c;
    border-radius: 20px;
    font-size: 12px;
    -unity-font-style: bold;
}

.pill-button:hover {
    background-color: #34435a;
    border-color: #a8c7fa;
}

.pill-button:active {
    background-color: #405778;
}

.pill-button:focus {
    border-color: #a8c7fa;
}

.current-card {
    background-color: #202e43;
    border-radius: 28px;
    padding: 22px;
    margin-bottom: 16px;
    overflow: hidden;
}

.current-top,
.section-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card-heading {
    font-size: 14px;
    -unity-font-style: bold;
    color: #e3e7ef;
}

.live-badge {
    flex-direction: row;
    align-items: center;
    background-color: #2c4053;
    border-radius: 12px;
    padding: 5px 9px;
}

.live-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #a8dab5;
    margin-right: 6px;
}

.live-label {
    font-size: 10px;
    color: #bce8c6;
}

.current-body {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 24px;
}

.temperature-block {
    flex-shrink: 0;
}

.temperature {
    font-size: 88px;
    letter-spacing: -5px;
    color: #e0ebff;
}

.condition {
    font-size: 19px;
    margin-bottom: 8px;
}

.weather-art {
    width: 180px;
    height: 150px;
    flex-shrink: 1;
    margin-left: 12px;
}

.sun-halo {
    position: absolute;
    width: 124px;
    height: 124px;
    top: 0;
    right: 5px;
    border-radius: 62px;
    background-color: rgba(253, 214, 99, 0.08);
}

.sun {
    position: absolute;
    width: 82px;
    height: 82px;
    top: 21px;
    right: 26px;
    border-radius: 41px;
    background-color: #f6d875;
}

.cloud {
    position: absolute;
    border-radius: 40px;
}

.cloud-back {
    width: 88px;
    height: 64px;
    top: 62px;
    right: 47px;
    background-color: #c5d5ec;
}

.cloud-front {
    width: 144px;
    height: 54px;
    top: 91px;
    right: 3px;
    background-color: #e0e9f6;
}

.summary-strip {
    padding: 13px 15px;
    border-radius: 16px;
    background-color: rgba(168, 199, 250, 0.08);
}

.summary-text {
    font-size: 12px;
    color: #cad9ee;
    white-space: normal;
}

.card {
    background-color: #1b2028;
    border-radius: 24px;
    padding: 20px;
    margin-bottom: 16px;
}

.hourly-row {
    flex-direction: row;
    margin-top: 18px;
}

.hour-item {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    padding: 14px 2px;
    margin: 0 2px;
    border-radius: 18px;
}

.hour-selected {
    background-color: #303e54;
}

.hour-time {
    font-size: 11px;
    color: #bdc5d2;
    margin-bottom: 17px;
}

.hour-selected .hour-time {
    color: #d4e4ff;
    -unity-font-style: bold;
}

.weather-tag {
    font-size: 8px;
    letter-spacing: 0.5px;
    color: #c5cedc;
    margin-bottom: 14px;
}

.tag-sun {
    color: #f6d875;
}

.tag-rain {
    color: #a8c7fa;
}

.hour-temp {
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 9px;
}

.rain-chance {
    font-size: 10px;
    color: #a8c7fa;
}

.details-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -6px 4px -6px;
}

.detail-card {
    width: 48%;
    flex-grow: 1;
    background-color: #1b2028;
    border-radius: 22px;
    padding: 18px;
    margin: 0 6px 12px 6px;
}

.detail-value {
    font-size: 27px;
    color: #d6e4ff;
    margin-top: 10px;
    margin-bottom: 6px;
}

.detail-caption {
    font-size: 11px;
    color: #858f9f;
}

.forecast-card {
    padding-bottom: 8px;
}

.daily-list {
    margin-top: 12px;
}

.daily-row {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    border-bottom-width: 1px;
    border-bottom-color: #2a303a;
}

.daily-row-last {
    border-bottom-width: 0;
}

.day-name {
    width: 52px;
    font-size: 12px;
    -unity-font-style: bold;
}

.day-condition {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 70px;
    font-size: 11px;
    color: #a6afbd;
}

.day-low {
    width: 32px;
    font-size: 12px;
    color: #929eaf;
    -unity-text-align: middle-right;
}

.day-high {
    width: 32px;
    font-size: 12px;
    color: #e3e7ef;
    -unity-text-align: middle-right;
}

.range-track {
    width: 90px;
    height: 5px;
    margin-left: 12px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: #303744;
}

.range-fill {
    position: absolute;
    height: 5px;
    border-radius: 3px;
    background-color: #a8c7fa;
}

.range-today {
    left: 10%;
    width: 65%;
}

.range-friday {
    left: 0;
    width: 50%;
    background-color: #8ab4f8;
}

.range-saturday {
    left: 10%;
    width: 50%;
}

.range-sunday {
    left: 20%;
    width: 70%;
    background-color: #e6cb87;
}

.range-monday {
    left: 30%;
    width: 70%;
    background-color: #f6d875;
}

.footer {
    font-size: 10px;
    color: #788393;
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 12px;
}