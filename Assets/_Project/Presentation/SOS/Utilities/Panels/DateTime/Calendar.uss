.calendar-widget {
    position: absolute;
    right: 0;
    bottom: 0;

    width: 360px;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;

    flex-direction: column;
    overflow: hidden;

    background-color: rgb(36, 36, 36);
    color: rgb(245, 245, 245);

    border-width: 1px;
    border-color: rgb(62, 62, 62);
    border-radius: 8px;

    -unity-font-style: normal;
    font-size: 14px;
}

.calendar-widget Button {
    margin: 0;
    padding: 0;

    min-width: 0;
    min-height: 0;

    background-image: none;
    background-color: transparent;

    border-width: 1px;
    border-color: transparent;

    color: rgb(245, 245, 245);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.calendar-widget Button:focus {
    border-color: rgb(180, 180, 180);
}

.calendar-widget Button:disabled {
    opacity: 0.4;
}

.calendar-header {
    min-height: 76px;
    flex-shrink: 0;

    padding: 12px 14px 12px 24px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    border-bottom-width: 1px;
    border-bottom-color: rgb(27, 27, 27);
}

.calendar-heading {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.calendar-time,
.calendar-date,
.calendar-timezone,
.calendar-month {
    margin: 0;
    padding: 0;
}

.calendar-time {
    font-size: 24px;
}

.calendar-date {
    margin-top: 4px;
    font-size: 14px;
    white-space: normal;
}

.calendar-widget .calendar-icon-button {
    width: 32px;
    height: 32px;
    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    border-radius: 4px;
}

.calendar-widget .calendar-icon-button:hover {
    background-color: rgb(55, 55, 55);
}

.calendar-widget .calendar-icon-button:active {
    background-color: rgb(46, 46, 46);
}

.calendar-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.calendar-collapse-icon {
    rotate: 180deg;
}

.calendar-collapsed .calendar-collapse-icon {
    rotate: 0deg;
}

.calendar-body {
    min-height: 0;
    flex-shrink: 1;

    margin: 0;
    padding: 0;
}

.calendar-body .unity-scroll-view__content-container {
    padding: 12px 16px 18px;
}

.calendar-timezone {
    margin-left: 8px;
    margin-bottom: 4px;

    color: rgb(180, 180, 180);
    font-size: 11px;
    white-space: normal;
}

.calendar-month-header {
    min-height: 42px;
    flex-shrink: 0;

    padding-left: 8px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.calendar-month {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;

    font-size: 14px;
    white-space: normal;
}

.calendar-navigation {
    flex-direction: row;
    flex-shrink: 0;
}

.calendar-navigation > Button {
    margin-left: 8px;
}

.calendar-weekdays {
    height: 36px;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
}

.calendar-weekday {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;

    margin: 0;
    padding: 0;

    font-size: 12px;
    color: rgb(225, 225, 225);
    -unity-text-align: middle-center;
}

.calendar-week {
    height: 44px;
    flex-shrink: 0;

    flex-direction: row;
    align-items: center;
}

.calendar-day-slot {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;

    align-items: center;
    justify-content: center;
}

.calendar-widget .calendar-day {
    width: 40px;
    max-width: 100%;
    height: 40px;
    flex-shrink: 0;

    border-radius: 20px;
    font-size: 13px;
}

.calendar-widget .calendar-day:hover {
    background-color: rgb(58, 58, 58);
}

.calendar-widget .calendar-day:active {
    background-color: rgb(70, 70, 70);
}

.calendar-widget .calendar-day-outside {
    color: rgb(145, 145, 145);
}

.calendar-widget .calendar-day-today {
    background-color: rgb(96, 205, 255);
    color: rgb(0, 42, 60);
}

.calendar-widget .calendar-day-today:hover {
    background-color: rgb(123, 215, 255);
}

.calendar-widget .calendar-day-today:active {
    background-color: rgb(80, 180, 225);
}

.calendar-widget .calendar-day-selected {
    border-width: 2px;
    border-color: rgb(96, 205, 255);
}

.calendar-widget .calendar-day-selected:focus {
    border-color: rgb(245, 245, 245);
}

.calendar-focus-footer {
    flex-shrink: 0;

    padding: 16px 20px;

    background-color: rgb(30, 30, 30);

    border-top-width: 1px;
    border-top-color: rgb(26, 26, 26);
}

.calendar-focus-controls {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.calendar-focus-duration {
    flex-direction: row;
    align-items: center;
}

.calendar-widget .calendar-duration-button {
    width: 28px;
    height: 28px;

    border-radius: 14px;
    background-color: rgb(46, 46, 46);
}

.calendar-duration-label {
    min-width: 64px;

    margin: 0;
    padding: 0;

    font-size: 13px;
    -unity-text-align: middle-center;
}

.calendar-widget .calendar-focus-button {
    min-width: 94px;
    height: 32px;

    padding: 0 10px;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    border-radius: 4px;
    border-color: rgb(68, 68, 68);
    background-color: rgb(49, 49, 49);
}

.calendar-focus-label {
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 13px;
}

.calendar-widget .calendar-focus-button:hover {
    background-color: rgb(62, 62, 62);
}

.calendar-widget .calendar-focus-button:active {
    background-color: rgb(42, 42, 42);
}

.calendar-focus-status {
    margin: 8px 0 0;
    padding: 0;

    color: rgb(190, 190, 190);
    font-size: 12px;
    white-space: normal;
}