<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Calendar.uss"/>

    <ui:VisualElement name="DateTimePanel" class="date-time-panel">
        <ui:VisualElement class="calendar-header">
            <ui:VisualElement class="calendar-heading">
                <ui:Label name="CurrentTimeLabel"
                          class="calendar-time"/>

                <ui:Label name="CurrentDateLabel"
                          class="calendar-date"/>
            </ui:VisualElement>

            <ui:Button name="CollapseCalendarButton"
                       tooltip="Collapse calendar"
                       class="calendar-icon-button">
                <ui:Image name="CollapseCalendarIcon"
                          picking-mode="Ignore"
                          class="calendar-icon calendar-collapse-icon"/>
            </ui:Button>
        </ui:VisualElement>

        <ui:ScrollView name="CalendarBody"
                       horizontal-scroller-visibility="Hidden"
                       vertical-scroller-visibility="Auto"
                       class="calendar-body">
            <ui:Label name="CalendarTimezoneLabel"
                      class="calendar-timezone"/>

            <ui:VisualElement class="calendar-month-header">
                <ui:Label name="MonthLabel"
                          class="calendar-month"/>

                <ui:VisualElement class="calendar-navigation">
                    <ui:Button name="PreviousMonthButton"
                               tooltip="Previous month"
                               class="calendar-icon-button">
                        <ui:Image name="PreviousMonthIcon"
                                  picking-mode="Ignore"
                                  class="calendar-icon"/>
                    </ui:Button>

                    <ui:Button name="NextMonthButton"
                               tooltip="Next month"
                               class="calendar-icon-button">
                        <ui:Image name="NextMonthIcon"
                                  picking-mode="Ignore"
                                  class="calendar-icon"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="calendar-weekdays">
                <ui:Label text="Su" class="calendar-weekday"/>
                <ui:Label text="Mo" class="calendar-weekday"/>
                <ui:Label text="Tu" class="calendar-weekday"/>
                <ui:Label text="We" class="calendar-weekday"/>
                <ui:Label text="Th" class="calendar-weekday"/>
                <ui:Label text="Fr" class="calendar-weekday"/>
                <ui:Label text="Sa" class="calendar-weekday"/>
            </ui:VisualElement>

            <ui:VisualElement name="DaysGrid"
                              class="calendar-grid"/>
        </ui:ScrollView>

        <ui:VisualElement class="calendar-focus-footer">
            <ui:VisualElement class="calendar-focus-controls">
                <ui:VisualElement class="calendar-focus-duration">
                    <ui:Button name="DecreaseFocusButton"
                               tooltip="Decrease focus duration"
                               class="calendar-icon-button calendar-duration-button">
                        <ui:Image name="DecreaseFocusIcon"
                                  picking-mode="Ignore"
                                  class="calendar-icon"/>
                    </ui:Button>

                    <ui:Label name="FocusDurationLabel"
                              class="calendar-duration-label"/>

                    <ui:Button name="IncreaseFocusButton"
                               tooltip="Increase focus duration"
                               class="calendar-icon-button calendar-duration-button">
                        <ui:Image name="IncreaseFocusIcon"
                                  picking-mode="Ignore"
                                  class="calendar-icon"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:Button name="StartFocusButton"
                           tooltip="Start focus session"
                           class="calendar-focus-button">
                    <ui:Image name="StartFocusIcon"
                              picking-mode="Ignore"
                              class="calendar-icon"/>

                    <ui:Label name="StartFocusLabel"
                              text="Focus"
                              picking-mode="Ignore"
                              class="calendar-focus-label"/>
                </ui:Button>
            </ui:VisualElement>

            <ui:Label name="FocusStatusLabel"
                      class="calendar-focus-status"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>