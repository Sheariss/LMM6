.taskbar-previews {
    position: absolute;
    padding: 6px;

    background-color: rgba(38, 38, 38, 0.98);
    color: #eeeeee;

    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 9px;

    overflow: hidden;
}

.taskbar-previews__scroll {
    flex-grow: 1;
    min-height: 0;
}

.taskbar-previews__cards {
    flex-direction: row;
    align-items: flex-start;
}

.taskbar-preview-card {
    position: relative;
    height: 156px;
    flex-shrink: 0;

    margin-right: 4px;

    border-radius: 5px;
    overflow: hidden;
}

.taskbar-preview-card__select {
    width: 100%;
    height: 100%;

    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;

    margin: 0;
    padding: 5px;

    background-image: none;
    background-color: transparent;

    border-width: 1px;
    border-color: transparent;
    border-radius: 5px;
}

.taskbar-preview-card__select:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.taskbar-preview-card__select:active {
    background-color: rgba(255, 255, 255, 0.12);
}

.taskbar-preview-card__select:focus {
    border-color: var(--border-focus);
}

.taskbar-preview-card__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;

    min-height: 24px;
    margin-bottom: 5px;
    padding-right: 23px;
}

.taskbar-preview-card__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;

    margin-right: 7px;
}

.taskbar-preview-card__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;

    margin: 0;
    padding: 0;

    color: #eeeeee;
    font-size: 12px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    -unity-text-align: middle-left;
}

.taskbar-preview-card__thumbnail {
    flex-grow: 1;
    flex-basis: 0;

    min-height: 0;
    width: 100%;

    background-color: #1b1b1b;
    border-radius: 3px;

    overflow: hidden;
}

.taskbar-preview-card__close {
    position: absolute;
    right: 5px;
    top: 5px;

    width: 22px;
    height: 22px;

    margin: 0;
    padding: 5px;

    align-items: center;
    justify-content: center;

    background-image: none;
    background-color: transparent;

    border-width: 0;
    border-radius: 3px;

    opacity: 0;
}

.taskbar-preview-card:hover .taskbar-preview-card__close,
.taskbar-preview-card__close:focus {
    opacity: 1;
}

.taskbar-preview-card__close:hover {
    background-color: #c42b1c;
}

.taskbar-preview-card__close:active {
    background-color: #a92318;
}

.taskbar-preview-card__close-icon {
    width: 12px;
    height: 12px;

    background-image: resource("Icons/UI/Close/close_24dp");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #ffffff;
}

.taskbar-previews .unity-scroller__low-button,
.taskbar-previews .unity-scroller__high-button {
    display: none;
}

.taskbar-previews .unity-scroll-view__horizontal-scroller {
    height: 8px;
    min-height: 8px;

    margin-top: 2px;

    background-color: transparent;
}

.taskbar-previews .unity-scroller__slider,
.taskbar-previews .unity-base-slider__drag-container,
.taskbar-previews .unity-base-slider__tracker,
.taskbar-previews .unity-base-slider__dragger-border {
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.taskbar-previews .unity-base-slider__dragger {
    height: 4px;
    min-height: 4px;

    background-image: none;
    background-color: rgba(255, 255, 255, 0.35);

    border-width: 0;
    border-radius: 2px;
}

.taskbar-previews .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.55);
}