.widgets-panel {
    width: 480px;
    max-width: 100%;
    height: 100%;
    min-height: 0;
    padding: 16px;
    background-color: #171c24;
    color: #e3e7ef;
    border-width: 1px;
    border-color: #343d4b;
    border-radius: 16px;
    overflow: hidden;
}

.widgets-panel Label {
    margin: 0;
    padding: 0;
}

.widgets-panel__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 16px;
}

.widgets-panel__title {
    flex-grow: 1;
    font-size: 22px;
    -unity-font-style: bold;
}

.widgets-panel__button {
    min-height: 30px;
    padding: 4px 12px;
    margin-left: 6px;
    background-color: #293446;
    color: #d7e5ff;
    border-width: 1px;
    border-color: #40516b;
    border-radius: 10px;
}

.widgets-panel__button:hover {
    background-color: #354660;
}

.widgets-panel__button:disabled {
    opacity: 0.45;
}

.widgets-picker {
    flex-shrink: 0;
    padding: 12px;
    margin-bottom: 12px;
    border-radius: 12px;
    background-color: #222b38;
}

.widgets-picker__preview {
    height: 96px;
    margin-top: 10px;
    margin-bottom: 10px;
}

.widgets-picker__description {
    white-space: normal;
    font-size: 12px;
    color: #b9c4d4;
    margin-bottom: 12px;
}

.widgets-panel__status {
    white-space: normal;
    color: #ffb4ab;
    margin-bottom: 10px;
}

.widgets-panel__scroll {
    flex-grow: 1;
    min-height: 0;
}

.widgets-panel__empty {
    white-space: normal;
    padding: 16px;
    color: #9daabb;
}

.widgets-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.widgets-panel .widget-card {
    flex-shrink: 0;
    margin-right: 12px;
    margin-bottom: 12px;
    background-color: #222c3b;
    border-width: 1px;
    border-color: #354256;
    border-radius: 14px;
    overflow: hidden;
}

.widgets-panel .widget-card__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 36px;
    padding-left: 12px;
    padding-right: 6px;
}

.widgets-panel .widget-card__icon {
    width: 18px;
    height: 18px;
    margin-right: 7px;
}

.widgets-panel .widget-card__title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    -unity-font-style: bold;
}

.widgets-panel .widget-card__button {
    min-width: 26px;
    height: 26px;
    margin-left: 4px;
    padding: 2px 7px;
    border-width: 0;
    border-radius: 8px;
    background-color: transparent;
    color: #c8d8ed;
}

.widgets-panel .widget-card__button:hover {
    background-color: #3a4a61;
}

.widgets-panel .widget-card__content {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

/* Slim scrollbars, matching the existing Contacts approach. */

.widgets-panel .unity-scroll-view__vertical-scroller {
    width: 10px;
    min-width: 10px;
    margin: 3px;
    padding: 0;
    background-color: transparent;
    background-image: none;
    border-width: 0;
}

.widgets-panel .unity-scroll-view__horizontal-scroller {
    height: 10px;
    min-height: 10px;
    margin: 3px;
    padding: 0;
    background-color: transparent;
    background-image: none;
    border-width: 0;
}

.widgets-panel .unity-scroller__low-button,
.widgets-panel .unity-scroller__high-button {
    display: none;
}

.widgets-panel .unity-scroller__slider {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    background-color: transparent;
    background-image: none;
    border-width: 0;
}

.widgets-panel .unity-base-slider__drag-container,
.widgets-panel .unity-base-slider__tracker,
.widgets-panel .unity-base-slider__dragger-border {
    background-color: transparent;
    background-image: none;
    border-width: 0;
}

.widgets-panel .unity-base-slider__dragger {
    background-image: none;
    background-color: rgba(255, 255, 255, 0.30);
    border-width: 0;
    border-radius: 3px;
}

.widgets-panel .unity-scroll-view__vertical-scroller
.unity-base-slider__dragger {
    width: 6px;
    min-width: 6px;
}

.widgets-panel .unity-scroll-view__horizontal-scroller
.unity-base-slider__dragger {
    height: 6px;
    min-height: 6px;
}

.widgets-panel .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.50);
}