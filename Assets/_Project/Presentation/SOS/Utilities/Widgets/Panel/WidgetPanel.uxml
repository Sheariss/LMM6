<ui:UXML xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">

    <Style src="WidgetPanel.uss"/>

    <ui:VisualElement name="WidgetsPanel"
                      class="widgets-panel">

        <ui:VisualElement class="widgets-panel__header">
            <ui:Label text="Widgets"
                      class="widgets-panel__title"/>

            <ui:Button name="WidgetsAddButton"
                       text="+ Add"
                       class="widgets-panel__button"/>

            <ui:Button name="WidgetsCloseButton"
                       text="×"
                       tooltip="Close widgets"
                       class="widgets-panel__button"/>
        </ui:VisualElement>

        <ui:VisualElement name="WidgetPicker"
                          class="widgets-picker">

            <ui:DropdownField name="WidgetLayoutField"
                              label="Layout"/>

            <ui:Image name="WidgetPreview"
                      class="widgets-picker__preview"/>

            <ui:Label name="WidgetDescription"
                      class="widgets-picker__description"/>

            <ui:Button name="WidgetConfirmAddButton"
                       text="Add widget"
                       class="widgets-panel__button"/>
        </ui:VisualElement>

        <ui:Label name="WidgetsStatus"
                  class="widgets-panel__status"/>

        <ui:ScrollView mode="VerticalAndHorizontal"
                       class="widgets-panel__scroll">

            <ui:Label name="WidgetsEmptyState"
                      text="No widgets yet. Choose Add to get started."
                      class="widgets-panel__empty"/>

            <ui:VisualElement name="WidgetGrid"
                              class="widgets-grid"/>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>