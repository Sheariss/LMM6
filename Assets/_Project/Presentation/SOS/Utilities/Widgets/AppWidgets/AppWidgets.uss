.widget.weather-widget {
    background-color: #202e43;
}

.widget.weather-widget:hover:enabled {
    background-color: #273850;
}

.widget.weather-widget:active:enabled {
    background-color: #1b293d;
}

.weather-widget .weather-widget__location {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.weather-widget__current {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.weather-widget__temperature {
    font-size: 44px;
    color: #e0ebff;
}

.weather-widget__condition {
    font-size: 12px;
    color: #d5e2f4;
}

.weather-widget__range {
    font-size: 10px;
    color: #a6bad4;
}

.weather-widget__artwork {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
}

.weather-widget .weather-widget__summary {
    white-space: normal;
    font-size: 10px;
    color: #c8d8ed;
    margin-top: 8px;
    margin-bottom: 8px;
}

.weather-widget__forecast {
    flex-direction: row;
    flex-grow: 1;
    min-height: 76px;
}

.weather-widget__day {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: space-between;
    margin-right: 3px;
    padding: 5px 2px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.05);
}

.weather-widget__day-name {
    font-size: 10px;
}

.weather-widget__day-icon {
    width: 26px;
    height: 26px;
}

.weather-widget__day-condition {
    font-size: 8px;
    white-space: normal;
}

.weather-widget__day-temperature {
    font-size: 12px;
    -unity-font-style: bold;
}

.weather-widget__night-temperature {
    font-size: 10px;
    color: #a6bad4;
}

.clock-widget__content {
    justify-content: center;
}

.clock-widget__date {
    font-size: 13px;
    color: var(--text-secondary);
}

.clock-widget__time {
    font-size: 60px;
    color: var(--text-primary);
}

.clock-widget__timezone {
    font-size: 11px;
    color: var(--text-muted);
    white-space: normal;
}

.calendar-widget .calendar-widget__date {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 10px;
}

.calendar-widget__event {
    flex-shrink: 0;
    min-height: 58px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);
}

.calendar-widget__event-title {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.calendar-widget__event-time {
    font-size: 11px;
    color: var(--text-secondary);
}

.calendar-widget__event-location {
    font-size: 10px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.calendar-widget__empty {
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
}