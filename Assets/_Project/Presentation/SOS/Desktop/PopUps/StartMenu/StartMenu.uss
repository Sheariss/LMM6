.start-menu {
    display: none;
    position: absolute;
    bottom: var(--space-3);
    align-self: center;

    width: 780px;
    max-width: 96%;
    height: 740px;
    max-height: 94%;

    flex-direction: column;
    overflow: hidden;

    background-color: var(--bg-secondary);
    color: var(--text-primary);

    border-width: var(--border-thin);
    border-color: var(--border-primary);
    border-radius: var(--radius-2xl);
}

.start-menu-search {
    height: 48px;
    min-height: 48px;
    max-height: 48px;

    flex-shrink: 0;
    flex-direction: row;
    align-items: center;

    margin: var(--space-5);
    margin-bottom: var(--space-3);
    padding-left: var(--space-4);
    padding-right: var(--space-4);

    background-color: var(--bg-tertiary);

    border-width: var(--border-thin);
    border-color: var(--border-secondary);
    border-radius: 24px;
}

.start-menu-search-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: var(--space-3);

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--accent-hover);
}

.start-menu-search-input {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    height: 40px;
    justify-content: center;
}

.start-menu-search-field {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.start-menu-search-field .unity-text-field__input {
    min-height: 40px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;

    background-color: transparent;
    color: var(--text-primary);
    border-width: 0;

    font-size: var(--text-sm);
}

.start-menu-search-field .unity-text-field__input:focus {
    border-bottom-width: var(--border-medium);
    border-bottom-color: var(--border-focus);
}

.start-menu-search-placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    -unity-text-align: middle-left;
}

.start-menu-content,
.start-menu-panel,
.start-menu-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.start-menu-content {
    position: relative;
    flex-basis: 0;
}

.start-menu-panel {
    flex-direction: column;
}

.start-menu-section {
    flex-shrink: 0;

    margin-left: var(--space-5);
    margin-right: var(--space-5);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
}

.start-menu-section-header {
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    margin-bottom: var(--space-3);
}

.start-menu-heading {
    margin: 0;

    color: var(--text-primary);
    font-size: var(--text-sm);
    -unity-font-style: bold;
}

.start-menu-section-button {
    height: 32px;
    min-height: 32px;
    max-height: 32px;

    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;

    margin: 0;
    margin-left: var(--space-3);

    padding-left: var(--space-3);
    padding-right: var(--space-3);
    padding-top: 0;
    padding-bottom: 0;

    background-color: var(--bg-tertiary);
    color: var(--text-primary);

    border-width: var(--border-thin);
    border-color: var(--border-primary);
    border-radius: 16px;
}

.start-menu-button-text,
.start-menu-view-prefix {
    margin: 0;

    color: var(--text-primary);
    font-size: var(--text-xs);
    -unity-text-align: middle-left;
}

.start-menu-view-prefix {
    margin-right: var(--space-1);
    color: var(--text-secondary);
}

.start-menu-chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-left: var(--space-2);

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-secondary);
}

.start-menu-chevron-up {
    rotate: 180deg;
}

.start-menu-chevron-right {
    rotate: -90deg;
}

.start-menu-empty {
    margin: 0;
    padding: var(--space-4);

    background-color: var(--bg-tertiary);
    color: var(--text-muted);
    border-radius: var(--radius-lg);

    white-space: normal;
    font-size: var(--text-sm);
}

.start-menu-panel-empty {
    margin-left: var(--space-5);
    margin-right: var(--space-5);
}

.start-menu-app-grid,
.start-menu-recent-grid,
.start-menu-category-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.start-menu-app-button,
.start-menu-document-button,
.start-menu-list-button {
    margin: 0;

    background-color: transparent;
    color: var(--text-primary);

    border-width: var(--border-medium);
    border-color: transparent;
    border-radius: var(--radius-lg);
}

.start-menu-app-button {
    width: 16.66%;
    min-height: 92px;

    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: var(--space-2);
}

.start-menu-app-icon,
.start-menu-document-icon,
.start-menu-category-icon,
.start-menu-list-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;

    -unity-background-scale-mode: scale-to-fit;
}

.start-menu-app-icon {
    margin-bottom: var(--space-2);
}

.start-menu-app-name {
    max-width: 100%;
    margin: 0;

    color: var(--text-primary);
    white-space: normal;
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
}

.start-menu-document-button {
    width: 33.33%;
    min-height: 72px;

    flex-shrink: 0;
    flex-direction: row;
    align-items: center;

    padding: var(--space-3);
}

.start-menu-document-list,
.start-menu-search-results {
    flex-direction: column;

    margin-left: var(--space-5);
    margin-right: var(--space-5);
    margin-bottom: var(--space-4);
}

.start-menu-document-list .start-menu-document-button {
    width: 100%;
    min-height: 64px;
}

.start-menu-document-icon,
.start-menu-list-icon {
    margin-right: var(--space-3);
}

.start-menu-document-details {
    flex-grow: 1;
    min-width: 0;
}

.start-menu-document-name,
.start-menu-list-name {
    margin: 0;
    color: var(--text-primary);

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.start-menu-document-name {
    font-size: var(--text-xs);
}

.start-menu-document-list .start-menu-document-name {
    font-size: var(--text-sm);
}

.start-menu-document-date {
    margin: 0;
    margin-top: var(--space-1);

    color: var(--text-muted);
    font-size: var(--text-xs);
}

.start-menu-category-item {
    width: 25%;
    flex-shrink: 0;
    padding: var(--space-2);
}

.start-menu-category-card {
    min-height: 132px;
    align-items: stretch;

    margin: 0;
    padding: var(--space-3);

    background-color: var(--bg-tertiary);

    border-width: var(--border-medium);
    border-color: transparent;
    border-radius: var(--radius-xl);
}

.start-menu-category-preview {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: center;
}

.start-menu-category-icon-slot {
    width: 50%;
    height: 48px;

    align-items: center;
    justify-content: center;
}

.start-menu-category-name {
    margin: 0;
    margin-top: var(--space-2);

    color: var(--text-secondary);
    white-space: normal;
    font-size: var(--text-xs);
    -unity-text-align: upper-center;
}

.start-menu-category-group {
    width: 100%;
    margin-bottom: var(--space-4);
}

.start-menu-category-group-heading,
.start-menu-letter-heading {
    margin: 0;

    color: var(--accent-hover);
    font-size: var(--text-sm);
    -unity-font-style: bold;
}

.start-menu-category-group-heading {
    margin-bottom: var(--space-2);
}

.start-menu-alphabetical-list {
    flex-direction: column;
}

.start-menu-letter-group {
    margin-bottom: var(--space-3);
}

.start-menu-letter-heading {
    padding: var(--space-2);
    padding-left: var(--space-3);
}

.start-menu-list-button {
    min-height: 48px;
    flex-direction: row;
    align-items: center;

    padding-left: var(--space-3);
    padding-right: var(--space-3);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
}

.start-menu-list-name {
    flex-grow: 1;
    min-width: 0;
    font-size: var(--text-sm);
}

.start-menu-panel-header {
    min-height: 48px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;

    margin-left: var(--space-5);
    margin-right: var(--space-5);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
}

.start-menu-panel-heading {
    margin: 0;

    color: var(--text-primary);
    font-size: var(--text-lg);
    -unity-font-style: bold;
}

.start-menu-panel-header .start-menu-icon-button {
    margin-right: var(--space-3);
}

.start-menu-footer {
    min-height: 72px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding: var(--space-4);
    padding-left: var(--space-5);
    padding-right: var(--space-5);

    background-color: var(--window-footer);

    border-top-width: var(--border-thin);
    border-top-color: var(--border-primary);
}

.start-menu-profile {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.start-menu-avatar {
    width: 32px;
    min-width: 32px;
    max-width: 32px;

    height: 32px;
    min-height: 32px;
    max-height: 32px;

    flex-grow: 0;
    flex-shrink: 0;
    margin-right: var(--space-3);

    background-color: var(--surface-active);
    border-radius: 16px;
    overflow: hidden;
}

.start-menu-profile-name {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;

    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--text-sm);
}

.start-menu-icon-button {
    width: 40px;
    min-width: 40px;
    max-width: 40px;

    height: 40px;
    min-height: 40px;
    max-height: 40px;

    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;

    margin: 0;
    padding: 0;

    background-color: transparent;

    border-width: var(--border-thin);
    border-color: transparent;
    border-radius: 20px;
}

.start-menu-action-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-primary);
}

.start-menu-popup {
    position: absolute;
    width: 188px;
    padding: var(--space-1);

    background-color: var(--bg-tertiary);

    border-width: var(--border-thin);
    border-color: var(--border-secondary);
    border-radius: var(--radius-lg);
}

.start-menu-power-popup {
    right: var(--space-5);
    bottom: 88px;
}

.start-menu-view-popup {
    right: var(--space-5);
    top: 0;
}

.start-menu-popup-item {
    min-height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    margin: 0;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);

    background-color: transparent;
    color: var(--text-primary);

    border-width: var(--border-thin);
    border-color: transparent;
    border-radius: var(--radius-md);

    font-size: var(--text-sm);
    -unity-text-align: middle-left;
}

.start-menu-popup-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-right: var(--space-3);

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-primary);
}

.start-menu-popup-text {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-sm);
}

.start-menu-section-button:hover,
.start-menu-icon-button:hover,
.start-menu-app-button:hover,
.start-menu-document-button:hover,
.start-menu-list-button:hover,
.start-menu-popup-item:hover {
    background-color: var(--surface-hover);
}

.start-menu-section-button:active,
.start-menu-icon-button:active,
.start-menu-app-button:active,
.start-menu-document-button:active,
.start-menu-list-button:active,
.start-menu-popup-item:active {
    background-color: var(--surface-active);
}

.start-menu-category-card:hover {
    background-color: var(--surface-active);
}

.start-menu-category-card:active {
    background-color: var(--surface-hover);
}

.start-menu-section-button:focus,
.start-menu-icon-button:focus,
.start-menu-app-button:focus,
.start-menu-document-button:focus,
.start-menu-list-button:focus,
.start-menu-category-card:focus,
.start-menu-popup-item:focus {
    border-color: var(--border-focus);
}

.start-menu-hidden {
    display: none;
}

.start-menu-search-field {
    --unity-cursor-color: var(--text-primary);
    --unity-selection-color: var(--accent-primary);
}

.start-menu-search-field .unity-text-field__input {
    --unity-cursor-color: var(--text-primary);
    --unity-selection-color: var(--accent-primary);

    color: var(--text-primary);
    -unity-text-align: middle-left;
}

.start-menu-search-field
.unity-text-field__input.unity-base-text-field__input--placeholder {
    color: var(--text-muted);
}

.start-menu-heading {
    min-height: 24px;
    flex-shrink: 0;

    padding-top: 2px;
    padding-bottom: 2px;

    overflow: visible;
    -unity-text-align: middle-left;
}

.start-menu-panel-heading {
    min-height: 32px;
    flex-shrink: 0;

    padding-top: 3px;
    padding-bottom: 3px;

    overflow: visible;
    -unity-text-align: middle-left;
}

.start-menu-panel-header {
    min-height: 48px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.start-menu-document-button {
    justify-content: flex-start;
    -unity-text-align: middle-left;
}

.start-menu-document-details {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;

    align-items: stretch;
    justify-content: center;
}

.start-menu-document-name,
.start-menu-document-date {
    -unity-text-align: middle-left;
}

.start-menu-document-button-expanded {
    width: 100%;
    min-height: 72px;

    flex-direction: row;
    align-items: center;

    padding-left: var(--space-3);
    padding-right: var(--space-4);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
}

.start-menu-document-button-expanded .start-menu-document-name {
    min-height: 22px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: var(--text-sm);
}

.start-menu-document-path {
    min-width: 0;
    margin: 0;
    margin-top: var(--space-1);

    color: var(--text-muted);

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    font-size: var(--text-xs);
    -unity-text-align: middle-left;
}

.start-menu-document-date-column {
    width: 112px;
    min-width: 112px;

    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;

    margin: 0;
    margin-left: var(--space-4);

    -unity-text-align: middle-right;
}

.start-menu-view-popup {
    width: 152px;
}

.start-menu-view-popup .start-menu-popup-item {
    min-height: 36px;
    justify-content: flex-start;

    padding-left: var(--space-2);
    padding-right: var(--space-3);
}

.start-menu-view-check {
    width: 16px;
    height: 16px;
    flex-shrink: 0;

    margin-right: var(--space-2);
    opacity: 0;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-primary);
}

.start-menu-selected .start-menu-view-check {
    opacity: 1;
}

.start-menu-view-popup .start-menu-popup-text {
    flex-grow: 1;
    -unity-text-align: middle-left;
}


.start-menu .start-menu-scroll .unity-scroll-view__vertical-scroller {
    width: 10px;
    min-width: 10px;

    margin: 3px;
    padding: 0;

    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.start-menu .start-menu-scroll .unity-scroller__low-button,
.start-menu .start-menu-scroll .unity-scroller__high-button {
    display: none;
}

.start-menu .start-menu-scroll .unity-scroller__slider {
    flex-grow: 1;

    margin: 0;
    padding: 0;

    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.start-menu .start-menu-scroll
.unity-scroller__slider .unity-base-slider__drag-container,
.start-menu .start-menu-scroll
.unity-scroller__slider .unity-base-slider__tracker,
.start-menu .start-menu-scroll
.unity-scroller__slider .unity-base-slider__dragger-border {
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.start-menu .start-menu-scroll
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    width: 5px;
    min-width: 5px;
    margin-left: 2px;

    background-image: none;
    background-color: rgba(255, 255, 255, 0.35);

    border-width: 0;
    border-radius: 2.5px;
}

.start-menu .start-menu-scroll
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.55);
}

.start-menu .start-menu-scroll
.unity-scroll-view__vertical-scroller .unity-base-slider__dragger:active {
    background-color: rgba(255, 255, 255, 0.75);
}