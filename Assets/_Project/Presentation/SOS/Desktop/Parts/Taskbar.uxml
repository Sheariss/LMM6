<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3#ATLAS"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Desktop/Parts/Taskbar.uss?fileID=7433441132597879392&amp;guid=55ca6db6a420cc540819dbb8ef290ec3&amp;type=3#Taskbar"/>

      <ui:VisualElement name="DesktopTaskbar" class="taskbar">

        <ui:GroupBox name="WidgetGroup" class="taskbar-group">
            <ui:Button name="WidgetsButton"
                       text="Widgets"
                       tooltip="Open widgets"
                       class="taskbar-button taskbar-widgets"/>
        </ui:GroupBox>

        <ui:Button name="StartButton"
                   text="⊞"
                   tooltip="Start"
                   class="taskbar-button taskbar-start"/>

        <ui:VisualElement name="TaskbarSearchContainer"
                          class="taskbar-search">
            <ui:VisualElement picking-mode="Ignore"
                              class="taskbar-icon taskbar-search-icon"/>
            <ui:TextField name="TaskbarSearchField"
                          label="Search"
                          tooltip="Search apps and files"
                          class="taskbar-search-field"/>
        </ui:VisualElement>

        <!-- Populate with instances of your existing app button template. -->
        <ui:GroupBox name="AppGroup"
                     class="taskbar-group taskbar-apps"/>

        <ui:GroupBox name="StatusGroup"
                     class="taskbar-group taskbar-status">

            <ui:Button name="HiddenIconsButton"
                       text="⌃"
                       tooltip="Show hidden icons"
                       class="taskbar-button taskbar-status-button"/>

            <ui:Button name="AssistantButton"
                       text="✦"
                       tooltip="Open assistant"
                       class="taskbar-button taskbar-status-button taskbar-assistant"/>

            <ui:VisualElement class="taskbar-group taskbar-quick-settings">
                <ui:Button name="NetworkButton"
                           text="Net"
                           tooltip="Network"
                           class="taskbar-button taskbar-status-button"/>

                <ui:Button name="VolumeButton"
                           text="Vol"
                           tooltip="Volume"
                           class="taskbar-button taskbar-status-button"/>
            </ui:VisualElement>

            <ui:Button name="DateTimeButton"
                       tooltip="Open calendar"
                       class="taskbar-button taskbar-clock">
                <ui:Label name="TimeLabel"
                          text="12:00 PM"
                          picking-mode="Ignore"
                          class="taskbar-time"/>
                <ui:Label name="DateLabel"
                          text="08/10/2026"
                          picking-mode="Ignore"
                          class="taskbar-date"/>
            </ui:Button>

            <ui:Button name="NotificationsButton"
                       tooltip="Notifications"
                       class="taskbar-button taskbar-status-button">
                <ui:VisualElement picking-mode="Ignore"
                                  class="taskbar-icon taskbar-notifications-icon"/>
                <ui:VisualElement name="NotificationIndicator"
                                  picking-mode="Ignore"
                                  class="taskbar-notification-dot"/>
            </ui:Button>

        </ui:GroupBox>
    </ui:VisualElement>

</ui:UXML>
