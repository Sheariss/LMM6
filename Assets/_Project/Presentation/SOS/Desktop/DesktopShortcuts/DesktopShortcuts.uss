.shortcut-button{
    width: 100%;
    height: 100%;
	border-radius: 6px;
	align-items: center;
	justify-content: space-evenly;
}

.shortcut-arrow{
	height: 18px;
	width: 18px;
	-unity-background-image-tint-color: var(--accent-primary);
}

.shortcut-square{
	height: 24px;
	width: 24px;
	background-color: var(--true-white);
	border-radius: 6px;
	align-items: center;
	justify-content: center;
	border-width: 1px;
	border-color:  var(--accent-primary);
}

.app-icon{
	height: 96px;
	width: 96px;
	align-items: flex-start;
	justify-content: flex-end;
}

.app-name {
    width: 100%;
    min-width: 0;
    flex-shrink: 0;

    font-size: 12px;
    -unity-text-align: middle-center;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.app-name-shadow{
	text-shadow: 1px 3px 30px var(--true-black);
}

Button.shortcut-button {
    background-color: transparent;

    transition-property: background-color;
    transition-duration: 0.1s;
}

Button.shortcut-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

Button.shortcut-button:active {
    background-color: rgba(255, 255, 255, 0.14);
}