<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Taskbar" src="project://database/Assets/_Project/Presentation/SOS/Desktop/Taskbar/Taskbar.uxml?fileID=9197481963319205126&amp;guid=7f1adb15b8cce3e4f911accd4015d830&amp;type=3#Taskbar"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Colors.uss?fileID=7433441132597879392&amp;guid=8dac24df6972d5a4b92f92dcf1ce83a2&amp;type=3#Global-Colors"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/Global-Tokens.uss?fileID=7433441132597879392&amp;guid=dadbf6dc3eccd0d45a1533ff4081471d&amp;type=3#Global-Tokens"/>
    <Style src="project://database/Assets/_Project/Presentation/Tokens/ATLAS.uss?fileID=7433441132597879392&amp;guid=7fc1c24c6bff61548bd2f989f6ca2048&amp;type=3#ATLAS"/>
    <Style src="project://database/Assets/_Project/Presentation/SOS/Desktop/Desktop.uss?fileID=7433441132597879392&amp;guid=43b9bcfe73e62c64b8f753a3d4815e14&amp;type=3#Desktop"/>
    <ui:VisualElement name="DesktopRoot" class="fullscreen desktop-root">
        <ui:VisualElement name="DesktopWorkspace" class="desktop-workspace">
            <ui:Image name="BackgroundLayer" class="desktop-layer desktop-background" style="background-image: resource(&quot;Wallpapers/guest-wallpaper&quot;);"/>
            <ui:VisualElement name="ShortcutLayer" class="desktop-layer desktop-shortcuts">
                <ui:VisualElement name="ShortcutGrid" class="desktop-shortcut-grid"/>
            </ui:VisualElement>
            <ui:VisualElement name="WindowLayer" class="desktop-layer desktop-windows"/>
        </ui:VisualElement>
        <ui:Instance template="Taskbar" name="Taskbar"/>
    </ui:VisualElement>
</ui:UXML>
