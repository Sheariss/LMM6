.taskbar-pinned-root {
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: center;
}

.taskbar-button.taskbar-pinned-button {
    height: 50px;
    width: 50px;

    border-radius: 6px;
    border-width: 0;

    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;

    background-color: transparent;
}

.taskbar-pinned-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.taskbar-pinned-button.is-focused {
    background-color: rgba(255, 255, 255, 0.12);
}

.taskbar-pinned-button .app-icon {
    height: 32px;
    width: 32px;
    flex-shrink: 0;

    -unity-image-size: contain;
    -unity-background-image-tint-color: white;
}

.taskbar-pinned-button .window-dot {
    height: 2px;
    width: 4px;
    flex-shrink: 0;

    background-color: var(--desktop-taskbar-border);
    border-radius: 1px;

    /* Reserve space so the icon stays still. */
    visibility: hidden;
}

.taskbar-pinned-button.is-open .window-dot {
    visibility: visible;
}

.taskbar-pinned-button.is-focused .window-dot {
    visibility: visible;
    width: 16px;
    background-color: var(--accent-primary);
}