/* ================================================================
   CREDITS
   ================================================================ */

.credits-root {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: var(--bg-primary);
    color: var(--text-primary);
}

/* ================================================================
   BACKGROUND
   ================================================================ */

.credits-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.credits-background-glow {
    position: absolute;
    width: 760px;
    height: 760px;
    right: -280px;
    top: -340px;

    border-radius: 380px;

    background-color: rgba(255, 205, 40, 0.035);
}

.credits-background-grid {
    position: absolute;
    left: 36px;
    right: 36px;
    top: 100px;
    bottom: 0;

    border-left-width: 1px;
    border-right-width: 1px;

    border-left-color: rgba(255, 255, 255, 0.025);
    border-right-color: rgba(255, 255, 255, 0.025);
}

/* ================================================================
   HEADER
   ================================================================ */

.credits-header {
    height: 88px;
    min-height: 88px;

    padding-left: 40px;
    padding-right: 40px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    background-color: rgba(10, 13, 18, 0.92);
}

.credits-header-left {
    flex-direction: column;
    justify-content: center;
}

.credits-header-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.credits-brand {
    color: var(--accent-primary);

    font-size: 18px;
    -unity-font-style: bold;

    letter-spacing: 5px;
}

.credits-header-subtitle {
    margin-top: 3px;

    color: var(--text-muted);

    font-size: 10px;
    letter-spacing: 2px;
}

.credits-header-page {
    color: var(--text-muted);

    font-size: 11px;
    -unity-font-style: bold;

    letter-spacing: 3px;
}

.credits-header-divider {
    height: 1px;
    min-height: 1px;

    background-color: var(--border-primary);
}

/* ================================================================
   SCROLL VIEW
   ================================================================ */

.credits-scroll {
    flex-grow: 1;

    background-color: transparent;

    border-width: 0;
}

.credits-scroll > .unity-scroll-view__content-viewport {
    flex-grow: 1;

    overflow: hidden;
}

.credits-scroll > .unity-scroll-view__content-container {
    flex-grow: 0;
}

.credits-scroll .unity-scroller {
    display: none;
}

.credits-scroll:focus {
    border-width: 0;
}

/* ================================================================
   GENERATED CONTENT CONTAINER
   ================================================================ */

.credits-content {
    width: 760px;
    max-width: 90%;

    align-self: center;

    padding-top: 120px;
    padding-bottom: 220px;
}

/* ================================================================
   HERO
   ================================================================ */

.credits-hero {
    align-items: center;

    margin-bottom: 110px;
}

.credits-hero-kicker {
    margin-bottom: 18px;

    color: var(--accent-primary);

    font-size: 11px;
    -unity-font-style: bold;

    letter-spacing: 4px;

    -unity-text-align: middle-center;
}

.credits-hero-title {
    color: var(--text-primary);

    font-size: 46px;
    -unity-font-style: bold;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

.credits-hero-title--accent {
    color: var(--accent-primary);
}

.credits-hero-school {
    margin-top: 30px;

    color: var(--text-secondary);

    font-size: 15px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

.credits-hero-detail {
    margin-top: 7px;

    color: var(--text-muted);

    font-size: 12px;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

/* ================================================================
   CREDIT SECTIONS
   ================================================================ */

.credits-section {
    margin-bottom: 90px;
}

.credits-section-title {
    margin-bottom: 34px;
    padding-bottom: 12px;

    border-bottom-width: 1px;
    border-bottom-color: var(--border-primary);

    color: var(--accent-primary);

    font-size: 11px;
    -unity-font-style: bold;

    letter-spacing: 3px;
}

/* ================================================================
   CREDIT ENTRIES
   ================================================================ */

.credits-entry {
    margin-bottom: 25px;

    align-items: center;
}

.credits-entry--featured {
    margin-top: 8px;
    margin-bottom: 40px;
}

.credits-name {
    color: var(--text-primary);

    font-size: 18px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

.credits-role {
    margin-top: 5px;

    color: var(--text-muted);

    font-size: 12px;

    -unity-text-align: middle-center;
}

.credits-role--joke {
    color: var(--text-secondary);

    -unity-font-style: italic;
}

.credits-entry--featured .credits-name {
    color: var(--accent-primary);

    font-size: 23px;

    letter-spacing: 1px;
}

.credits-entry--featured .credits-role {
    color: var(--text-secondary);

    font-size: 13px;
}

/* ================================================================
   SPECIAL THANKS
   ================================================================ */

.credits-special-thanks {
    align-items: center;
}

.credits-special-name {
    margin-top: 24px;

    color: var(--text-primary);

    font-size: 16px;
    -unity-font-style: bold;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

.credits-special-description {
    margin-top: 5px;
    margin-bottom: 16px;

    color: var(--text-muted);

    font-size: 12px;

    -unity-text-align: middle-center;
}

/* ================================================================
   ENDING
   ================================================================ */

.credits-ending {
    min-height: 320px;

    align-items: center;
    justify-content: center;
}

.credits-ending-title {
    color: var(--text-primary);

    font-size: 24px;
    -unity-font-style: bold;

    letter-spacing: 3px;

    -unity-text-align: middle-center;
}

.credits-ending-subtitle {
    margin-top: 12px;

    color: var(--accent-primary);

    font-size: 11px;
    -unity-font-style: bold;

    letter-spacing: 4px;

    -unity-text-align: middle-center;
}

.credits-ending-meta {
    margin-top: 48px;

    color: var(--text-muted);

    font-size: 10px;

    letter-spacing: 3px;

    -unity-text-align: middle-center;
}

/* ================================================================
   VIEWPORT FADES
   ================================================================ */

.credits-top-fade {
    position: absolute;

    left: 0;
    right: 0;
    top: 89px;

    height: 70px;

    background-color: rgba(10, 13, 18, 0.72);
}

.credits-bottom-fade {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 110px;

    background-color: rgba(10, 13, 18, 0.82);
}

/* ================================================================
   CONTROLS
   ================================================================ */

.credits-controls {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 72px;

    align-items: center;
    justify-content: center;
}

.credits-controls-inner {
    height: 100%;

    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.credits-control-group {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.credits-control-divider {
    width: 1px;
    height: 22px;

    margin-left: 24px;
    margin-right: 24px;

    background-color: var(--border-primary);
}

/* ================================================================
   KEYCAPS
   ================================================================ */

.credits-key {
    min-width: 38px;
    height: 26px;

    padding-left: 8px;
    padding-right: 8px;

    margin-right: 9px;

    align-items: center;
    justify-content: center;

    background-color: var(--surface-primary);

    border-width: 1px;
    border-color: var(--border-secondary);

    border-radius: 4px;
}

.credits-key-label {
    padding: 0px;
    margin: 0px;
    color: var(--text-secondary);

    font-size: 9px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

.credits-control-label {
    color: var(--text-muted);

    font-size: 10px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-left;
}

/* ================================================================
   FAST FORWARD ACTIVE CONTROL STATE
   ================================================================ */

.credits-controls--fast-forward .credits-key {
    background-color: var(--accent-primary);

    border-color: var(--accent-primary);
}

.credits-controls--fast-forward .credits-key-label {
    color: var(--text-inverse);
}

.credits-controls--fast-forward
.credits-control-group:first-child
.credits-control-label {
    color: var(--text-primary);
}

/* ================================================================
   FAST FORWARD INDICATOR
   ================================================================ */

.credits-fast-forward-indicator {
    position: absolute;

    right: 40px;
    bottom: 92px;

    height: 42px;

    padding-left: 13px;
    padding-right: 13px;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    background-color: var(--surface-primary);

    border-width: 1px;
    border-color: var(--border-primary);

    border-radius: 4px;

    display: none;
}

.credits-fast-forward-glyph {
    width: 18px;
    height: 18px;

    margin-right: 8px;

    -unity-background-scale-mode: scale-to-fit;

    /*
     * Assign the actual fast-forward SVG/texture here once the
     * project glyph asset exists.
     *
     * Example:
     *
     * background-image:
     *     url("project://database/Assets/_Project/Presentation/Glyphs/Actions/FastForward.svg");
     */
}

.credits-fast-forward-value {
    color: var(--accent-primary);

    font-size: 12px;
    -unity-font-style: bold;

    letter-spacing: 1px;
}

/* ================================================================
   OPTIONAL ACTIVE INDICATOR CLASS

   This gives us the option to toggle visibility using a USS class
   instead of setting DisplayStyle directly from CreditsView.
   ================================================================ */

.credits-fast-forward-indicator--visible {
    display: flex;
}