/* ================================================================
   CREDITS
   ================================================================ */

.credits-root {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: var(--bg-primary);
    color: white;
}

/* ================================================================
   BACKGROUND
   ================================================================ */

.credits-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.credits-background-glow-right {
    position: absolute;
    width: 900px;
    height: 900px;
    right: -360px;
    top: -420px;
    background-color:transparent;
}


.credits-background-glow-center {
    position: absolute;
    width: 900px;
    height: 900px;
    align-self: center;
    background-color: transparent;
}

.credits-background-glow-left {
    position: absolute;
    width: 900px;
    height: 900px;
    left: -360px;
    bottom: -420px;
    background-color:transparent;
}

.credits-background-grid {
    position: absolute;
    left: 36px;
    right: 36px;
    top: 100px;
    bottom: 0;

    border-left-width: 1px;
    border-right-width: 1px;

    border-left-color: rgba(255, 255, 255, 0.018);
    border-right-color: rgba(255, 255, 255, 0.018);
}

/* ================================================================
   HEADER
   ================================================================ */

.credits-header {
    height: 88px;
    min-height: 88px;

    padding-left: 40px;
    padding-right: 40px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    background-color: rgba(10, 13, 18, 0.94);
}

.credits-header-left {
    flex-direction: column;
    justify-content: center;
}

.credits-header-right {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.credits-brand {
    color: white;

    font-size: 18px;
    -unity-font-style: bold;

    letter-spacing: 5px;
}

.credits-header-subtitle {
    margin-top: 3px;

    color: white;

    font-size: 11px;

    letter-spacing: 2px;
}

.credits-header-page {
    color: white;

    font-size: 12px;
    -unity-font-style: bold;

    letter-spacing: 3px;
}

.credits-header-divider {
    height: 1px;
    min-height: 1px;

    background-color: rgba(255, 255, 255, 0.12);
}

/* ================================================================
   VIEWPORT
   ================================================================ */

.credits-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* ================================================================
   GENERATED CONTENT
   ================================================================ */

.credits-content {
    width: 760px;
    max-width: 90%;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
}

/* ================================================================
   HERO
   ================================================================ */

.credits-hero {
    align-items: center;

    margin-bottom: 110px;
}

.credits-hero-title {
    margin: 0;

    color: white;

    font-size: 46px;
    -unity-font-style: bold;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

.credits-hero-title--accent {
    color: var(--accent-primary);
}

.credits-hero-kicker {
    margin-top: 18px;
    margin-bottom: 0;

    color: white;

    font-size: 13px;
    -unity-font-style: bold;

    letter-spacing: 3px;

    -unity-text-align: middle-center;
}

.credits-hero-school {
    margin-top: 34px;

    color: white;

    font-size: 17px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

.credits-hero-detail {
    margin-top: 8px;

    color: white;

    font-size: 14px;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

/* ================================================================
   CREDIT SECTIONS
   ================================================================ */

.credits-section {
    width: 100%;

    margin-bottom: 58px;
}

.credits-section-title {
    margin: 0;
    margin-bottom: 18px;
    padding: 0;

    border-width: 0;

    color: white;

    font-size: 18px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

/* ================================================================
   CREDIT ENTRIES
   ================================================================ */

.credits-entry {
    width: 100%;

    margin: 0;
    margin-bottom: 8px;

    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.credits-role {
    width: 50%;

    margin: 0;
    padding: 0;
    padding-right: 14px;

    color: white;

    font-size: 15px;

    -unity-text-align: middle-right;
}

.credits-name {
    width: 50%;

    margin: 0;
    padding: 0;
    padding-left: 14px;

    color: white;

    font-size: 15px;
    -unity-font-style: normal;

    -unity-text-align: middle-left;
}

/* ================================================================
   FEATURED ENTRIES
   ================================================================ */

.credits-entry--featured {
    margin-top: 4px;
    margin-bottom: 38px;

    flex-direction: column;
    align-items: center;
}

.credits-entry--featured .credits-role {
    width: auto;

    margin: 0;
    margin-bottom: 6px;
    padding: 0;

    color: white;

    font-size: 16px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

.credits-entry--featured .credits-name {
    width: auto;

    margin: 0;
    padding: 0;

    color: white;

    font-size: 15px;
    -unity-font-style: normal;

    letter-spacing: 0;

    -unity-text-align: middle-center;
}

/* ================================================================
   JOKE ENTRIES
   ================================================================ */

.credits-entry--joke .credits-role {
    color: white;

    -unity-font-style: italic;
}

.credits-entry--joke .credits-name {
    color: white;
}

/* ================================================================
   SPECIAL THANKS
   ================================================================ */

.credits-special-thanks {
    align-items: center;

    margin-top: 32px;
    margin-bottom: 52px;
}

.credits-special-name {
    margin-top: 16px;

    color: white;

    font-size: 15px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

.credits-special-description {
    margin-top: 6px;
    margin-bottom: 14px;

    color: white;

    font-size: 14px;

    -unity-text-align: middle-center;
}

/* ================================================================
   ENDING
   ================================================================ */

.credits-ending {
    min-height: 360px;

    align-items: center;
    justify-content: center;
}

.credits-ending-title {
    color: white;

    font-size: 24px;
    -unity-font-style: bold;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

.credits-ending-subtitle {
    margin-top: 10px;

    color: white;

    font-size: 13px;
    -unity-font-style: bold;

    letter-spacing: 3px;

    -unity-text-align: middle-center;
}

.credits-ending-meta {
    margin-top: 42px;

    color: white;

    font-size: 11px;

    letter-spacing: 2px;

    -unity-text-align: middle-center;
}

/* ================================================================
   VIEWPORT FADES
   ================================================================ */

.credits-top-fade {
    position: absolute;

    left: 0;
    right: 0;
    top: 89px;

    height: 75px;

    background-color: transparent;
}

.credits-bottom-fade {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 175px;

    background-color: transparent;
}

/* ================================================================
   CONTROLS
   ================================================================ */

.credits-controls {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    height: 64px;

    align-items: center;
    justify-content: center;
}

.credits-controls-inner {
    height: 100%;

    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.credits-control-group {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.credits-control-divider {
    width: 1px;
    height: 20px;

    margin-left: 22px;
    margin-right: 22px;

    background-color: rgba(255, 255, 255, 0.18);
}

/* ================================================================
   KEYCAPS
   ================================================================ */

.credits-key {
    min-width: 38px;
    height: 26px;

    padding-left: 8px;
    padding-right: 8px;

    margin-right: 8px;

    align-items: center;
    justify-content: center;

    background-color: rgba(255, 255, 255, 0.08);

    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);

    border-radius: 3px;
}

.credits-key-label {
    padding: 0;
    margin: 0;

    color: white;

    font-size: 9px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-center;
}

.credits-control-label {
    color: white;

    font-size: 10px;
    -unity-font-style: bold;

    letter-spacing: 1px;

    -unity-text-align: middle-left;
}

/* ================================================================
   FAST FORWARD ACTIVE STATE
   ================================================================ */

.credits-key--active {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
}

.credits-key--active .credits-key-label {
    color: white;
}

/* ================================================================
   FAST FORWARD INDICATOR
   ================================================================ */

.credits-fast-forward-indicator {
    position: absolute;

    right: 40px;
    bottom: 84px;

    height: 36px;

    padding-left: 11px;
    padding-right: 11px;

    flex-direction: row;
    align-items: center;
    justify-content: center;

    background-color: rgba(10, 13, 18, 0.80);

    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);

    border-radius: 3px;

    display: none;
}

.credits-fast-forward-glyph {
    width: 16px;
    height: 16px;

    margin-right: 7px;

    -unity-background-scale-mode: scale-to-fit;
}

.credits-fast-forward-value {
    color: white;

    font-size: 11px;
    -unity-font-style: bold;

    letter-spacing: 1px;
}

.credits-fast-forward-indicator--visible {
    display: flex;
}